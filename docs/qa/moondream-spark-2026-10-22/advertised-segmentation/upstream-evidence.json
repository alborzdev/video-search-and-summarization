  "sources": [
    {
      "url": "https://docs.moondream.ai/running-locally/",
      "finding": "Current local quickstart initializes md.photon(\"moondream3.1-9B-A2B\") then invokes segment(image,\"person\"); base models need no API key and weights download from HF."
    },
    {
      "url": "https://moondream.ai/photon/updates",
      "finding": "August 3, 2026 Photon2.0 capability entry advertises MD3 segmentation on H100, without a distinct segmentation checkpoint ID."
    },
    {
      "url": "https://moondream.ai/photon/support",
      "finding": "Current production table includes Segment for MD2 and MD3 on named hardware, contradicting MD2 public runtime template and separate-weights note."
    },
    {
      "url": "https://moondream.ai/skills/segment",
      "finding": "Current FAQ says downloadable segmentation is not yet available; describes a cloud-only preview."
    },
    {
      "url": "https://moondream.ai/blog/segmenting-update-2026-03-10",
      "finding": "March10 update describes improved Cloud segmentation and promises a local release later that week. It supplies no downloadable filename/revision."
    },
    {
      "url": "https://github.com/m87-labs/kestrel#segment",
      "finding": "Current engine README specifies MD3 and separate segmentation weights; contact Moondream for access. It does not name a versioned segment checkpoint."
    },
    {
      "url": "https://huggingface.co/moondream/moondream3.1-9B-A2B/commit/1da27e6c2d2f9118de14560df456881dc62d91f3",
      "finding": "Maintainer July8 commit explicitly removes segment from public3.1 model skills."
    },
    {
      "url": "https://github.com/m87-labs/kestrel/blob/v0.9.2/kestrel/models/moondream/registration.py",
      "finding": "Default public checkpoint mappings match0.9.1. No gated seg-model auto-selection."
    },
    {
      "url": "https://github.com/m87-labs/kestrel/blob/main/CHANGELOG.md",
      "finding": "Standalone0.9.2 adds RF-DETR/DINOv2 and newer kernels/native; no documented MD3 segmentation checkpoint or stopping change."
    },
    {
      "url": "https://github.com/m87-labs/kestrel/blob/88e1785a0210916ca2d28356900750a7ad200650/README.md#downloading-checkpoint",
      "finding": "Original segmentation-era runtime used manually approved vikhyatk/moondream-next model.pt at d7af1649689208e30e657a8ad52017346e137c39."
    },
    {
      "url": "https://huggingface.co/moondream/md3p-int4",
      "finding": "Card identifies this as an MLX int4 quantization of public Preview, not a separately documented Photon segmentation release."
    },
    {
      "url": "https://huggingface.co/moondream/tracking",
      "finding": "Repository has only a 388MB safetensors payload, no model card/config/API. Bounded45008-byte header inspection shows a400-tensor SSM/ViT architecture; it is not the registered MD3 VLM checkpoint. No claim of a supported segment workflow can be established."
    },
    {
      "url": "https://docs.moondream.ai/skills/segment/",
      "finding": "Cloud endpoint lists public-facing3.1/Preview model IDs. Those logical API IDs do not establish equality with downloadable local checkpoint bytes."
    }
  ],
