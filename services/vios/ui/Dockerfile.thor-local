ARG NODE_BUILD_IMAGE=node:22-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
ARG VST_INGRESS_BASE_IMAGE=nvcr.io/nvidia/vss-core/vss-vios-ingress:3.2.1@sha256:ecee4b30ab5e76fa5d342ba4c7ade5b3f176dbb2543ccad03d07759fea2a5e47
ARG NPM_CONFIG_REGISTRY=https://registry.npmmirror.com/

FROM ${NODE_BUILD_IMAGE} AS ui-build

ARG NPM_CONFIG_REGISTRY
ENV NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY}

WORKDIR /src

# Build the local WebRTC library before npm resolves the UI's file dependency.
COPY streaming-lib/package.json streaming-lib/package-lock.json ./streaming-lib/
RUN cd streaming-lib && npm ci --no-audit --no-fund
COPY streaming-lib ./streaming-lib
RUN cd streaming-lib && npm run build

# The checked-in lockfile is authoritative and now resolves ../streaming-lib.
COPY vios-ui/package.json vios-ui/package-lock.json ./vios-ui/
RUN cd vios-ui && npm ci --no-audit --no-fund
COPY vios-ui ./vios-ui
RUN cd vios-ui && npm run build

FROM ${VST_INGRESS_BASE_IMAGE}

COPY --from=ui-build --chown=nginx:nginx /src/vios-ui/dist/ /vst-ui/

LABEL com.nvidia.vss.thor-local.component="vios-ui" \
      com.nvidia.vss.thor-local.upstream="3.2.1"
