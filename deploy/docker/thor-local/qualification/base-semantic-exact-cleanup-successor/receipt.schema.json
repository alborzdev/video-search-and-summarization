{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "package_id", "mode", "status", "promotion_eligible", "contract_sha256", "manifest_sha256", "target_origin_sha256", "generation_response_sha256", "identity", "budget", "artifacts", "cleanup", "canonical_state_advanced"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "base-semantic-exact-cleanup-successor"},
    "mode": {"const": "bounded-http-candidate"},
    "status": {"const": "exact_report_cleanup_complete_non_promoting"},
    "promotion_eligible": {"const": false},
    "contract_sha256": {"$ref": "#/$defs/sha"},
    "manifest_sha256": {"$ref": "#/$defs/sha"},
    "target_origin_sha256": {"$ref": "#/$defs/sha"},
    "generation_response_sha256": {"$ref": "#/$defs/sha"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "authorization_id", "authorization_token_sha256"],
      "properties": {"run_id": {"type": "string"}, "authorization_id": {"const": "base-semantic-exact-cleanup"}, "authorization_token_sha256": {"$ref": "#/$defs/sha"}}
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["actions", "max_actions", "requests", "max_requests"],
      "properties": {"actions": {"const": 7}, "max_actions": {"const": 7}, "requests": {"const": 7}, "max_requests": {"const": 7}}
    },
    "artifacts": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/mdArtifact"},
        {"$ref": "#/$defs/pdfArtifact"}
      ],
      "items": false
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["semantics", "artifact_count", "artifact_set_sha256", "pair_stem_sha256", "all_paths_from_generation_response", "delete_each_exact_key", "postcondition_each_404", "namespace_delete_attempted", "recursive_delete_claimed", "foreign_resources_mutated", "preexisting_absence_proven"],
      "properties": {
        "semantics": {"const": "exact_object_key"}, "artifact_count": {"const": 2},
        "artifact_set_sha256": {"$ref": "#/$defs/sha"}, "pair_stem_sha256": {"$ref": "#/$defs/sha"},
        "all_paths_from_generation_response": {"const": true}, "delete_each_exact_key": {"const": true},
        "postcondition_each_404": {"const": true}, "namespace_delete_attempted": {"const": false},
        "recursive_delete_claimed": {"const": false}, "foreign_resources_mutated": {"const": false},
        "preexisting_absence_proven": {"const": false}
      }
    },
    "canonical_state_advanced": {"const": false}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["extension", "path_sha256", "stem_sha256", "read_status", "read_bytes", "read_sha256", "delete_status", "post_status"],
      "properties": {
        "extension": {"enum": ["md", "pdf"]}, "path_sha256": {"$ref": "#/$defs/sha"}, "stem_sha256": {"$ref": "#/$defs/sha"},
        "read_status": {"type": "integer", "minimum": 200, "maximum": 299},
        "read_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "read_sha256": {"$ref": "#/$defs/sha"},
        "delete_status": {"enum": [200, 204]}, "post_status": {"const": 404}
      }
    },
    "mdArtifact": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"extension": {"const": "md"}}}]},
    "pdfArtifact": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"extension": {"const": "pdf"}}}]}
  }
}
