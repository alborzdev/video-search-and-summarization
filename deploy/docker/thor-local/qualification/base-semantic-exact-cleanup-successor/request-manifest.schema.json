{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "reported_static_origins", "generation"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "reported_static_origins": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "minLength": 10, "maxLength": 256}
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "path", "body", "headers", "oracle"],
      "properties": {
        "method": {"const": "POST"},
        "path": {"const": "/generate/stream"},
        "body": {"type": "object"},
        "headers": {
          "type": "object", "additionalProperties": false,
          "required": ["Conversation-Id", "User-Message-ID"],
          "properties": {
            "Conversation-Id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
            "User-Message-ID": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
            "X-Timezone": {"type": "string", "pattern": "^[A-Za-z0-9_+./:-]{1,64}$"}
          }
        },
        "oracle": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed_statuses", "response_mode", "required_literals", "forbidden_literals"],
          "properties": {
            "allowed_statuses": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 200, "maximum": 299}},
            "response_mode": {"enum": ["json", "sse"]},
            "required_literals": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
            "forbidden_literals": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
          }
        }
      }
    }
  }
}
