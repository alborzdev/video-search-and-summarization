{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "candidate_only", "inventory_sha256", "denominator", "runtime_evidence", "official_capability_effect", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "candidate_only_vios_ui_and_nat_executor_tranche_wave6"},
    "candidate_only": {"const": true},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advertised_gap_entries", "previously_selected_candidate_entries", "prior_open_entries", "selected_candidate_entries", "entries_left_open"],
      "properties": {
        "advertised_gap_entries": {"const": 87},
        "previously_selected_candidate_entries": {"const": 63},
        "prior_open_entries": {"const": 24},
        "selected_candidate_entries": {"const": 8},
        "entries_left_open": {"const": 16}
      }
    },
    "runtime_evidence": {"type": "array", "maxItems": 0},
    "official_capability_effect": {"const": "none_candidate_only"},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest_pointer", "entry_id", "proposed_capability_id", "advertised", "evidence_scope", "observation", "input_sha256", "semantic_output_sha256", "semantic_output", "runtime_evidence", "official_capability_effect"],
        "properties": {
          "manifest_pointer": {"type": "string", "pattern": "^/features/(?:22/advertised/[0-6]|27/advertised/0)$"},
          "entry_id": {"type": "string", "pattern": "^manifest-gap\\.(?:vios-ui|agent-and-mcp-apis)\\."},
          "proposed_capability_id": {"type": "string", "pattern": "^manifest-entry\\.(?:vios-ui|agent-and-mcp-apis)\\."},
          "advertised": {"type": "string", "minLength": 1},
          "evidence_scope": {"type": "string", "pattern": "^subset:"},
          "observation": {"const": "observed_static_source_contract"},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "semantic_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "semantic_output": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contract_scope", "contract_edges", "semantic_assertions", "matched_source_files", "route_state", "browser_executed", "api_executed", "service_executed", "ui_render_proven", "backend_state_correlated", "request_response_proven", "service_readiness_proven", "real_file_writes", "detail"],
            "properties": {
              "contract_scope": {"const": "exact-digest-locked-ui-and-nat-static-source-contract-only"},
              "contract_edges": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
              "semantic_assertions": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
              "matched_source_files": {"type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "route_state": {"enum": ["mounted_source_route", "placeholder_source_route", "inherited_nat_static_inventory"]},
              "browser_executed": {"const": false},
              "api_executed": {"const": false},
              "service_executed": {"const": false},
              "ui_render_proven": {"const": false},
              "backend_state_correlated": {"const": false},
              "request_response_proven": {"const": false},
              "service_readiness_proven": {"const": false},
              "real_file_writes": {"const": 0},
              "detail": {"type": "object"}
            }
          },
          "runtime_evidence": {"type": "array", "maxItems": 0},
          "official_capability_effect": {"const": "none_candidate_only"}
        }
      }
    }
  }
}
