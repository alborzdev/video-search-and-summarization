{
  "schema_version": 1,
  "package_id": "search-semantic-runtime-evidence-successor",
  "mode": "authorization-gated-bounded-numeric-loopback-http",
  "default_execution_enabled": false,
  "predecessor_package": "search-semantic-runtime-readiness-successor",
  "planning_requirement_id": "search-documents-and-bboxes",
  "capability_id": "runtime.agent.search-profile",
  "oracle_id": "oracle.runtime.agent.search-profile",
  "warehouse_sample_bundle": "excluded",
  "authorization": {
    "authorization_id": "search-semantic-runtime",
    "acknowledgement": "I_ACK_SEARCH_SEMANTIC_RUNTIME_AND_EXACT_OWNED_CLEANUP",
    "ownership_attestation": "I_ATTEST_THIS_EXACT_RUN_NAMESPACE_IS_PREPROVISIONED_FOR_THIS_RUN_AND_MAY_BE_DELETED"
  },
  "transport": {
    "numeric_loopback_only": true,
    "proxies": false,
    "follow_redirects": false,
    "max_request_bytes": 65536,
    "max_response_bytes": 1048576,
    "timeout_seconds": 10
  },
  "execution_bounds": {
    "max_requests": 14,
    "max_actions": 14,
    "max_duration_seconds": 900,
    "owned_document_count": 6,
    "minimum_reappearance_delay_seconds": 2,
    "maximum_reappearance_delay_seconds": 30
  },
  "workflow": [
    {"order": 1, "id": "capture-pre-state", "target": "elasticsearch", "method": "POST", "path": "/_mget"},
    {"order": 2, "id": "search-route", "target": "search", "method": "POST", "path": "/api/v1/search"},
    {"order": 3, "id": "attribute-route", "target": "search", "method": "POST", "path": "/api/v1/search/attribute"},
    {"order": 4, "id": "fusion-route", "target": "search", "method": "POST", "path": "/api/v1/search/fusion"},
    {"order": 5, "id": "image-route", "target": "search", "method": "POST", "path": "/api/v1/search/image"},
    {"order": 6, "id": "same-object-merge", "target": "search", "method": "POST", "path": "/api/v1/search"},
    {"order": 7, "id": "append-multiple-attributes", "target": "search", "method": "POST", "path": "/api/v1/search/attribute"},
    {"order": 8, "id": "rerank-or-fallback", "target": "search", "method": "POST", "path": "/api/v1/search/fusion"},
    {"order": 9, "id": "fuse-multiple-attributes", "target": "search", "method": "POST", "path": "/api/v1/search/attribute"},
    {"order": 10, "id": "same-video-top-k", "target": "search", "method": "POST", "path": "/api/v1/search"},
    {"order": 11, "id": "selected-bbox-knn", "target": "search", "method": "POST", "path": "/api/v1/search/image"},
    {"order": 12, "id": "reject-invalid-index-family", "target": "search", "method": "POST", "path": "/api/v1/search"},
    {"order": 13, "id": "restore-owned-state", "target": "elasticsearch", "method": "POST", "path": "/_bulk"},
    {"order": 14, "id": "verify-postconditions", "target": "elasticsearch", "method": "POST", "path": "/_mget"}
  ],
  "required_exact_routes": [
    "/api/v1/search",
    "/api/v1/search/attribute",
    "/api/v1/search/fusion",
    "/api/v1/search/image"
  ],
  "forbidden_route_aliases": ["/api/v1/attribute_search", "/api/v1/embed_search"],
  "ownership": {
    "namespace_template": "vss-oracle-runtime-agent-search-profile-{run_id}",
    "index_templates": [
      "mdx-embed-filtered-{namespace}",
      "mdx-behavior-{namespace}",
      "mdx-raw-{namespace}"
    ],
    "document_suffixes": ["doc-camera-01-0001", "doc-camera-02-0001"],
    "registration_gate": "operator run-ownership attestation plus exact _mget readback of six index/document/source-digest tuples",
    "ambiguous_or_mismatched_readback_policy": "fail closed without registration or deletion",
    "cleanup": "one exact _bulk delete containing only the six registered tuples; never delete an index",
    "postcondition": "after a bounded delay, exact _mget proves all six absent, the sentinel unchanged, and no late reappearance"
  },
  "evidence": {
    "records_raw_payloads": false,
    "records_raw_urls": false,
    "records_raw_document_ids": false,
    "records_raw_elasticsearch_sources": false,
    "records_response_size_and_sha256": true,
    "promotion_eligible": false,
    "canonical_state_advanced": false,
    "reason": "an operator-attested pre-provisioned fixture is not proof that this executor created the fixture; the sanitized receipt is candidate runtime evidence only"
  },
