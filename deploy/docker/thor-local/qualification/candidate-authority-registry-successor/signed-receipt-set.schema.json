  "additionalProperties": false,
  "properties": {
    "accepted_receipt_count": {"const": 0},
    "accepted_receipt_ids": {"items": {"minLength": 1, "type": "string"}, "maxItems": 0, "type": "array"},
    "admission_index_raw_sha256": {"$ref": "#/$defs/sha256"},
    "authority_registry_raw_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_envelope_count": {"const": 0},
    "authorization_envelopes": {"items": {"type": "object"}, "maxItems": 0, "type": "array"},
