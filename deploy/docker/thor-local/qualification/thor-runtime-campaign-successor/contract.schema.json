{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_id", "mode", "default_execution_enabled",
    "authorization_granted", "promotion_eligible", "canonical_state_advanced",
    "required_cloud_inference", "warehouse_sample_bundle", "repository",
    "official_thor_models", "profiles", "profile_transitions", "phases",
    "receipt_types", "capability_mappings", "forbidden_receipt_package_ids",
    "required_blockers", "source_locks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "thor-runtime-campaign-successor-v1"},
    "mode": {"const": "inert-static-receipt-composition-candidate"},
    "default_execution_enabled": {"const": false},
    "authorization_granted": {"const": false},
    "promotion_eligible": {"const": false},
    "canonical_state_advanced": {"const": false},
    "required_cloud_inference": {"const": false},
    "warehouse_sample_bundle": {"const": "excluded"},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "selected_binding_overlay", "selected_binding_count"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "selected_binding_overlay": {"$ref": "#/$defs/repoPath"},
        "selected_binding_count": {"const": 10}
      }
    },
    "official_thor_models": {
      "type": "object", "additionalProperties": false,
      "required": ["release_commit", "main_commit", "artifact_lock_sha256", "llm_artifact", "llm_served_model", "llm_image_reference", "llm_image_id", "vlm_artifact", "vlm_served_model", "vlm_image_reference", "vlm_image_id", "no_cloud_projection_sha256"],
      "properties": {
        "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "main_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_lock_sha256": {"$ref": "#/$defs/sha"},
        "llm_artifact": {"type": "string", "minLength": 1},
        "llm_served_model": {"type": "string", "minLength": 1},
        "llm_image_reference": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
        "llm_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "vlm_artifact": {"type": "string", "minLength": 1},
        "vlm_served_model": {"type": "string", "minLength": 1},
        "vlm_image_reference": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
        "vlm_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "no_cloud_projection_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "profiles": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/profileContract"}},
    "profile_transitions": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/transition"}},
    "phases": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/phaseContract"}},
    "receipt_types": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/receiptType"}},
    "capability_mappings": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/capabilityMapping"}},
    "forbidden_receipt_package_ids": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/plain"}},
    "required_blockers": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/plain"}},
    "source_locks": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"$ref": "#/$defs/sourceLock"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plain": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"},
    "repoPath": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "not": {"pattern": "(^/|(^|/)\\.\\.?(/|$))"}},
    "modelContract": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "identity", "served_model_id"],
      "properties": {"role": {"$ref": "#/$defs/plain"}, "identity": {"type": "string", "minLength": 1}, "served_model_id": {"type": "string", "minLength": 1}}
    },
    "profileContract": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "required_image_roles", "required_models"],
      "properties": {
        "profile_id": {"enum": ["base", "search", "lvs", "alerts"]},
        "required_image_roles": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/plain"}},
        "required_models": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/modelContract"}}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["order", "from", "to"],
      "properties": {"order": {"type": "integer", "minimum": 1, "maximum": 4}, "from": {"enum": ["none", "base", "search", "lvs"]}, "to": {"enum": ["base", "search", "lvs", "alerts"]}}
    },
    "phaseContract": {
      "type": "object", "additionalProperties": false,
      "required": ["order", "phase_id", "profile_id", "receipt_id", "fixture_ids", "run_namespace_required"],
      "properties": {
        "order": {"type": "integer", "minimum": 1, "maximum": 12},
        "phase_id": {"$ref": "#/$defs/plain"},
        "profile_id": {"enum": ["none", "base", "search", "lvs", "alerts"]},
        "receipt_id": {"$ref": "#/$defs/plain"},
        "fixture_ids": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/plain"}},
        "run_namespace_required": {"type": "boolean"}
      }
    },
    "receiptType": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "package_id", "contract_path", "schema_path", "run_binding"],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/plain"},
        "package_id": {"$ref": "#/$defs/plain"},
        "contract_path": {"$ref": "#/$defs/repoPath"},
        "schema_path": {"$ref": "#/$defs/repoPath"},
        "run_binding": {"enum": ["not-applicable", "manifest-sha256", "raw-run-id", "run-and-manifest-sha256", "run-sha256", "static-disconnected", "unverifiable-in-current-receipt"]}
      }
    },
    "capabilityMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "receipt_ids", "evidence_status"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/plain"},
        "receipt_ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/plain"}},
        "evidence_status": {"enum": ["host-prerequisite-pass-nonqualifying", "candidate-receipt-valid-nonpromoting", "blocked-disconnected-live-static-provenance", "blocked-cross-run-and-media-identity-unverifiable"]}
      }
    },
    "sourceLock": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/repoPath"}, "sha256": {"$ref": "#/$defs/sha"}}
    }
  }
}
