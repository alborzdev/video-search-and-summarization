{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "mode", "target", "policy", "environment", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "thor-synthetic-data-runtime-evidence-successor-v1"},
    "mode": {"const": "target_bound_offline_runtime_evidence"},
    "target": {"type": "object"},
    "policy": {"type": "object"},
    "environment": {"type": "object"},
    "capabilities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["capability_id", "oracle_id", "selected_oracle_sha256", "adapter", "generated_input_sha256", "fixture_manifest", "source_controls", "positive_semantics", "adjacent_negative"]
      }
    }
  }
}
