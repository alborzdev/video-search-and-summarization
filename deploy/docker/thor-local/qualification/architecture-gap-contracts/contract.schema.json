{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vss.local/schemas/thor-architecture-gap-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "mode", "baseline", "policy", "source_locks", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "thor-architecture-gap-contracts-v1"},
    "mode": {"const": "inert_repository_analysis_only"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "runtime_evidence", "can_claim_runtime_qualified"],
      "properties": {
        "target": {"const": "VSS 3.2.1 Thor-local"},
        "runtime_evidence": {"type": "array", "maxItems": 0},
        "can_claim_runtime_qualified": {"const": false}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_allowed", "docker_allowed", "downloads_allowed", "subprocess_allowed", "host_reads_allowed", "service_lifecycle_allowed", "repository_reads_only", "warehouse_sample_allowed", "validation_changes_current_status"],
      "properties": {
        "network_allowed": {"const": false},
        "docker_allowed": {"const": false},
        "downloads_allowed": {"const": false},
        "subprocess_allowed": {"const": false},
        "host_reads_allowed": {"const": false},
        "service_lifecycle_allowed": {"const": false},
        "repository_reads_only": {"const": true},
        "warehouse_sample_allowed": {"const": false},
        "validation_changes_current_status": {"const": false}
      }
    },
    "source_locks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "raw_sha256", "role", "required_fragments"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string", "minLength": 1},
          "required_fragments": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability_ids", "current_state", "blockers", "required_design", "acceptance"],
      "properties": {
        "id": {"enum": ["smartcity-manual-calibration", "smartcity-gis-calibration", "systems-alert-worker-scaling", "systems-vios-scaling"]},
        "capability_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "current_state": {"enum": ["blocked_architecture", "runtime_unqualified"]},
        "blockers": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "required_design": {
          "type": "object",
          "additionalProperties": false,
          "required": ["design_id", "implementation_kind", "required_changes", "forbidden_shortcuts"],
          "properties": {
            "design_id": {"type": "string", "pattern": "^[a-z0-9-]+-v1$"},
            "implementation_kind": {"type": "string", "minLength": 1},
            "required_changes": {"type": "array", "minItems": 5, "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}, "uniqueItems": true},
            "forbidden_shortcuts": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}, "uniqueItems": true}
          }
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_runtime_replicas", "required_evidence_ids", "runtime_required", "static_configuration_is_sufficient"],
          "properties": {
            "minimum_runtime_replicas": {"type": "integer", "minimum": 1},
            "required_evidence_ids": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string", "pattern": "^[a-z]+[.][a-z0-9-]+$"}, "uniqueItems": true},
            "runtime_required": {"const": true},
            "static_configuration_is_sufficient": {"const": false}
          }
        }
      }
    }
  }
}
