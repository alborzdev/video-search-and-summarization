  "rows": [
    {
      "id": "smartcity-manual-calibration",
      "capability_ids": ["calibration.legacy.core"],
      "current_state": "blocked_architecture",
      "blockers": [
        "The released legacy calibration server has an amd64 runnable child and no arm64 child.",
        "The Thor importer consumes prebuilt calibration and road-network files; it does not implement the legacy project UI/server workflow.",
        "AMC is a distinct six-step auto-calibration service and is not a substitute for the legacy manual calibration toolkit."
      ],
      "required_design": {
        "design_id": "native-arm64-legacy-calibration-v1",
        "implementation_kind": "native_thor_legacy_ui_and_server",
        "required_changes": [
          "publish_or_build_a_content_locked_linux_arm64_legacy_calibration_server",
          "wire_the_legacy_calibration_UI_to_the_native_server_on_Thor",
          "support_cartesian_image_gis_and_multi_camera_project_types",
          "support_camera_onboarding_roi_tripwire_validation_and_export",
          "use_generated_or_operator_custom_eight_point_input_without_Warehouse_data"
        ],
        "forbidden_shortcuts": [
          "claim_AMC_is_the_legacy_manual_calibration_toolkit",
          "claim_imported_static_JSON_proves_manual_project_execution",
          "run_the_amd64_child_under_emulation_and_label_it_native_Thor"
        ]
      },
      "acceptance": {
        "minimum_runtime_replicas": 1,
        "required_evidence_ids": [
          "manual.native-arm64-artifact",
          "manual.four-project-types",
          "manual.eight-point-project",
          "manual.roi-tripwire-validation",
          "manual.export-roundtrip",
          "manual.cleanup"
        ],
        "runtime_required": true,
        "static_configuration_is_sufficient": false
      }
    },
    {
      "id": "smartcity-gis-calibration",
      "capability_ids": ["calibration.legacy.gis", "boundary.smart-city.google-maps-dependency"],
      "current_state": "blocked_architecture",
      "blockers": [
        "The official Smart City UI and ROI Refiner consume a Google Maps API key.",
        "The Thor local SVG map is deliberately provider-free and is not the official Google Maps UI.",
        "Checked-in homography, road geometry, and map rendering do not prove an interactive GIS calibration workflow."
      ],
      "required_design": {
        "design_id": "native-provider-free-gis-calibration-v1",
        "implementation_kind": "native_thor_provider_free_functional_alternate",
        "required_changes": [
          "implement_interactive_point_polygon_roi_and_road_link_editing_locally",
          "compute_and_persist_a_3x3_homography",
          "validate_at_least_eight_points_per_polygon",
          "export_and_read_back_calibration_json_and_road_network_json",
          "preserve_explicit_alternate_identity_without_Google_provider_claims"
        ],
        "forbidden_shortcuts": [
          "claim_provider_free_SVG_is_the_official_Google_Maps_UI",
          "claim_rendered_road_geometry_proves_GIS_editing",
          "require_a_Google_key_for_the_all_local_acceptance_lane"
        ]
      },
      "acceptance": {
        "minimum_runtime_replicas": 1,
        "required_evidence_ids": [
          "gis.local-editor-runtime",
          "gis.eight-point-validation",
          "gis.homography-roundtrip",
          "gis.roi-road-link-roundtrip",
          "gis.provider-free-boundary",
          "gis.cleanup"
        ],
        "runtime_required": true,
        "static_configuration_is_sufficient": false
      }
    },
    {
      "id": "systems-alert-worker-scaling",
      "capability_ids": ["performance.alerts.worker-scaling"],
      "current_state": "runtime_unqualified",
      "blockers": [
        "num_workers and chunk_size configure one Alert Bridge process but do not prove horizontal scaling.",
        "The Compose service fixes container_name and uses host networking, so Compose cannot safely create indistinguishable replicas from the current definition.",
        "No Thor measurement proves partition coverage, saturation, backpressure, throughput, or loss and duplication accounting across instances."
      ],
      "required_design": {
        "design_id": "scalable-alert-compose-v1",
        "implementation_kind": "compose_managed_alert_replicas",
        "required_changes": [
          "remove_fixed_container_name_from_the_scaled_service",
          "move_scaled_workers_off_shared_host_networking",
          "use_Compose_generated_unique_replica_identities",
          "share_one_Kafka_consumer_group_with_partitions_at_least_replica_count",
          "preserve_chunk_size_one_and_natural_blocking_backpressure",
          "expose_per_replica_queue_wait_processing_and_throughput_metrics"
        ],
        "forbidden_shortcuts": [
          "claim_num_workers_alone_proves_horizontal_scaling",
          "claim_replicas_from_static_Compose_rendering",
          "reuse_one_fixed_container_name_or_one_shared_host_listener"
        ]
      },
      "acceptance": {
        "minimum_runtime_replicas": 2,
        "required_evidence_ids": [
          "alerts.resolved-replica-topology",
          "alerts.partition-assignment",
          "alerts.generated-load",
          "alerts.queue-backpressure-metrics",
          "alerts.loss-duplication-accounting",
          "alerts.cleanup"
        ],
        "runtime_required": true,
        "static_configuration_is_sufficient": false
      }
    },
    {
      "id": "systems-vios-scaling",
      "capability_ids": ["deployment.vios.horizontal-scaling"],
      "current_state": "runtime_unqualified",
      "blockers": [
        "Every current stream-processing profile fixes the same container name and host HTTP port 30001.",
        "Host networking and shared writable storage paths do not provide replica identity, routing, or ownership isolation.",
        "The advertised topology requires horizontal stream-processing replicas while Sensor remains a singleton; neither behavior is runtime-qualified on Thor."
      ],
      "required_design": {
        "design_id": "scalable-vios-compose-v1",
        "implementation_kind": "compose_managed_streamprocessor_replicas_sensor_singleton",
        "required_changes": [
          "remove_fixed_container_name_from_streamprocessing",
          "move_streamprocessing_replicas_off_the_shared_host_port",
          "give_each_streamprocessor_a_unique_identity_and_storage_ownership_boundary",
          "route_sensor_and_ingress_requests_across_healthy_streamprocessor_replicas",
          "keep_exactly_one_sensor_service_instance",
          "prove_stream_assignment_playback_and_failure_recovery_per_replica"
        ],
        "forbidden_shortcuts": [
          "claim_deploy_replicas_from_static_Compose_rendering",
          "scale_the_sensor_service_above_one",
          "reuse_container_name_vss_vios_streamprocessing_or_host_port_30001_across_replicas"
        ]
      },
      "acceptance": {
        "minimum_runtime_replicas": 2,
        "required_evidence_ids": [
          "vios.resolved-replica-topology",
          "vios.sensor-singleton",
          "vios.unique-identity-storage",
          "vios.stream-routing-playback",
          "vios.replica-failure-recovery",
          "vios.cleanup"
        ],
        "runtime_required": true,
        "static_configuration_is_sufficient": false
      }
    }
