{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thor realtime alert rule replay runtime receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "capability_id", "contract_sha256", "status", "run", "replay", "cleanup"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "realtime-alert-rule-replay-runtime-successor"},
    "capability_id": {"const": "manifest-entry.realtime-alerts.02-rule-replay"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "passed"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "fixture_bytes", "fixture_sha256", "numeric_loopback_http_only", "agent_generate_request_count"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 1, "maximum": 240000},
        "fixture_bytes": {"const": 2575454},
        "fixture_sha256": {"const": "f2c16bf02e1d43fa52faf902ff981185c62df092189b41c735c5c27647b44205"},
        "numeric_loopback_http_only": {"const": true},
        "agent_generate_request_count": {"const": 0}
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persisted_rule_created_active", "replay_count", "replay_success_count",
        "immutable_identity_preserved", "immutable_config_preserved", "created_at_preserved",
        "replay_timestamp_advanced", "one_public_rule_after_each_replay",
        "one_persisted_rule_after_each_replay", "one_rtvlm_stream_after_each_replay",
        "one_caption_worker_after_each_replay", "worker_created_counts", "worker_removed_counts",
        "rule_identity_sha256", "stream_identity_sha256", "immutable_config_sha256",
        "replay_timestamp_sha256", "mutation_sequence"
      ],
      "properties": {
        "persisted_rule_created_active": {"const": true},
        "replay_count": {"const": 2},
        "replay_success_count": {"const": 2},
        "immutable_identity_preserved": {"const": true},
        "immutable_config_preserved": {"const": true},
        "created_at_preserved": {"const": true},
        "replay_timestamp_advanced": {"const": true},
        "one_public_rule_after_each_replay": {"const": true},
        "one_persisted_rule_after_each_replay": {"const": true},
        "one_rtvlm_stream_after_each_replay": {"const": true},
        "one_caption_worker_after_each_replay": {"const": true},
        "worker_created_counts": {"const": [2, 3]},
        "worker_removed_counts": {"const": [1, 2]},
        "rule_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stream_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "immutable_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "replay_timestamp_sha256": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "mutation_sequence": {
          "const": [
            "POST /api/v1/realtime",
            "POST /api/v1/realtime/replay",
            "POST /api/v1/realtime/replay",
            "DELETE /api/v1/realtime/<owned>",
            "DELETE /api/v1/realtime/<owned>"
          ]
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_unrelated_state_restored", "before_sha256", "after_sha256", "rule_deleted",
        "repeated_delete_explicit_not_found", "publisher_stopped",
        "owned_incident_documents_deleted", "owned_incident_artifacts_absent",
        "final_caption_worker_count"
      ],
      "properties": {
        "exact_unrelated_state_restored": {"const": true},
        "before_sha256": {"$ref": "#/$defs/stateDigests"},
        "after_sha256": {"$ref": "#/$defs/stateDigests"},
        "rule_deleted": {"const": true},
        "repeated_delete_explicit_not_found": {"const": true},
        "publisher_stopped": {"const": true},
        "owned_incident_documents_deleted": {"type": "integer", "minimum": 0},
        "owned_incident_artifacts_absent": {"const": true},
        "final_caption_worker_count": {"const": 0}
      }
    }
  },
  "$defs": {
    "stateDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "persisted_rules", "rtvlm_streams"],
      "properties": {
        "rules": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "persisted_rules": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rtvlm_streams": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
