{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "ui_origin", "cdp_origin", "vst_origin",
    "agent_origin", "node_executable", "node_sha256", "playwright_module",
    "playwright_sha256", "fixtures", "owned_sensor_ids", "template_field_name"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "ui_origin": {"type": "string", "minLength": 1, "maxLength": 128},
    "cdp_origin": {"type": "string", "minLength": 1, "maxLength": 128},
    "vst_origin": {"type": "string", "minLength": 1, "maxLength": 128},
    "agent_origin": {"type": "string", "minLength": 1, "maxLength": 128},
    "node_executable": {"type": "string", "minLength": 1, "maxLength": 8196},
    "node_sha256": {"$ref": "#/$defs/sha256"},
    "playwright_module": {"type": "string", "minLength": 1, "maxLength": 8196},
    "playwright_sha256": {"$ref": "#/$defs/sha256"},
    "fixtures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "extension"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 8196},
          "sha256": {"$ref": "#/$defs/sha256"},
          "extension": {"enum": [".mp4", ".mkv"]}
        }
      }
    },
    "owned_sensor_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
    },
    "template_field_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
