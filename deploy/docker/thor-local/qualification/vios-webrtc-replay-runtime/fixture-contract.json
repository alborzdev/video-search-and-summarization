    "mutation": "ephemeral_session_only",
    "executor": "native UI stream/stop",
    "postconditions": [
      "the executor-owned replay peer is rejected as absent",
      "aggregate replay status is null",
      "the replay WebSocket is closed",
      "the video element is removed",
      "fixture sensor, streams, timeline, Docker inventory, and running set equal pre-state"
    ]
  },
