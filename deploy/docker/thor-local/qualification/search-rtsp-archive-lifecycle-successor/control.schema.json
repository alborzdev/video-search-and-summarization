{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sensor_id", "name", "documents"],
  "properties": {
    "schema_version": {"const": 1},
    "sensor_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "documents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "index", "document_id", "source_sha256"],
        "properties": {
          "family": {"enum": ["embed", "behavior", "raw"]},
          "index": {"enum": ["mdx-embed-filtered-2025-01-01", "mdx-behavior-2025-01-01", "mdx-raw-2025-01-01"]},
          "document_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "source_sha256": {"$ref": "#/$defs/sha"}
        }
      }
    }
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
