{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "status",
    "promotion_eligible",
    "captured_at",
    "target_commit",
    "contract_sha256",
    "executor_sha256",
    "harness_sha256",
    "receipt_schema_sha256",
    "identity",
    "pre_state",
    "bounds",
    "ui_semantics",
    "post_state",
    "cleanup"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "thor-ui-search-contract-current-runtime-successor-v1" },
    "status": { "const": "passed_current_candidate" },
    "promotion_eligible": { "const": true },
    "captured_at": { "type": "string", "format": "date-time" },
    "target_commit": { "$ref": "#/$defs/commit" },
    "contract_sha256": { "$ref": "#/$defs/sha256" },
    "executor_sha256": { "$ref": "#/$defs/sha256" },
    "harness_sha256": { "$ref": "#/$defs/sha256" },
    "receipt_schema_sha256": { "$ref": "#/$defs/sha256" },
    "identity": { "$ref": "#/$defs/identity" },
    "pre_state": { "$ref": "#/$defs/state" },
    "bounds": { "$ref": "#/$defs/bounds" },
    "ui_semantics": { "$ref": "#/$defs/uiSemantics" },
    "post_state": { "$ref": "#/$defs/state" },
    "cleanup": { "$ref": "#/$defs/cleanup" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "shaArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "runtimeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured_image",
        "image_id",
        "running",
        "restart_count",
        "oom_killed",
        "started_at_sha256"
      ],
      "properties": {
        "configured_image": { "type": "string", "minLength": 1 },
        "image_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "running": { "const": true },
        "restart_count": { "const": 0 },
        "oom_killed": { "const": false },
        "started_at_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vss-agent-ui", "vss-haproxy-ingress", "vss-agent"],
      "properties": {
        "vss-agent-ui": { "$ref": "#/$defs/runtimeRow" },
        "vss-haproxy-ingress": { "$ref": "#/$defs/runtimeRow" },
        "vss-agent": { "$ref": "#/$defs/runtimeRow" }
      }
    },
    "criticState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_default_enabled",
        "compose_default_enabled",
        "profile_default_enabled",
        "request_default_enabled",
        "disable_env_supported"
      ],
      "properties": {
        "runtime_default_enabled": { "const": true },
        "compose_default_enabled": { "const": true },
        "profile_default_enabled": { "const": true },
        "request_default_enabled": { "const": true },
        "disable_env_supported": { "const": true }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "critic"],
      "properties": {
        "runtime": { "$ref": "#/$defs/runtime" },
        "critic": { "$ref": "#/$defs/criticState" }
      }
    },
    "browserIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_sha256",
        "playwright_entry_sha256",
        "browser_executable_sha256",
        "browser_version_sha256",
        "ui_origin_sha256"
      ],
      "properties": {
        "node_sha256": { "$ref": "#/$defs/sha256" },
        "playwright_entry_sha256": { "$ref": "#/$defs/sha256" },
        "browser_executable_sha256": { "$ref": "#/$defs/sha256" },
        "browser_version_sha256": { "$ref": "#/$defs/sha256" },
        "ui_origin_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "browserProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout_sha256", "stdout_bytes", "stderr_sha256", "stderr_bytes", "exit_code"],
      "properties": {
        "stdout_sha256": { "$ref": "#/$defs/sha256" },
        "stdout_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "stderr_sha256": { "$ref": "#/$defs/sha256" },
        "stderr_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "exit_code": { "const": 0 }
      }
    },
    "selectedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_sha256",
        "official_runtime_evidence_sha256",
        "verifier_sha256",
        "verifier_output_sha256",
        "passed"
      ],
      "properties": {
        "contract_sha256": { "$ref": "#/$defs/sha256" },
        "official_runtime_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "verifier_sha256": { "$ref": "#/$defs/sha256" },
        "verifier_output_sha256": { "$ref": "#/$defs/sha256" },
        "passed": { "const": true }
      }
    },
    "criticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_sha256",
        "runtime_receipt_sha256",
        "verifier_sha256",
        "verifier_output_sha256",
        "confirmed_card_count",
        "passed"
      ],
      "properties": {
        "contract_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "verifier_sha256": { "$ref": "#/$defs/sha256" },
        "verifier_output_sha256": { "$ref": "#/$defs/sha256" },
        "confirmed_card_count": { "type": "integer", "minimum": 1 },
        "passed": { "const": true }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_token_sha256",
        "source_hashes",
        "selected_object_evidence",
        "critic_runtime_evidence",
        "browser",
        "browser_process"
      ],
      "properties": {
        "authorization_token_sha256": { "$ref": "#/$defs/sha256" },
        "source_hashes": {
          "type": "object",
          "minProperties": 20,
          "maxProperties": 20,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "selected_object_evidence": { "$ref": "#/$defs/selectedEvidence" },
        "critic_runtime_evidence": { "$ref": "#/$defs/criticEvidence" },
        "browser": { "$ref": "#/$defs/browserIdentity" },
        "browser_process": { "$ref": "#/$defs/browserProcess" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "browser_duration_ms",
        "browser_actions",
        "loopback_browser_responses",
        "persistent_mutations",
        "max_duration_ms",
        "max_browser_duration_ms",
        "max_browser_actions",
        "max_loopback_browser_responses",
        "max_persistent_mutations"
      ],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 180000 },
        "browser_duration_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "browser_actions": { "type": "integer", "minimum": 10, "maximum": 18 },
        "loopback_browser_responses": { "type": "integer", "minimum": 1, "maximum": 250 },
        "persistent_mutations": { "const": 0 },
        "max_duration_ms": { "const": 180000 },
        "max_browser_duration_ms": { "const": 120000 },
        "max_browser_actions": { "const": 18 },
        "max_loopback_browser_responses": { "const": 250 },
        "max_persistent_mutations": { "const": 0 }
      }
    },
    "overflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport", "document", "body"],
      "properties": {
        "viewport": { "type": "integer", "minimum": 1 },
        "document": { "type": "integer", "minimum": 1 },
        "body": { "type": "integer", "minimum": 1 }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    },
    "uiSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "page_identity",
        "source_contract",
        "filter_contract",
        "request_contract",
        "critic_contract",
        "time_contract",
        "desktop",
        "mobile",
        "diagnostics"
      ],
      "properties": {
        "actions": { "type": "integer", "minimum": 10, "maximum": 18 },
        "page_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial_content_sha256", "initial_content_bytes", "search_component_visible"],
          "properties": {
            "initial_content_sha256": { "$ref": "#/$defs/sha256" },
            "initial_content_bytes": { "type": "integer", "minimum": 8, "maximum": 1048576 },
            "search_component_visible": { "const": true }
          }
        },
        "source_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default_video_file", "values", "rtsp_and_video_file_round_trip"],
          "properties": {
            "default_video_file": { "const": true },
            "values": {
              "type": "array",
              "prefixItems": [{ "const": "Video File" }, { "const": "RTSP" }],
              "minItems": 2,
              "maxItems": 2
            },
            "rtsp_and_video_file_round_trip": { "const": true }
          }
        },
        "filter_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaults", "top_k_minimum", "top_k_minimum_selected"],
          "properties": {
            "defaults": {
              "type": "object",
              "additionalProperties": false,
              "required": ["top_k", "similarity"],
              "properties": {
                "top_k": { "const": 10 },
                "similarity": { "const": -1 }
              }
            },
            "top_k_minimum": { "const": 1 },
            "top_k_minimum_selected": { "const": true }
          }
        },
        "request_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query_sha256",
            "query_bytes",
            "body_sha256",
            "top_k",
            "source_type_video_file",
            "agent_mode_false",
            "empty_video_sources",
            "null_time_range"
          ],
          "properties": {
            "query_sha256": { "$ref": "#/$defs/sha256" },
            "query_bytes": { "const": 22 },
            "body_sha256": { "$ref": "#/$defs/sha256" },
            "top_k": { "const": 1 },
            "source_type_video_file": { "const": true },
            "agent_mode_false": { "const": true },
            "empty_video_sources": { "const": true },
            "null_time_range": { "const": true }
          }
        },
        "critic_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixture_response_sha256",
            "fixture_response_status",
            "fixture_response_intercepted_once",
            "input_order",
            "rendered_order",
            "rendered_card_count",
            "similarities"
          ],
          "properties": {
            "fixture_response_sha256": { "$ref": "#/$defs/sha256" },
            "fixture_response_status": { "const": 200 },
            "fixture_response_intercepted_once": { "const": true },
            "input_order": {
              "type": "array",
              "prefixItems": [{ "const": "rejected" }, { "const": "confirmed" }, { "const": "unverified" }],
              "minItems": 3,
              "maxItems": 3
            },
            "rendered_order": {
              "type": "array",
              "prefixItems": [{ "const": "confirmed" }, { "const": "unverified" }, { "const": "rejected" }],
              "minItems": 3,
              "maxItems": 3
            },
            "rendered_card_count": { "const": 3 },
            "similarities": {
              "type": "array",
              "prefixItems": [{ "const": -1 }, { "const": 0.25 }, { "const": 1 }],
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "time_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "browser_time_zone_sha256",
            "literal_local_time_sha256",
            "local_time_without_offset_conversion"
          ],
          "properties": {
            "browser_time_zone_sha256": { "$ref": "#/$defs/sha256" },
            "literal_local_time_sha256": { "$ref": "#/$defs/sha256" },
            "local_time_without_offset_conversion": { "const": true }
          }
        },
        "desktop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overflow", "screenshot"],
          "properties": {
            "overflow": { "$ref": "#/$defs/overflow" },
            "screenshot": { "$ref": "#/$defs/screenshot" }
          }
        },
        "mobile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overflow"],
          "properties": {
            "overflow": { "$ref": "#/$defs/overflow" }
          }
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "console_error_hashes",
            "console_warning_hashes",
            "page_error_hashes",
            "request_failure_hashes",
            "expected_audio_probe_abort_count",
            "response_status_counts",
            "failing_response_hashes",
            "non_loopback_request_count",
            "non_loopback_response_count",
            "non_loopback_websocket_count",
            "framework_error_overlay_count"
          ],
          "properties": {
            "console_error_hashes": { "$ref": "#/$defs/shaArray" },
            "console_warning_hashes": { "$ref": "#/$defs/shaArray" },
            "page_error_hashes": { "$ref": "#/$defs/shaArray" },
            "request_failure_hashes": { "$ref": "#/$defs/shaArray" },
            "expected_audio_probe_abort_count": { "const": 1 },
            "response_status_counts": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 8,
              "propertyNames": { "pattern": "^[1-5][0-9]{2}$" },
              "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 250 }
            },
            "failing_response_hashes": { "$ref": "#/$defs/shaArray" },
            "non_loopback_request_count": { "const": 0 },
            "non_loopback_response_count": { "const": 0 },
            "non_loopback_websocket_count": { "const": 0 },
            "framework_error_overlay_count": { "const": 0 }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "isolated_browser_closed",
        "temporary_screenshot_deleted_after_hashing",
        "runtime_unchanged",
        "selected_object_evidence_reverified",
        "critic_runtime_evidence_reverified",
        "persistent_mutations",
        "warehouse_sample_bundle"
      ],
      "properties": {
        "mutation": { "const": "read_only" },
        "isolated_browser_closed": { "const": true },
        "temporary_screenshot_deleted_after_hashing": { "const": true },
        "runtime_unchanged": { "const": true },
        "selected_object_evidence_reverified": { "const": true },
        "critic_runtime_evidence_reverified": { "const": true },
        "persistent_mutations": { "const": 0 },
        "warehouse_sample_bundle": { "const": "excluded" }
      }
    }
  }
}
