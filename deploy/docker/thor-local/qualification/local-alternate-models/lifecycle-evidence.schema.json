{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.example/vss/thor-local-qwen-lifecycle-evidence.schema.json",
  "title": "Thor-local Qwen alternate lifecycle evidence",
  "oneOf": [
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/execution"},
    {"$ref": "#/$defs/gateFailure"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schema_version", "lane", "status"],
      "properties": {
        "schema_version": {"const": 1},
        "lane": {"const": "non-official-local-alternate"},
        "status": {"enum": ["planned", "passed", "failed"]}
      }
    },
    "plan": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "lane", "status", "writes_or_lifecycle_actions",
            "acknowledgement", "memory_admission_kib", "readiness", "lifecycle",
            "qualifier"
          ],
          "properties": {
            "schema_version": {"const": 1},
            "lane": {"const": "non-official-local-alternate"},
            "status": {"const": "planned"},
            "writes_or_lifecycle_actions": {"const": false},
            "acknowledgement": {"const": "I_AUTHORIZE_TEMPORARY_QWEN_VLM_LIFECYCLE_WITH_FAILURE_SAFE_RESTORATION"},
            "memory_admission_kib": {"const": 52428800},
            "readiness": {
              "type": "object",
              "additionalProperties": false,
              "required": ["endpoint", "model", "maximum_requests", "deadline_seconds", "request_timeout_seconds", "proxies_allowed"],
              "properties": {
                "endpoint": {"const": "http://172.17.0.1:8003"},
                "model": {"const": "datasheet-vision"},
                "maximum_requests": {"const": 90},
                "deadline_seconds": {"const": 900},
                "request_timeout_seconds": {"const": 10},
                "proxies_allowed": {"const": false}
              }
            },
            "lifecycle": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}},
            "qualifier": {
              "allOf": [
                {"$ref": "#/$defs/qualifierEvidence"},
                {"properties": {"status": {"const": "planned"}}}
              ]
            }
          }
        }
      ]
    },
    "execution": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "lane", "status", "official_capability_promotion_allowed",
            "failure", "cleanup_failures", "memory_admission_kib", "embedding_was_stopped",
            "readiness_requests", "readiness_request_limit", "readiness_deadline_seconds",
            "qualification", "lifecycle"
          ],
          "properties": {
            "schema_version": {"const": 1},
            "lane": {"const": "non-official-local-alternate"},
            "status": {"enum": ["passed", "failed"]},
            "official_capability_promotion_allowed": {"const": false},
            "failure": {"type": ["string", "null"]},
            "cleanup_failures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "memory_admission_kib": {"const": 52428800},
            "embedding_was_stopped": {"type": "boolean"},
            "readiness_requests": {"type": "integer", "minimum": 0, "maximum": 90},
            "readiness_request_limit": {"type": "integer", "minimum": 1, "maximum": 90},
            "readiness_deadline_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 900},
            "qualification": {
              "anyOf": [
                {"type": "null"},
                {"$ref": "#/$defs/qualifierEvidence"}
              ]
            },
            "lifecycle": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stop_attempted", "stopped_by_runner", "qwen_start_attempted", "qwen_stopped_before_restore", "llm_was_lifecycle_targeted"],
              "properties": {
                "stop_attempted": {"$ref": "#/$defs/workloads"},
                "stopped_by_runner": {"$ref": "#/$defs/workloads"},
                "qwen_start_attempted": {"type": "boolean"},
                "qwen_stopped_before_restore": {"type": "boolean"},
                "llm_was_lifecycle_targeted": {"const": false}
              }
            }
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "passed"}}},
              "then": {
                "properties": {
                  "failure": {"const": null},
                  "cleanup_failures": {"maxItems": 0},
                  "readiness_requests": {"minimum": 1},
                  "qualification": {
                    "allOf": [
                      {"$ref": "#/$defs/qualifierEvidence"},
                      {"properties": {"status": {"const": "passed"}}}
                    ]
                  },
                  "lifecycle": {
                    "properties": {
                      "qwen_start_attempted": {"const": true},
                      "qwen_stopped_before_restore": {"const": true}
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {"embedding_was_stopped": {"const": false}}
                    },
                    "then": {
                      "properties": {
                        "lifecycle": {
                          "properties": {
                            "stop_attempted": {"const": ["ctai-vision-playground-api"]},
                            "stopped_by_runner": {"const": ["ctai-vision-playground-api"]}
                          }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {"embedding_was_stopped": {"const": true}}
                    },
                    "then": {
                      "properties": {
                        "lifecycle": {
                          "properties": {
                            "stop_attempted": {"const": ["ctai-vision-playground-api", "datasheet-embedding"]},
                            "stopped_by_runner": {"const": ["ctai-vision-playground-api", "datasheet-embedding"]}
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "gateFailure": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "lane", "status", "failure"],
          "properties": {
            "schema_version": {"const": 1},
            "lane": {"const": "non-official-local-alternate"},
            "status": {"const": "failed"},
            "failure": {"type": "string"}
          }
        }
      ]
    },
    "qualifierEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "contract_id", "classification", "status",
        "binding", "policy", "requests_attempted", "checks"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_id": {"const": "vss-3.2.1-thor-local-qwen-alternate-runtime"},
        "classification": {"const": "non-official-local-alternate"},
        "status": {"enum": ["planned", "passed", "failed"]},
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_commit", "reviewed_main_commit", "reviewed_local_base_commit",
            "current_commit", "artifact_lock_sha256", "contract_sha256", "vllm_image"
          ],
          "properties": {
            "release_commit": {"const": "7640d917047cf7b0fd3085eefb8282754b56bc94"},
            "reviewed_main_commit": {"const": "7732edf8fb38ef896b20f2a0a6a701a4db10dc57"},
            "reviewed_local_base_commit": {"const": "ee82896c01e66e03502d24bdafe6b46e20679785"},
            "current_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "artifact_lock_sha256": {"const": "5b0030ba13fb1ccee5950e3c4b78d334d8dd0c30a2a45ce90e6166a57fe31d09"},
            "contract_sha256": {"const": "7eb3f4f32bde6de9adced6ff51e9b0ed7163f26c44e5f89e97a94157cb11e72e"},
            "vllm_image": {"const": "ghcr.io/nvidia-ai-iot/vllm@sha256:6402d5ac90223b9ba4434228f98aec798c5a8b942e770ee47528b4148e923105"}
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "official_capability_promotion_allowed", "writes_or_lifecycle_actions",
            "network_scope", "raw_model_output_recorded"
          ],
          "properties": {
            "official_capability_promotion_allowed": {"const": false},
            "writes_or_lifecycle_actions": {"const": false},
            "network_scope": {"const": "exact-no-proxy-local-http-endpoints-only"},
            "raw_model_output_recorded": {"const": false}
          }
        },
        "requests_attempted": {"type": "integer", "minimum": 0, "maximum": 4},
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": {"enum": ["preflight", "llm-model-identity", "vlm-model-identity", "llm-ping-tool-call", "vlm-four-image-color-order"]},
              "status": {"enum": ["planned", "passed", "failed", "not-run"]},
              "diagnostic": {"type": "string", "maxLength": 160}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "planned"}}, "required": ["status"]},
          "then": {
            "properties": {
              "requests_attempted": {"const": 0},
              "checks": {
                "const": [
                  {"id": "llm-model-identity", "status": "planned"},
                  {"id": "vlm-model-identity", "status": "planned"},
                  {"id": "llm-ping-tool-call", "status": "planned"},
                  {"id": "vlm-four-image-color-order", "status": "planned"}
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "requests_attempted": {"const": 4},
              "checks": {
                "const": [
                  {"id": "llm-model-identity", "status": "passed"},
                  {"id": "vlm-model-identity", "status": "passed"},
                  {"id": "llm-ping-tool-call", "status": "passed"},
                  {"id": "vlm-four-image-color-order", "status": "passed"}
                ]
              }
            }
          }
        }
      ]
    },
    "workloads": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["ctai-vision-playground-api", "datasheet-embedding"]}
    }
  }
}
