{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.local/vss/thor/base-semantic-runtime-evidence-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "mode", "default_execution_enabled", "warehouse_sample_bundle", "authorization", "transport", "cases", "ownership", "evidence", "source_locks"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "base-semantic-runtime-evidence"},
    "mode": {"const": "authorization-gated-local-runtime"},
    "default_execution_enabled": {"const": false},
    "warehouse_sample_bundle": {"const": "excluded"},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_id", "acknowledgement"],
      "properties": {
        "authorization_id": {"const": "base-semantic-runtime"},
        "acknowledgement": {"const": "I_ACK_BASE_SEMANTIC_LOCAL_RUNTIME"}
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["numeric_loopback_only", "explicit_port_required", "proxies", "follow_redirects", "max_request_bytes", "max_response_bytes", "timeout_seconds"],
      "properties": {
        "numeric_loopback_only": {"const": true}, "explicit_port_required": {"const": true},
        "proxies": {"const": false}, "follow_redirects": {"const": false},
        "max_request_bytes": {"const": 65536}, "max_response_bytes": {"const": 1048576},
        "timeout_seconds": {"const": 10}
      }
    },
    "cases": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/case"}},
    "ownership": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_id_template", "preexisting_collision_allowed", "registration_gate", "delete_only_exact_owned_resources", "ambiguous_create_policy", "cleanup_order", "absence_postcondition_required", "foreign_resource_policy"],
      "properties": {
        "resource_id_template": {"const": "{run_id}.{suffix}"},
        "preexisting_collision_allowed": {"const": false},
        "registration_gate": {"const": "successful create plus exact readback proving the run-bound resource identity"},
        "delete_only_exact_owned_resources": {"const": true},
        "ambiguous_create_policy": {"const": "fail closed without registration or deletion"},
        "cleanup_order": {"const": "lifo"},
        "absence_postcondition_required": {"const": true},
        "foreign_resource_policy": {"const": "never mutate"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_payloads", "raw_headers", "raw_urls", "promotion_eligible", "canonical_state_advanced"],
      "properties": {"raw_payloads": {"const": false}, "raw_headers": {"const": false}, "raw_urls": {"const": false}, "promotion_eligible": {"const": false}, "canonical_state_advanced": {"const": false}}
    },
    "source_locks": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/lock"}}
  },
  "$defs": {
    "step": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "methods": {"type": "array"}, "paths": {"type": "array"}}, "additionalProperties": false},
    "case": {"type": "object", "additionalProperties": false, "required": ["planning_requirement_id", "capability_id", "oracle_id", "adapter", "max_requests", "max_actions", "workflow"], "properties": {"planning_requirement_id": {"type": "string"}, "capability_id": {"type": "string"}, "oracle_id": {"type": "string"}, "adapter": {"enum": ["bounded-http", "manual-browser-receipt"]}, "max_requests": {"type": "integer", "minimum": 1, "maximum": 64}, "max_actions": {"type": "integer", "minimum": 1, "maximum": 64}, "workflow": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/step"}}}},
    "lock": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
