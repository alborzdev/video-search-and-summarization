      "properties": {
        "failures": {"const": []},
        "stop_caption_http_status": {"const": 200},
        "delete_stream_http_status": {"const": 200},
        "stream_catalog_before_count": {"type": "integer", "minimum": 0},
        "stream_catalog_after_count": {"type": "integer", "minimum": 0},
        "stream_catalog_restored_exactly": {"const": true},
        "asset_statistics_restored_exactly": {"const": true},
        "model_inventory_restored_exactly": {"const": true},
        "health_contract_restored_exactly": {"const": true},
        "publisher_stopped": {"const": true},
        "support_container_absent": {"const": true},
        "temporary_fixture_root_absent": {"const": true},
        "owned_stream_absent": {"const": true}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_generate_calls",
        "main_vios_stream_mutations",
        "rt_cv_stream_mutations",
        "core_service_lifecycle_actions",
        "raw_prompt_retained",
        "raw_semantic_output_retained",
        "raw_resource_ids_retained",
        "raw_rtsp_url_retained",
        "credentials_retained",
        "warehouse_sample_bundle"
      ],
      "properties": {
        "agent_generate_calls": {"const": 0},
        "main_vios_stream_mutations": {"const": 0},
        "rt_cv_stream_mutations": {"const": 0},
        "core_service_lifecycle_actions": {"const": 0},
        "raw_prompt_retained": {"const": false},
        "raw_semantic_output_retained": {"const": false},
        "raw_resource_ids_retained": {"const": false},
        "raw_rtsp_url_retained": {"const": false},
        "credentials_retained": {"const": false},
        "warehouse_sample_bundle": {"const": "excluded"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
