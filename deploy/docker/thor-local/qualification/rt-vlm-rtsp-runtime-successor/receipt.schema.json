        "request_sha256": {"$ref": "#/$defs/hash"},
        "response_sha256": {"$ref": "#/$defs/hash"},
        "stream_mutated": {"const": false}
      }
    },
    "stream_add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_status",
        "single_result",
        "errors_empty",
        "owned_identity_exact",
        "catalog_count_delta",
        "metadata_round_trip_exact",
        "request_sha256",
        "response_sha256"
