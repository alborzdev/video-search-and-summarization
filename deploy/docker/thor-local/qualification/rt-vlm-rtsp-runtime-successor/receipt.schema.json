        "http_status": {"const": 200},
        "single_result": {"const": true},
        "errors_empty": {"const": true},
        "owned_identity_exact": {"const": true},
        "catalog_count_delta": {"const": 1},
        "metadata_round_trip_exact": {"const": true},
        "request_sha256": {"$ref": "#/$defs/hash"},
        "response_sha256": {"$ref": "#/$defs/hash"}
      }
