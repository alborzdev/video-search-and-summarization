    "live_caption_sse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_status",
        "content_type_exact",
        "data_event_count",
        "json_event_count",
        "ping_comment_count",
        "model_exact",
        "primary_markers_present",
        "markers_in_chronological_order",
        "semantic_output_sha256",
        "request_sha256"
      ],
      "properties": {
        "http_status": {"const": 200},
        "content_type_exact": {"const": true},
        "data_event_count": {"type": "integer", "minimum": 1},
        "json_event_count": {"type": "integer", "minimum": 1},
        "ping_comment_count": {"type": "integer", "minimum": 1},
        "model_exact": {"const": true},
        "primary_markers_present": {"const": true},
        "markers_in_chronological_order": {"const": true},
        "semantic_output_sha256": {"$ref": "#/$defs/hash"},
        "request_sha256": {"$ref": "#/$defs/hash"}
