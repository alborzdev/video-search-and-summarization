    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_name_exact",
        "image_id_exact",
        "healthy",
        "restart_count",
        "oom_killed",
        "live_source_count",
        "live_sources_match_locks",
        "endpoint_loopback_exact",
        "model_exact",
        "release_exact",
        "audio_support"
      ],
      "properties": {
        "container_name_exact": {"const": true},
        "image_id_exact": {"const": true},
        "healthy": {"const": true},
        "restart_count": {"const": 0},
        "oom_killed": {"const": false},
