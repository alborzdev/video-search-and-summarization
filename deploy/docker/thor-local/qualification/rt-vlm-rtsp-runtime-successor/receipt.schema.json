    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_count", "content_sha256", "duration_seconds", "primary_markers"],
      "properties": {
        "byte_count": {"const": 75449},
        "content_sha256": {"const": "501ddfa6400f6f717ba2de509122deacbc71abd0de1f4c91f4b0890e38bb3b29"},
        "duration_seconds": {"const": 9},
        "primary_markers": {"const": ["blue", "green", "red"]}
      }
    },
    "rtsp_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_id_exact",
        "architecture_exact",
        "network_exact",
        "no_host_ports_published",
        "publisher_running",
        "ffmpeg_binary_exact",
        "codec_h264",
        "width",
        "height",
        "fps",
        "reported_frame_rate_positive",
        "tcp_probe_passed"
      ],
      "properties": {
        "image_id_exact": {"const": true},
        "architecture_exact": {"const": true},
        "network_exact": {"const": true},
        "no_host_ports_published": {"const": true},
        "publisher_running": {"const": true},
