  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "capability_ids",
    "official_indices",
    "status",
    "contract_sha256",
    "duration_seconds",
    "budget",
    "runtime_identity",
    "fixture",
    "rtsp_support",
    "non_rtsp_scheme_negative",
    "stream_add",
    "live_caption_sse",
    "cleanup",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "rt-vlm-rtsp-runtime-successor"},
    "capability_ids": {"const": ["manifest-entry.rt-vlm-media.05-rtsp"]},
    "official_indices": {"const": [341]},
    "status": {"const": "passed"},
    "contract_sha256": {"$ref": "#/$defs/hash"},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rt_vlm_http_requests",
        "max_rt_vlm_http_requests",
        "model_requests",
        "max_model_requests",
        "docker_commands",
        "max_docker_commands",
        "support_processes_peak",
        "max_support_processes",
        "support_container_lifecycle_actions",
        "rt_vlm_stream_mutations"
      ],
      "properties": {
        "rt_vlm_http_requests": {"type": "integer", "minimum": 14, "maximum": 35},
        "max_rt_vlm_http_requests": {"const": 35},
        "model_requests": {"const": 1},
        "max_model_requests": {"const": 1},
        "docker_commands": {"type": "integer", "minimum": 7, "maximum": 12},
        "max_docker_commands": {"const": 12},
        "support_processes_peak": {"const": 2},
        "max_support_processes": {"const": 2},
        "support_container_lifecycle_actions": {"const": 2},
        "rt_vlm_stream_mutations": {"const": 3}
      }
