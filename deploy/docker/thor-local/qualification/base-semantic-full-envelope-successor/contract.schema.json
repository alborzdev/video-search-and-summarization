{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "mode", "predecessors", "authorization", "transport", "cases", "artifact_workflow", "ownership", "canonical_binding", "promotion_eligible", "warehouse_sample_bundle", "source_locks"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "base-semantic-full-envelope-successor"},
    "mode": {"const": "authorization_gated_local_runtime_candidate"},
    "predecessors": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["authorization_id", "acknowledgement"], "properties": {"authorization_id": {"const": "base-semantic-full-envelope"}, "acknowledgement": {"const": "I_ACK_BASE_FULL_ENVELOPE_LOCAL_RUNTIME"}}},
    "transport": {"type": "object", "additionalProperties": false, "required": ["numeric_loopback_only", "explicit_port_required", "proxies", "follow_redirects", "timeout_seconds", "max_request_bytes", "max_response_bytes"], "properties": {"numeric_loopback_only": {"const": true}, "explicit_port_required": {"const": true}, "proxies": {"const": false}, "follow_redirects": {"const": false}, "timeout_seconds": {"const": 10}, "max_request_bytes": {"const": 1048576}, "max_response_bytes": {"const": 33554432}}},
    "cases": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/case"}},
    "artifact_workflow": {"const": ["render-markdown", "render-pdf", "delete-markdown", "delete-pdf", "verify-markdown-absent", "verify-pdf-absent"]},
    "ownership": {"type": "object"},
    "canonical_binding": {"const": false},
    "promotion_eligible": {"const": false},
    "warehouse_sample_bundle": {"const": "excluded"},
    "source_locks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "step": {"type": "object", "additionalProperties": false, "required": ["id", "method", "path"], "properties": {"id": {"type": "string"}, "method": {"const": "POST"}, "path": {"type": "string"}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "capability_id", "oracle_id", "canonical_predecessor_max_requests", "max_requests", "max_actions", "report_step_id", "semantic_steps"], "properties": {"case_id": {"enum": ["tiny-agent-media", "hitl-state-transcript"]}, "capability_id": {"type": "string"}, "oracle_id": {"type": "string"}, "canonical_predecessor_max_requests": {"enum": [8, 11]}, "max_requests": {"enum": [11, 12]}, "max_actions": {"enum": [11, 12]}, "report_step_id": {"enum": ["generate-report", "restart-and-check-persistence"]}, "semantic_steps": {"type": "array", "minItems": 5, "maxItems": 6, "items": {"$ref": "#/$defs/step"}}}}
  }
}
