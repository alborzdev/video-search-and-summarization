{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "target", "policy", "root_requirements", "smoke_imports", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "thor-spatial-ai-utils-offline-env-v1"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "machine", "python_major_minor", "implementation", "abi", "soabi", "bootstrap_pip"],
      "properties": {
        "system": {"const": "Linux"},
        "machine": {"const": "aarch64"},
        "python_major_minor": {"const": "3.12"},
        "implementation": {"const": "cp"},
        "abi": {"const": "cp312"},
        "soabi": {"const": "cpython-312-aarch64-linux-gnu"},
        "bootstrap_pip": {"const": "24.0"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_count", "source", "network_allowed", "downloads_allowed", "index_allowed", "wheel_binaries_in_repository", "docker_allowed", "service_lifecycle_allowed", "model_access_allowed", "warehouse_sample_access_allowed", "venv_is_ephemeral", "install_dependencies"],
      "properties": {
        "artifact_count": {"const": 56},
        "source": {"const": "preexisting-local-pip-cache-only"},
        "network_allowed": {"const": false},
        "downloads_allowed": {"const": false},
        "index_allowed": {"const": false},
        "wheel_binaries_in_repository": {"const": false},
        "docker_allowed": {"const": false},
        "service_lifecycle_allowed": {"const": false},
        "model_access_allowed": {"const": false},
        "warehouse_sample_access_allowed": {"const": false},
        "venv_is_ephemeral": {"const": true},
        "install_dependencies": {"const": false}
      }
    },
    "root_requirements": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "smoke_imports": {
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "canonical_filename", "sha256", "size", "metadata_sha256", "dist_info", "root_is_purelib", "wheel_tags", "cache_identity"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version": {"type": "string", "minLength": 1},
        "canonical_filename": {"type": "string", "pattern": "^[A-Za-z0-9_.]+-[A-Za-z0-9_.!+]+-[A-Za-z0-9_.]+-[A-Za-z0-9_.]+-[A-Za-z0-9_.]+\\.whl$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "metadata_sha256": {"$ref": "#/$defs/sha256"},
        "dist_info": {"type": "string", "pattern": "^[^/]+\\.dist-info$"},
        "root_is_purelib": {"type": "boolean"},
        "wheel_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[^-]+-[^-]+-[^-]+$"}
        },
        "cache_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "project", "version", "package_type"],
          "properties": {
            "kind": {"const": "content-addressed-pip-cache-wheel-body"},
            "project": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "package_type": {"const": "bdist_wheel"}
          }
        }
      }
    }
  }
}
