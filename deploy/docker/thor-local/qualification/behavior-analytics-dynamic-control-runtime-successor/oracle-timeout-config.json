{
  "kafka": {
    "brokers": "localhost:9092",
    "consumer": {
      "autoOffsetReset": "earliest",
      "enableAutoCommit": false,
      "maxPollIntervalMs": 900000,
      "maxPartitionFetchBytes": 10485760,
      "fetchMaxBytes": 104857600,
      "maxPollRecords": 10000,
      "timeout": 0.01
    },
    "producer": {"lingerMs": 0},
    "topics": [
      {"name": "raw", "value": "vss-oracle-ba-timeout-raw"},
      {"name": "behavior", "value": "vss-oracle-ba-timeout-behavior"},
      {"name": "frames", "value": "vss-oracle-ba-timeout-frames"},
      {"name": "notification", "value": "vss-oracle-ba-timeout-notification"},
      {"name": "events", "value": "vss-oracle-ba-timeout-events"},
      {"name": "incidents", "value": "vss-oracle-ba-timeout-incidents"}
    ],
    "group": "vss-oracle-ba-timeout-group"
  },
  "sensors": [{"id": "default", "configs": []}],
  "app": [
    {"name": "sourceType", "value": "kafka"},
    {"name": "sinkType", "value": "kafka"},
    {"name": "coordinateSystem", "value": "euclidean"},
    {"name": "numWorkersForBehaviorCreation", "value": "1"},
    {"name": "numWorkersForFrameEnhancement", "value": "1"}
  ]
}
