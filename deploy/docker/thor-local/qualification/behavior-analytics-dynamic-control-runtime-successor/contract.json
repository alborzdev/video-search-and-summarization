    "vss-oracle-ba-notification",
    "vss-oracle-ba-events",
    "vss-oracle-ba-incidents"
  ],
  "required_assertions": {
    "dynamic_configuration": {
      "key": "behavior-analytics-config",
      "event_types": ["upsert", "upsert-all", "ack", "request-config"],
      "ack_statuses": ["success", "partial-success", "failure"],
      "ack_every_update": true,
      "atomic_persist": true,
      "startup_timeout_seconds": 15,
      "timeout_fallback": "disk-baseline"
    },
    "dynamic_calibration": {
      "key": "calibration",
      "event_types": ["upsert", "upsert-all", "delete"],
      "acknowledgement": false,
      "default_type": "image",
      "types": ["image", "cartesian", "geo"],
      "existing_file_type_switch": false,
      "invalid_payload_changes_live_state": false
    }
  },
  "policy": {
    "agent_generate_calls": 0,
    "external_requests": 0,
    "main_rt_cv_mutations": 0,
    "main_vios_mutations": 0,
    "normal_behavior_consumers_stopped": 0,
    "warehouse_sample_bundle": "excluded"
  },
  "explicit_nonclaims": [
    "Redis or MQTT control-path coverage",
    "Kafka, Redis, and MQTT output-sink parity",
    "live-frame hot refresh of every configuration value",
    "multi-replica fan-out",
    "disk-full injection",
    "the complete multi-stage Behavior Analytics pipeline row"
  ]
}
