{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.example/vss/thor/extended-api-surface-contracts.schema.json",
  "title": "Thor VSS extended API surface static contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_commit",
    "contract_set_sha256",
    "scope",
    "surfaces",
    "extraction_provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "target_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"$ref": "#/$defs/scope"},
    "surfaces": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/surface"}
    },
    "extraction_provenance": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/imageProvenance"},
          {"$ref": "#/$defs/checkoutProvenance"},
          {"$ref": "#/$defs/registryImageProvenance"}
        ]
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advertised_claim_family_count",
        "addressable_surface_count",
        "recoverable_surface_count",
        "authoritative_unknown_surface_count",
        "recoverable_operation_count",
        "legacy_minimum_operation_count",
        "core_surface_count_observed",
        "core_declared_rest_operations_observed",
        "core_normalized_rest_operations_observed",
        "core_official_declared_rest_operations_observed",
        "core_official_normalized_rest_operations_observed",
        "core_thor_local_extension_operations_observed",
        "complete_declared_rest_formula",
        "complete_normalized_rest_formula",
        "complete_official_declared_rest_formula",
        "complete_official_normalized_rest_formula",
        "legacy_operation_count_symbol",
        "minimum_declared_rest_operations",
        "minimum_normalized_rest_operations",
        "minimum_official_declared_rest_operations",
        "minimum_official_normalized_rest_operations",
        "complete_product_api",
        "warehouse_sample_required",
        "shared_ledgers_modified"
      ],
      "properties": {
        "advertised_claim_family_count": {"const": 5},
        "addressable_surface_count": {"const": 7},
        "recoverable_surface_count": {"const": 6},
        "authoritative_unknown_surface_count": {"const": 1},
        "recoverable_operation_count": {"const": 80},
        "legacy_minimum_operation_count": {"const": 14},
        "core_surface_count_observed": {"const": 17},
        "core_declared_rest_operations_observed": {"const": 350},
        "core_normalized_rest_operations_observed": {"const": 349},
        "core_official_declared_rest_operations_observed": {"const": 346},
        "core_official_normalized_rest_operations_observed": {"const": 345},
        "core_thor_local_extension_operations_observed": {"const": 4},
        "complete_declared_rest_formula": {"const": "430 + L"},
        "complete_normalized_rest_formula": {"const": "429 + L"},
        "complete_official_declared_rest_formula": {"const": "426 + L"},
        "complete_official_normalized_rest_formula": {"const": "425 + L"},
        "legacy_operation_count_symbol": {"const": "L"},
        "minimum_declared_rest_operations": {"const": 444},
        "minimum_normalized_rest_operations": {"const": 443},
        "minimum_official_declared_rest_operations": {"const": 440},
        "minimum_official_normalized_rest_operations": {"const": 439},
        "complete_product_api": {"const": false},
        "warehouse_sample_required": {"const": false},
        "shared_ledgers_modified": {"const": false}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "evidence", "mutation"],
      "properties": {
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]},
        "path": {"type": "string", "pattern": "^/[^?#]*$"},
        "evidence": {
          "enum": [
            "implementation",
            "implementation_only",
            "published_schema",
            "published_schema_and_implementation",
            "checked_in_catalog",
            "client_lower_bound"
          ]
        },
        "mutation": {"enum": ["read_only", "mutating", "unknown"]}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim_id",
        "title",
        "component",
        "contract_state",
        "runtime_state",
        "runtime_evidence",
        "operation_count",
        "minimum_operation_count",
        "provenance_id",
        "operations",
        "limitations"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "claim_id": {"type": "string", "pattern": "^api\\."},
        "title": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "contract_state": {"enum": ["exact_descriptor", "authoritative_unknown"]},
        "runtime_state": {"const": "not_qualified"},
        "runtime_evidence": {"type": "array", "maxItems": 0},
        "operation_count": {"type": ["integer", "null"], "minimum": 1},
        "minimum_operation_count": {"type": "integer", "minimum": 1},
        "provenance_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"contract_state": {"const": "exact_descriptor"}}},
          "then": {"properties": {"operation_count": {"type": "integer", "minimum": 1}}}
        },
        {
          "if": {"properties": {"contract_state": {"const": "authoritative_unknown"}}},
          "then": {"properties": {"operation_count": {"const": null}}}
        }
      ]
    },
    "imageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_sha256", "size_bytes", "role"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "checkoutFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_sha256", "git_blob_oid", "role"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "imageProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "mutable_tag",
        "image_reference",
        "image_digest",
        "image_id",
        "architecture",
        "os",
        "local_size_bytes",
        "observed_at",
        "required_at_validation",
        "extraction_method",
        "files"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "type": {"const": "pinned_local_image_snapshot"},
        "mutable_tag": {"type": "string", "pattern": "^nvcr\\.io/.+:[^@]+$"},
        "image_reference": {"type": "string", "pattern": "^nvcr\\.io/.+@sha256:[0-9a-f]{64}$"},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "architecture": {"const": "arm64"},
        "os": {"const": "linux"},
        "local_size_bytes": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date"},
        "required_at_validation": {"const": false},
        "extraction_method": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/imageFile"}}
      }
    },
    "checkoutProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "extraction_method", "files"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "type": {"const": "checked_in_source_snapshot"},
        "extraction_method": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/checkoutFile"}}
      }
    },
    "registryVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "os", "architecture", "compressed_size_bytes"],
      "properties": {
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "compressed_size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "registryApprovalBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_requires_explicit_approval",
        "pull_approved_at_audit",
        "pull_performed_at_audit",
        "pull_platform",
        "pull_reference",
        "pull_command_after_approval",
        "container_create_or_run_requires_separate_approval",
        "host_emulation_requires_separate_approval",
        "image_removal_or_prune_requires_separate_approval",
        "runtime_qualification_allowed_from_registry_metadata"
      ],
      "properties": {
        "pull_requires_explicit_approval": {"const": true},
        "pull_approved_at_audit": {"const": false},
        "pull_performed_at_audit": {"const": false},
        "pull_platform": {"const": "linux/amd64"},
        "pull_reference": {"type": "string", "pattern": "^nvcr\\.io/.+@sha256:[0-9a-f]{64}$"},
        "pull_command_after_approval": {"type": "string", "minLength": 1},
        "container_create_or_run_requires_separate_approval": {"const": true},
        "host_emulation_requires_separate_approval": {"const": true},
        "image_removal_or_prune_requires_separate_approval": {"const": true},
        "runtime_qualification_allowed_from_registry_metadata": {"const": false}
      }
    },
    "registryImageProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "metadata_source",
        "mutable_tag",
        "pinned_child_reference",
        "child_manifest_digest",
        "child_os",
        "child_architecture",
        "compressed_size_bytes",
        "tag_index_digest",
        "unpacked_size_bytes",
        "registry_repository_multi_architecture",
        "published_runtime_variants",
        "non_runtime_descriptors",
        "arm64_variant_present",
        "local_presence_observed",
        "runtime_state",
        "manifest_access_state",
        "observed_at",
        "required_at_validation",
        "lower_bound_provenance_id",
        "approval_boundaries"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "type": {"const": "registry_image_metadata"},
        "metadata_source": {"type": "string", "pattern": "^https://api\\.ngc\\.nvidia\\.com/"},
        "mutable_tag": {"type": "string", "pattern": "^nvcr\\.io/.+:[^@]+$"},
        "pinned_child_reference": {"type": "string", "pattern": "^nvcr\\.io/.+@sha256:[0-9a-f]{64}$"},
        "child_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "child_os": {"const": "linux"},
        "child_architecture": {"const": "amd64"},
        "compressed_size_bytes": {"const": 981287603},
        "tag_index_digest": {"const": null},
        "unpacked_size_bytes": {"const": null},
        "registry_repository_multi_architecture": {"const": true},
        "published_runtime_variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/registryVariant"}
        },
        "non_runtime_descriptors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/registryVariant"}
        },
        "arm64_variant_present": {"const": false},
        "local_presence_observed": {"const": false},
        "runtime_state": {"const": "blocked_architecture"},
        "manifest_access_state": {"const": "denied"},
        "observed_at": {"type": "string", "format": "date"},
        "required_at_validation": {"const": false},
        "lower_bound_provenance_id": {"const": "legacy-calibration-checkout"},
        "approval_boundaries": {"$ref": "#/$defs/registryApprovalBoundaries"}
      }
    }
  }
}
