{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_index_raw_sha256": {"$ref": "#/$defs/sha256"},
    "admitted_candidate_count": {"const": 0},
    "executable_candidate_count": {"const": 0},
    "receipt_count": {"const": 0},
    "receipt_envelope_schema_raw_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_set_id": {"minLength": 1, "type": "string"},
    "receipts": {"items": {"$ref": "#/$defs/receipt"}, "maxItems": 0, "type": "array"},
    "schema_version": {"const": 1},
    "trusted_review_authority_binding_sha256": {"items": {"$ref": "#/$defs/sha256"}, "maxItems": 0, "type": "array", "uniqueItems": true},
    "warehouse_sample_bundle": {"const": "excluded"}
  },
  "required": ["receipt_set_id", "schema_version", "admission_index_raw_sha256", "receipt_envelope_schema_raw_sha256", "receipt_count", "receipts", "trusted_review_authority_binding_sha256", "admitted_candidate_count", "executable_candidate_count", "warehouse_sample_bundle"],
  "type": "object",
  "$defs": {
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "authorization": {
      "additionalProperties": false,
      "properties": {
        "authorization_id": {"minLength": 1, "type": "string"},
        "authorization_event_nonce_sha256": {"$ref": "#/$defs/sha256"},
        "detached_signature": {"minLength": 1, "type": "string"},
        "inherited": {"const": false},
        "issuer_public_key_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "issuer_identity": {"minLength": 1, "type": "string"},
        "subject_identity": {"minLength": 1, "type": "string"}
      },
      "required": ["authorization_id", "authorization_event_nonce_sha256", "detached_signature", "inherited", "issuer_identity", "issuer_public_key_fingerprint_sha256", "subject_identity"],
      "type": "object"
    },
    "dependency_receipt": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {"minLength": 1, "type": "string"},
        "kind": {"const": "receipt"},
        "receipt_id": {"minLength": 1, "type": "string"}
      },
      "required": ["bundle_id", "kind", "receipt_id"],
      "type": "object"
    },
    "not_required": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {"minLength": 1, "type": "string"},
        "determination_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "determination_id": {"minLength": 1, "type": "string"},
        "kind": {"const": "reviewed_not_required"},
        "non_inheriting": {"const": true},
        "rationale_contract_sha256": {"$ref": "#/$defs/sha256"},
        "review_authority_binding_sha256": {"$ref": "#/$defs/sha256"},
        "review_detached_signature": {"minLength": 1, "type": "string"},
        "reviewer_public_key_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}
      },
      "required": ["bundle_id", "determination_canonical_sha256", "determination_id", "kind", "non_inheriting", "rationale_contract_sha256", "review_authority_binding_sha256", "review_detached_signature", "reviewer_public_key_fingerprint_sha256", "reviewed_at"],
      "type": "object"
    },
    "receipt": {
      "additionalProperties": false,
      "properties": {
        "action_contract_sha256": {"$ref": "#/$defs/sha256"},
        "authorization": {"$ref": "#/$defs/authorization"},
        "bundle_contract_raw_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_id": {"minLength": 1, "type": "string"},
        "candidate_id": {"pattern": "^manifest-entry\\.", "type": "string"},
        "candidate_record_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "cleanup_rollback_contract_sha256": {"$ref": "#/$defs/sha256"},
        "complete_dependency_closure_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_authorizations": {"items": {"oneOf": [{"$ref": "#/$defs/dependency_receipt"}, {"$ref": "#/$defs/not_required"}]}, "type": "array"},
        "evidence_destination_sha256": {"$ref": "#/$defs/sha256"},
        "execution_boundary": {"enum": ["alternate_local", "external", "local"]},
        "expires_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
        "input_model_fixture_binding_sha256": {"$ref": "#/$defs/sha256"},
        "is_primary_leaf_receipt": {"type": "boolean"},
        "issued_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
        "mapping_artifact_raw_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_row_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "metadata_binding_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "not_before": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
        "one_time_use": {"const": true},
        "oracle_id": {"pattern": "^oracle\\.manifest-entry\\.", "type": "string"},
        "receipt_id": {"minLength": 1, "type": "string"},
        "receipt_purpose": {"enum": ["action_authorization", "successful_dependency_completion"]},
        "replay_domain_sha256": {"$ref": "#/$defs/sha256"},
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "selected_metadata_oracle_raw_sha256": {"$ref": "#/$defs/sha256"},
        "selected_metadata_set_id": {"minLength": 1, "type": "string"},
        "service_role_profile_binding_sha256": {"$ref": "#/$defs/sha256"},
        "warehouse_sample_bundle": {"const": "excluded"}
      },
      "required": ["receipt_id", "receipt_purpose", "candidate_id", "candidate_record_canonical_sha256", "oracle_id", "selected_metadata_set_id", "selected_metadata_oracle_raw_sha256", "metadata_binding_canonical_sha256", "mapping_artifact_raw_sha256", "mapping_row_canonical_sha256", "bundle_contract_raw_sha256", "bundle_id", "complete_dependency_closure_canonical_sha256", "execution_boundary", "is_primary_leaf_receipt", "dependency_authorizations", "authorization", "issued_at", "not_before", "expires_at", "one_time_use", "run_binding_sha256", "replay_domain_sha256", "action_contract_sha256", "service_role_profile_binding_sha256", "input_model_fixture_binding_sha256", "cleanup_rollback_contract_sha256", "evidence_destination_sha256", "warehouse_sample_bundle", "canonical_receipt_sha256"],
      "type": "object"
    }
  }
}
