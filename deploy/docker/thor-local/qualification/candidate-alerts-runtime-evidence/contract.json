  "default_execution_enabled": false,
  "planning_requirement_id": "candidate-alerts",
  "capability_id": "runtime.workflow.alert-verification",
  "oracle_id": "oracle.runtime.workflow.alert-verification",
  "authorization": {
    "authorization_id": "candidate-alerts-runtime",
    "acknowledgement": "I_ACK_CANDIDATE_ALERTS_CONFIG_MUTATION_AND_BACKGROUND_VLM"
  },
  "target": {
    "default_origin": "http://127.0.0.1:9080",
    "numeric_loopback_only": true,
    "proxies": false,
    "follow_redirects": false,
    "paths": [
      "/health",
      "/api/v1/verification/config",
      "/api/v1/verification/ondemand"
    ]
  },
  "execution_bounds": {
    "max_requests": 8,
    "max_actions": 8,
    "max_request_bytes": 65536,
    "max_response_bytes": 1048576,
    "timeout_seconds": 10,
    "phases": [
      "pre_state",
      "positive",
      "adjacent_negative",
      "restore",
      "postcondition"
    ]
  },
  "workflow": [
    "health",
    "pre_state_config_list",
    "create_exact_owned_config",
    "inspect_exact_run_marker_and_admit_cleanup_ownership",
    "positive_ondemand_admission",
    "adjacent_unknown_category_rejection",
    "delete_exact_owned_config",
    "post_state_config_list_and_digest"
  ],
  "cleanup": {
    "order": "lifo",
    "owned_resource_type": "alert-verification-config",
    "transitions_per_resource": 2,
    "registration_gate": "POST 201 plus exact GET readback with unique run-owned marker",
    "ambiguous_create_policy": "fail closed without cleanup registration or deletion",
    "postcondition": "owned config absent and non-owned config digest restored"
  },
  "evidence_scope": {
    "observes": [
      "alert_bridge_health",
      "config_identity",
      "positive_202_admission",
      "adjacent_unknown_category_400",
      "exact_cleanup",
      "non_owned_config_digest_restore"
    ],
    "does_not_observe": [
      "background_vlm_completion",
      "final_vlm_verdict",
      "kafka_or_elasticsearch_sink_delivery",
      "media_payload_digest",
      "fixture_server_identity"
    ],
    "promotion_eligible": false
  },
