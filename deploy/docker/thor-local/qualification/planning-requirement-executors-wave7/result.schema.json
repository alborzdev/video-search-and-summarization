{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "advances_live_acceptance", "runtime_evidence_added", "inventory_sha256", "set_digests", "baseline_checks", "counts", "remaining_requirement_audit", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"const": "isolated_candidate_only"},
    "advances_live_acceptance": {"const": false},
    "runtime_evidence_added": {"const": false},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "set_digests": {
      "type": "object", "additionalProperties": false,
      "required": ["prior_50", "wave6_remaining_60", "wave7_selected_6", "wave7_remaining_54"],
      "properties": {
        "prior_50": {"const": "d1eca2fd7439a268708ca39cb27e224fbcbbd644b145088030d72ec9c81a08a9"},
        "wave6_remaining_60": {"const": "12bada9c389b5550910bfed7073281a59d63b5616266118e983f75522126c342"},
        "wave7_selected_6": {"const": "9a3b857dfaff5ac163634dc123dec40967a0a04e63b70c7fb39b546e009a8c03"},
        "wave7_remaining_54": {"const": "cae70bf8d08a7cf01ddd583e3b20821d1e18678a95418ce4503d7edcb07bf050"}
      }
    },
    "baseline_checks": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/file_check"}},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["total_planning_requirements", "integrated_materialized", "live_open", "prior_package_selections", "prior_materialized_static_bindings", "prior_live_open_candidate_selections", "remaining_requirements_audited", "cases", "observed_match", "observed_mismatch", "negative_contracts_preserved", "configuration_subsets", "protocol_subsets", "remaining_requirements_unselected"],
      "properties": {
        "total_planning_requirements": {"const": 110},
        "integrated_materialized": {"const": 26},
        "live_open": {"const": 84},
        "prior_package_selections": {"const": 50},
        "prior_materialized_static_bindings": {"const": 26},
        "prior_live_open_candidate_selections": {"const": 24},
        "remaining_requirements_audited": {"const": 60},
        "cases": {"const": 6},
        "observed_match": {"const": 6},
        "observed_mismatch": {"const": 0},
        "negative_contracts_preserved": {"const": 3},
        "configuration_subsets": {"const": 2},
        "protocol_subsets": {"const": 1},
        "remaining_requirements_unselected": {"const": 54}
      }
    },
    "remaining_requirement_audit": {
      "type": "array", "minItems": 60, "maxItems": 60,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["planning_requirement_id", "owner_id", "package", "planning_payload_sha256", "capability_sha256", "contract_sha256", "classification"],
        "properties": {
          "planning_requirement_id": {"type": "string", "minLength": 1},
          "owner_id": {"type": "string", "minLength": 1},
          "package": {"enum": ["agent-smartcity", "systems", "calibration-warehouse"]},
          "planning_payload_sha256": {"$ref": "#/$defs/sha256"},
          "capability_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "contract_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "classification": {"enum": ["selected_static_negative_contract", "selected_static_configuration_subset", "selected_static_protocol_subset", "requires_custom_media_and_runtime_qualification", "requires_fixture_or_independent_source_semantics", "requires_runtime_or_complete_independent_source_semantics"]}
        }
      }
    },
    "results": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "planning_requirement_id", "capability_id", "outcome", "evidence_class", "binding_checks", "source_checks", "assertions", "runtime_evidence"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^wave7-source-case\\."},
          "planning_requirement_id": {"type": "string", "minLength": 1},
          "capability_id": {"type": "string", "minLength": 1},
          "outcome": {"const": "source_subset_match_candidate_only"},
          "evidence_class": {"enum": ["static_negative_contract_preserved", "static_configuration_subset_only", "static_protocol_subset_only"]},
          "binding_checks": {
            "type": "object", "additionalProperties": false,
            "required": ["requirement_payload_sha256", "capability_sha256", "contract_sha256", "oracle_sha256", "owner_binding", "requirement_still_open", "oracle_still_open"],
            "properties": {
              "requirement_payload_sha256": {"const": true}, "capability_sha256": {"const": true}, "contract_sha256": {"const": true}, "oracle_sha256": {"const": true}, "owner_binding": {"const": true}, "requirement_still_open": {"const": true}, "oracle_still_open": {"const": true}
            }
          },
          "source_checks": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/file_check"}},
          "assertions": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["assertion_id", "passed", "detail"],
              "properties": {"assertion_id": {"type": "string", "minLength": 1}, "passed": {"const": true}, "detail": {"const": "missing=[]"}}
            }
          },
          "runtime_evidence": {"const": []}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_check": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256_match"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256_match": {"const": true}}
    }
  }
}
