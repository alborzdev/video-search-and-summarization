{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "status", "contract_sha256", "run_id_sha256", "origin_sha256", "fixture_sha256", "model_sha256", "budget", "observations", "semantic_coverage", "cleanup", "promotion_eligible", "executor_ready", "warehouse_sample_bundle"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "thor-vss-lvs-semantic-runtime-http-successor-v1"},
    "status": {"const": "candidate_pass"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "run_id_sha256": {"$ref": "#/$defs/sha256"},
    "origin_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_sha256": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "max_requests", "actions", "max_actions", "max_duration_seconds"],
      "properties": {
        "requests": {"type": "integer", "minimum": 1, "maximum": 14},
        "max_requests": {"const": 14},
        "actions": {"type": "integer", "minimum": 1, "maximum": 14},
        "max_actions": {"const": 14},
        "max_duration_seconds": {"const": 900}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "action_id", "method", "path_template", "http_status", "response_bytes", "response_sha256", "result"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 14},
          "action_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "method": {"enum": ["GET", "POST", "DELETE"]},
          "path_template": {"type": "string", "minLength": 1, "maxLength": 128},
          "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
          "response_bytes": {"type": "integer", "minimum": 0, "maximum": 4194304},
          "response_sha256": {"$ref": "#/$defs/sha256"},
          "result": {"enum": ["pass", "cleanup_pass"]}
        }
      }
    },
    "semantic_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concrete_complete", "concrete_partial", "residual_adapter_required"],
      "properties": {
        "concrete_complete": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "concrete_partial": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string"}},
        "residual_adapter_required": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registered_owned_files", "deleted_owned_files", "owned_absent", "unrelated_state_restored", "exact_delete_confirmations"],
      "properties": {
        "registered_owned_files": {"const": 2},
        "deleted_owned_files": {"const": 2},
        "owned_absent": {"const": true},
        "unrelated_state_restored": {"const": true},
        "exact_delete_confirmations": {"const": true}
      }
    },
    "promotion_eligible": {"const": false},
    "executor_ready": {"const": false},
    "warehouse_sample_bundle": {"const": "excluded"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
