{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_id", "capability_ids", "official_indices", "status",
    "contract_sha256", "duration_seconds", "budget", "runtime_identity", "kafka",
    "redis", "schema_equal_between_backends", "cleanup", "policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "rt-vlm-error-publication-runtime-successor"},
    "capability_ids": {
      "const": ["manifest-entry.rt-vlm-performance-observability.05-kafka-redis-error-publication"]
    },
    "official_indices": {"const": [365]},
    "status": {"const": "passed"},
    "contract_sha256": {"$ref": "#/$defs/hash"},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
    "budget": {
      "const": {
        "docker_commands": 4,
        "http_requests": 0,
        "kafka_topic_mutations": 2,
        "max_docker_commands": 4,
        "max_http_requests": 0,
        "max_kafka_topic_mutations": 2,
        "max_model_requests": 0,
        "max_redis_persistent_mutations": 0,
        "max_support_processes": 1,
        "model_requests": 0,
        "redis_persistent_mutations": 0,
        "support_processes_peak": 1
      }
    },
    "runtime_identity": {
      "const": {
        "kafka_healthy": true,
        "kafka_image_exact": true,
        "kafka_oom_killed": false,
        "kafka_restart_count": 0,
        "redis_healthy": true,
        "redis_host_gateway_exact": true,
        "redis_image_exact": true,
        "redis_oom_killed": false,
        "redis_restart_count": 0,
        "rt_vlm_healthy": true,
        "rt_vlm_image_exact": true,
        "rt_vlm_oom_killed": false,
        "rt_vlm_restart_count": 0
      }
    },
    "kafka": {"$ref": "#/$defs/publication"},
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_switch_routed_to_redis", "event_exact", "message_count",
        "persistent_keys_created", "schema_exact", "source_exact", "stream_exact",
        "timestamp_utc_parseable", "type_exact"
      ],
      "properties": {
        "backend_switch_routed_to_redis": {"const": true},
        "event_exact": {"const": true},
        "message_count": {"const": 1},
        "persistent_keys_created": {"const": 0},
        "schema_exact": {"const": true},
        "source_exact": {"const": true},
        "stream_exact": {"const": true},
        "timestamp_utc_parseable": {"const": true},
        "type_exact": {"const": true}
      }
    },
    "schema_equal_between_backends": {"const": true},
    "cleanup": {
      "const": {
        "kafka_topic_absent": true,
        "redis_persistent_key_absent": true,
        "redis_subscriber_count": 0,
        "sender_threads_stopped": true
      }
    },
    "policy": {
      "const": {
        "agent_generate_calls": 0,
        "asset_mutations": 0,
        "core_service_lifecycle_actions": 0,
        "credentials_retained": false,
        "raw_channel_names_retained": false,
        "raw_message_payloads_retained": false,
        "raw_topic_names_retained": false,
        "stream_mutations": 0,
        "warehouse_sample_bundle": "excluded"
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_exact", "message_type_header_exact", "record_count", "schema_exact",
        "source_exact", "stream_exact", "timestamp_utc_parseable", "type_exact"
      ],
      "properties": {
        "event_exact": {"const": true},
        "message_type_header_exact": {"const": true},
        "record_count": {"const": 1},
        "schema_exact": {"const": true},
        "source_exact": {"const": true},
        "stream_exact": {"const": true},
        "timestamp_utc_parseable": {"const": true},
        "type_exact": {"const": true}
      }
    }
  }
}
