    "source_preflight": {"type": "object", "additionalProperties": false, "required": ["verified", "source_lock_count", "oracle_binding_count", "recorded_image_identity_count", "image_identity_source"], "properties": {"verified": {"const": true}, "source_lock_count": {"const": 42}, "oracle_binding_count": {"const": 6}, "recorded_image_identity_count": {"const": 4}, "image_identity_source": {"const": "repository-evidence-only"}}},
