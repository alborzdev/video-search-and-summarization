  "workflow": [
    "capture exact Docker inventory, running set, reserved ports, fixture, and main-VIOS sensor state",
    "start the exact offline arm64 Thor-local NvStreamer image in an isolated temporary namespace with one oracle-owned bootstrap file",
    "wait for the bootstrap sensor to prove the streamer adaptor and RTSP load balancer are initialized",
    "generate the exact bounded 2-second H.264/AAC oracle and upload it through the documented isolated NvStreamer single-chunk API",
    "republish the uploaded clip as an isolated local RTSP/live source",
    "reject a live stream/start request with peerId removed and prove no peer resource is retained",
    "select the oracle-owned source in the shipped Media Streams UI",
    "complete live WebSocket configuration, SDP, and ICE negotiation in Chromium",
    "observe an unmuted 16:9 WebRTC track at the source 320x180 or service-default 1920x1080 output, with advancing decoded frames and nondecreasing presentation and service timestamps",
    "observe targeted PLAYING status while the peer is active",
    "close the player, observe stream/stop and WebSocket close, and verify the peer is absent",
    "remove the isolated container and temporary tree and verify exact host/main-VIOS restoration"
  ],
  "privacy": {
    "retain_peer_ids": false,
    "retain_media_session_ids": false,
    "retain_sdp": false,
    "retain_ice_candidates": false
  },
  "cleanup": {
    "mutation": "isolated_ephemeral_container_and_session_only",
    "executor": "native UI stream/stop followed by owned-container removal",
    "postconditions": [
      "the executor-owned live peer is rejected as absent",
      "aggregate live status is null",
      "the live WebSocket is closed",
      "the video element is removed",
      "the qualifier container and temporary fixture are absent",
      "all reserved ports are released",
      "Docker inventory/running set and main-VIOS sensors equal pre-state"
    ]
  },
