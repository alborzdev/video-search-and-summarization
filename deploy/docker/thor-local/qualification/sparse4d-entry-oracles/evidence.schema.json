  "properties": {
    "schema_version": {"const": 1}, "purpose": {"const": "candidate_runtime_evidence_for_review_only"}, "candidate_status": {"const": "observed_not_admitted"}, "live_ledger_mutation": {"const": false},
    "admission": {"$ref": "#/$defs/admission"}, "preflight": {"$ref": "#/$defs/preflight"}, "run": {"$ref": "#/$defs/run"}, "model_proof": {"$ref": "#/$defs/model_proof"},
