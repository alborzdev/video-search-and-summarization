    "correlation": {"type": "object", "additionalProperties": false, "required": ["global_track_id", "from_camera", "to_camera", "from_timestamp_ms", "to_timestamp_ms", "capture"], "properties": {"global_track_id": {"$ref": "#/$defs/safe_id"}, "from_camera": {"$ref": "#/$defs/camera_id"}, "to_camera": {"$ref": "#/$defs/camera_id"}, "from_timestamp_ms": {"type": "integer", "minimum": 0}, "to_timestamp_ms": {"type": "integer", "minimum": 0}, "capture": {"$ref": "#/$defs/artifact"}}},
    "pipeline_evidence": {"type": "object", "additionalProperties": false, "required": ["entry_id", "oracle_id", "candidate_observation", "per_camera_detections", "topic", "fused_tracks", "cross_camera_correlations", "cleanup_evidence_id"], "properties": {"entry_id": {"const": "manifest-gap.rt-cv-3d-sparse4d.00-sparse4d-multi-camera-3d-detection-and-tracking"}, "oracle_id": {"const": "oracle.manifest-entry.rt-cv-3d-sparse4d.00"}, "candidate_observation": {"const": "observed_not_admitted"}, "per_camera_detections": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/camera_observation"}}, "topic": {"const": "mdx-bev"}, "fused_tracks": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/fused_track"}}, "cross_camera_correlations": {"type": "array", "minItems": 2, "maxItems": 1000, "items": {"$ref": "#/$defs/correlation"}}, "cleanup_evidence_id": {"$ref": "#/$defs/safe_id"}}},
    "service_health": {"type": "object", "additionalProperties": false, "required": ["service", "state", "health", "capture"], "properties": {"service": {"$ref": "#/$defs/safe_id"}, "state": {"const": "running"}, "health": {"enum": ["healthy", "none"]}, "capture": {"$ref": "#/$defs/artifact"}}},
    "health_evidence": {"type": "object", "additionalProperties": false, "required": ["entry_id", "oracle_id", "candidate_observation", "services", "throughput", "latency", "resources", "stream_growth", "cleanup_evidence_id"], "properties": {"entry_id": {"const": "manifest-gap.rt-cv-3d-sparse4d.01-shared-rt-cv-lifecycle-health-metrics"}, "oracle_id": {"const": "oracle.manifest-entry.rt-cv-3d-sparse4d.01"}, "candidate_observation": {"const": "observed_not_admitted"}, "services": {"type": "array", "minItems": 7, "maxItems": 31, "items": {"$ref": "#/$defs/service_health"}}, "throughput": {"type": "object", "additionalProperties": false, "required": ["fps", "sample_seconds", "frames_processed", "capture"], "properties": {"fps": {"type": "number", "exclusiveMinimum": 0}, "sample_seconds": {"type": "integer", "minimum": 1, "maximum": 60}, "frames_processed": {"type": "integer", "minimum": 1}, "capture": {"$ref": "#/$defs/artifact"}}}, "latency": {"type": "object", "additionalProperties": false, "required": ["metric", "sample_count", "p50_ms", "p95_ms", "p99_ms", "capture"], "properties": {"metric": {"const": "end_to_end_latency_ms"}, "sample_count": {"type": "integer", "minimum": 1}, "p50_ms": {"type": "number", "minimum": 0}, "p95_ms": {"type": "number", "minimum": 0}, "p99_ms": {"type": "number", "minimum": 0}, "capture": {"$ref": "#/$defs/artifact"}}}, "resources": {"type": "object", "additionalProperties": false, "required": ["memory_peak_mib", "gpu_peak_percent", "cpu_peak_percent", "disk_written_bytes", "capture"], "properties": {"memory_peak_mib": {"type": "number", "exclusiveMinimum": 0}, "gpu_peak_percent": {"type": "number", "minimum": 0, "maximum": 100}, "cpu_peak_percent": {"type": "number", "minimum": 0}, "disk_written_bytes": {"type": "integer", "minimum": 0}, "capture": {"$ref": "#/$defs/artifact"}}}, "stream_growth": {"type": "object", "additionalProperties": false, "required": ["mdx_bev_before", "mdx_bev_after", "mdx_behavior_after", "capture"], "properties": {"mdx_bev_before": {"type": "integer", "minimum": 0}, "mdx_bev_after": {"type": "integer", "minimum": 1}, "mdx_behavior_after": {"type": "integer", "minimum": 1}, "capture": {"$ref": "#/$defs/artifact"}}}, "cleanup_evidence_id": {"$ref": "#/$defs/safe_id"}}},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["cleanup_evidence_id", "ownership_prefix", "created_resource_ids", "removed_resource_ids", "preexisting_resource_ids", "preexisting_resources_unchanged", "broad_delete_used", "completed", "capture"], "properties": {"cleanup_evidence_id": {"$ref": "#/$defs/safe_id"}, "ownership_prefix": {"$ref": "#/$defs/safe_id"}, "created_resource_ids": {"type": "array", "minItems": 2, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/safe_id"}}, "removed_resource_ids": {"type": "array", "minItems": 2, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/safe_id"}}, "preexisting_resource_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/safe_id"}}, "preexisting_resources_unchanged": {"const": true}, "broad_delete_used": {"const": false}, "completed": {"const": true}, "capture": {"$ref": "#/$defs/artifact"}}}
  }
