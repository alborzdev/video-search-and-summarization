    "camera_admission": {"type": "object", "additionalProperties": false, "required": ["camera_id", "video_sha256", "calibration_sensor_sha256"], "properties": {"camera_id": {"$ref": "#/$defs/camera_id"}, "video_sha256": {"$ref": "#/$defs/sha256"}, "calibration_sensor_sha256": {"$ref": "#/$defs/sha256"}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["filename", "sha256", "regular_non_symlink"], "properties": {"filename": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "regular_non_symlink": {"const": true}}},
    "admission": {
      "type": "object", "additionalProperties": false,
