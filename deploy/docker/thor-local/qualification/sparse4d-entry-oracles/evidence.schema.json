      "properties": {
        "dataset_slug": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$", "not": {"const": "warehouse-4cams-20mx20m-synthetic"}}, "input_root": {"type": "string", "pattern": "^/", "minLength": 2}, "warehouse_sample_bundle": {"const": false}, "camera_count": {"const": 4}, "camera_ids": {"const": ["Camera", "Camera_01", "Camera_02", "Camera_03"]},
        "cameras": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"allOf": [{"$ref": "#/$defs/camera_admission"}, {"properties": {"camera_id": {"const": "Camera"}}}]}, {"allOf": [{"$ref": "#/$defs/camera_admission"}, {"properties": {"camera_id": {"const": "Camera_01"}}}]}, {"allOf": [{"$ref": "#/$defs/camera_admission"}, {"properties": {"camera_id": {"const": "Camera_02"}}}]}, {"allOf": [{"$ref": "#/$defs/camera_admission"}, {"properties": {"camera_id": {"const": "Camera_03"}}}]}], "items": false},
        "calibration_sha256": {"$ref": "#/$defs/sha256"}, "top_view_sha256": {"$ref": "#/$defs/sha256"}, "custom_data_manifest_sha256": {"$ref": "#/$defs/sha256"},
