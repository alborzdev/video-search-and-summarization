        "anchor": {"type": "object", "additionalProperties": false, "required": ["filename", "sha256", "regular_non_symlink", "shape", "dtype", "finite"], "properties": {"filename": {"const": "_ov_kmeans900_v2.2.npy"}, "sha256": {"$ref": "#/$defs/sha256"}, "regular_non_symlink": {"const": true}, "shape": {"const": [900, 11]}, "dtype": {"enum": ["float32", "float64"]}, "finite": {"const": true}}},
        "validator": {"type": "object", "additionalProperties": false, "required": ["source_path", "source_sha256", "exit_code", "streams", "sensor_ids", "synchronized", "sparse4d_contract"], "properties": {"source_path": {"const": "deploy/docker/thor-local/validate-warehouse-sparse4d-input.py"}, "source_sha256": {"const": "ecbe1a4e43487a491547b8fd5b62fe542c19a2e90a6eb0c1d1108339b3cd02c3"}, "exit_code": {"const": 0}, "streams": {"const": 4}, "sensor_ids": {"const": ["Camera", "Camera_01", "Camera_02", "Camera_03"]}, "synchronized": {"const": true}, "sparse4d_contract": {"const": "four synchronized cameras"}}},
        "prepare": {"type": "object", "additionalProperties": false, "required": ["lane_source_sha256", "private_runtime_root", "asset_manifest_sha256", "deployment_snapshot_sha256", "copied_assets_revalidated"], "properties": {"lane_source_sha256": {"const": "c1174164a494263e62139e9507e15836b539b133cebae813ec99b5bbc5765f4c"}, "private_runtime_root": {"type": "string", "pattern": "^/", "minLength": 2}, "asset_manifest_sha256": {"$ref": "#/$defs/sha256"}, "deployment_snapshot_sha256": {"$ref": "#/$defs/sha256"}, "copied_assets_revalidated": {"const": true}}}
      }
    },
    "preflight": {"type": "object", "additionalProperties": false, "required": ["passed", "profile", "hardware", "architecture", "memory_available_kib", "disk_available_kib", "gpu_conflicts", "port_conflicts", "missing_images", "all_images_local_arm64", "capture"], "properties": {"passed": {"const": true}, "profile": {"enum": ["minimal", "extended"]}, "hardware": {"const": "AGX-THOR"}, "architecture": {"const": "aarch64"}, "memory_available_kib": {"type": "integer", "minimum": 52428800}, "disk_available_kib": {"type": "integer", "minimum": 31457280}, "gpu_conflicts": {"const": 0}, "port_conflicts": {"const": 0}, "missing_images": {"const": 0}, "all_images_local_arm64": {"const": true}, "capture": {"$ref": "#/$defs/artifact"}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["namespace", "profile", "started_at", "ended_at", "launcher_source_path", "launcher_source_sha256", "explicit_lifecycle_authorization_id"], "properties": {"namespace": {"$ref": "#/$defs/safe_id"}, "profile": {"enum": ["minimal", "extended"]}, "started_at": {"$ref": "#/$defs/timestamp"}, "ended_at": {"$ref": "#/$defs/timestamp"}, "launcher_source_path": {"const": "deploy/docker/scripts/thor-warehouse-sparse4d.sh"}, "launcher_source_sha256": {"const": "c1174164a494263e62139e9507e15836b539b133cebae813ec99b5bbc5765f4c"}, "explicit_lifecycle_authorization_id": {"$ref": "#/$defs/safe_id"}}},
    "model_event": {"type": "object", "additionalProperties": false, "required": ["event", "model_filename", "model_sha256", "service", "capture"], "properties": {"event": {"enum": ["model_loaded", "inference_used"]}, "model_filename": {"enum": ["rtdetr_warehouse_v1.0.2.fp16.onnx", "sparse4d_warehouse_v2.2.onnx"]}, "model_sha256": {"$ref": "#/$defs/sha256"}, "service": {"const": "vss-rtvi-cv"}, "capture": {"$ref": "#/$defs/artifact"}, "inference_count": {"type": "integer", "minimum": 1}}},
    "model_pair": {"type": "object", "additionalProperties": false, "required": ["model_filename", "model_sha256", "loaded", "used"], "properties": {"model_filename": {"enum": ["rtdetr_warehouse_v1.0.2.fp16.onnx", "sparse4d_warehouse_v2.2.onnx"]}, "model_sha256": {"$ref": "#/$defs/sha256"}, "loaded": {"allOf": [{"$ref": "#/$defs/model_event"}, {"properties": {"event": {"const": "model_loaded"}}, "not": {"required": ["inference_count"]}}]}, "used": {"allOf": [{"$ref": "#/$defs/model_event"}, {"properties": {"event": {"const": "inference_used"}}, "required": ["inference_count"]}]}}},
    "model_proof": {"type": "object", "additionalProperties": false, "required": ["rtdetr", "sparse4d", "anchor_sha256"], "properties": {"rtdetr": {"$ref": "#/$defs/model_pair"}, "sparse4d": {"$ref": "#/$defs/model_pair"}, "anchor_sha256": {"$ref": "#/$defs/sha256"}}},
    "bbox2d": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "detection": {"type": "object", "additionalProperties": false, "required": ["track_id", "class_id", "confidence", "bbox"], "properties": {"track_id": {"$ref": "#/$defs/safe_id"}, "class_id": {"type": "integer", "minimum": 0}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "bbox": {"$ref": "#/$defs/bbox2d"}}},
    "camera_observation": {"type": "object", "additionalProperties": false, "required": ["camera_id", "topic", "detections", "capture"], "properties": {"camera_id": {"$ref": "#/$defs/camera_id"}, "topic": {"const": "mdx-raw"}, "detections": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/detection"}}, "capture": {"$ref": "#/$defs/artifact"}}},
