{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mode", "policy", "admission", "advertised_oracles", "current_blockers", "source_locks"],
  "properties": {
    "schema_version": {"const": 1}, "mode": {"const": "inert_sparse4d_advertised_entry_admission"},
    "policy": {"type": "object", "additionalProperties": false, "required": ["default_action", "candidate_evidence_only", "advances_live_ledgers", "runtime_receipts_bundled", "docker", "network", "subprocess", "lifecycle", "model_load", "downloads", "writes", "warehouse_sample_bundle"], "properties": {"default_action": {"const": "read_only_plan"}, "candidate_evidence_only": {"const": true}, "advances_live_ledgers": {"const": false}, "runtime_receipts_bundled": {"const": false}, "docker": {"const": false}, "network": {"const": false}, "subprocess": {"const": false}, "lifecycle": {"const": false}, "model_load": {"const": false}, "downloads": {"const": false}, "writes": {"const": false}, "warehouse_sample_bundle": {"const": "excluded"}}},
    "admission": {"type": "object", "additionalProperties": false, "required": ["camera_count", "camera_ids", "dataset", "validator", "lane", "lane_stages", "sparse4d_model", "anchor", "anchor_shape", "rtdetr_model", "memory_floor_kib", "disk_floor_kib", "gpu_conflicts_allowed", "next_action"], "properties": {"camera_count": {"const": 4}, "camera_ids": {"const": ["Camera", "Camera_01", "Camera_02", "Camera_03"]}, "dataset": {"const": "operator_supplied_custom_slug_only"}, "validator": {"const": "deploy/docker/thor-local/validate-warehouse-sparse4d-input.py"}, "lane": {"const": "deploy/docker/scripts/thor-warehouse-sparse4d.sh"}, "lane_stages": {"const": ["plan", "prepare", "preflight", "qualify"]}, "sparse4d_model": {"const": "sparse4d_warehouse_v2.2.onnx"}, "anchor": {"const": "_ov_kmeans900_v2.2.npy"}, "anchor_shape": {"const": [900, 11]}, "rtdetr_model": {"const": "rtdetr_warehouse_v1.0.2.fp16.onnx"}, "memory_floor_kib": {"const": 52428800}, "disk_floor_kib": {"const": 31457280}, "gpu_conflicts_allowed": {"const": 0}, "next_action": {"const": "resolve_blockers_then_operator_review_and_separate_authorized_runtime"}}},
    "advertised_oracles": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["entry_id", "advertised", "oracle_id", "required_oracle_canonical_sha256", "semantic_plan"], "properties": {"entry_id": {"type": "string", "pattern": "^manifest-gap\\.rt-cv-3d-sparse4d\\.0[01]-"}, "advertised": {"type": "string", "minLength": 1}, "oracle_id": {"type": "string", "pattern": "^oracle\\.manifest-entry\\.rt-cv-3d-sparse4d\\.0[01]$"}, "required_oracle_canonical_sha256": {"$ref": "#/$defs/sha256"}, "semantic_plan": {"type": "string", "minLength": 1}}}},
    "current_blockers": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_locks": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
