{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/vss/thor/runtime-evidence-common/contract.schema.json",
  "title": "Thor runtime evidence common contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "mode",
    "default_execution_enabled",
    "transport",
    "budgets",
    "identity",
    "resources",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "const": "runtime-evidence-common" },
    "mode": { "const": "inert-library" },
    "default_execution_enabled": { "const": false },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numeric_loopback_only",
        "explicit_port_required",
        "proxies",
        "follow_redirects",
        "injected_opener_required",
        "max_request_bytes",
        "max_response_bytes",
        "timeout_seconds"
      ],
      "properties": {
        "numeric_loopback_only": { "const": true },
        "explicit_port_required": { "const": true },
        "proxies": { "const": false },
        "follow_redirects": { "const": false },
        "injected_opener_required": { "const": true },
        "max_request_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
        "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_actions", "max_requests"],
      "properties": {
        "max_actions": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_requests": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_run_id",
        "exact_authorization_id",
        "authorization_token_sha256",
        "record_raw_authorization_token"
      ],
      "properties": {
        "exact_run_id": { "const": true },
        "exact_authorization_id": { "const": true },
        "authorization_token_sha256": { "const": true },
        "record_raw_authorization_token": { "const": false }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership", "cleanup_order", "cleanup_transitions_per_resource", "postcondition_required", "record_raw_resource_id"],
      "properties": {
        "ownership": { "const": "exact-run-bound" },
        "cleanup_order": { "const": "lifo" },
        "cleanup_transitions_per_resource": { "const": 2 },
        "postcondition_required": { "const": true },
        "record_raw_resource_id": { "const": false }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_payloads", "raw_headers", "raw_urls", "payload_digest", "pre_post_digest_comparison"],
      "properties": {
        "raw_payloads": { "const": false },
        "raw_headers": { "const": false },
        "raw_urls": { "const": false },
        "payload_digest": { "const": "sha256" },
        "pre_post_digest_comparison": { "const": true }
      }
    }
  }
}
