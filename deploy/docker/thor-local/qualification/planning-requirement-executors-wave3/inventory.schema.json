{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "policies", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"const": "isolated_candidate_only"},
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advances_live_acceptance", "runtime_evidence_added", "network", "subprocess", "writes"],
      "properties": {
        "advances_live_acceptance": {"const": false},
        "runtime_evidence_added": {"const": false},
        "network": {"const": false},
        "subprocess": {"const": false},
        "writes": {"const": false}
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "planning_requirement_id", "capability_id", "planning_payload_sha256", "capability_sha256", "contract_sha256", "source_locks", "assertions", "runtime_evidence"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^wave3-source-case\\."},
          "planning_requirement_id": {"type": "string"},
          "capability_id": {"type": "string"},
          "planning_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "capability_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_locks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
          "assertions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["assertion_id", "adapter", "sources", "expected"], "properties": {"assertion_id": {"type": "string"}, "adapter": {"enum": ["text_contains_all", "regex_group_equals"]}, "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "expected": {}, "pattern": {"type": "string"}, "group": {"type": "integer", "minimum": 1}}}},
          "runtime_evidence": {"const": []}
        }
      }
    }
  }
}
