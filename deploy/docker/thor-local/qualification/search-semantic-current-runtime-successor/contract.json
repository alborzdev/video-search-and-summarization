  "capability_contract": {
    "attribute": {
      "minimum_clip_seconds": 1,
      "multiple_attributes": "append",
      "same_object_merge": true
    },
    "default_rank_fusion": "rrf",
    "fusion": {
      "multiple_attributes": "fuse",
      "order": [
        "embedding",
        "rerank_or_fallback"
      ],
      "same_video_top_k": 1
    },
    "image": {
      "retrieval": "object_level_knn",
      "selected_bbox": true,
      "seed_excluded": true
    },
    "indices": [
      "mdx-embed-filtered-*",
      "mdx-behavior-*",
      "mdx-raw-*"
    ],
    "routes": [
      "/api/v1/search",
      "/api/v1/search/attribute",
      "/api/v1/search/fusion",
      "/api/v1/search/image"
    ]
  },
  "targets": {
    "search": {
      "host": "127.0.0.1",
      "port": 8100
    },
    "elasticsearch": {
      "host": "127.0.0.1",
      "port": 9200
    },
    "ingress": {
      "host": "127.0.0.1",
      "port": 7777
    },
    "rtvi_cv": {
      "host_source": "deploy/docker/thor-local/generated.env:HOST_IP",
      "port_source": "deploy/docker/thor-local/generated.env:RTVI_CV_PORT",
      "must_be_numeric_and_locally_bindable": true
    }
  },
  "indices": {
