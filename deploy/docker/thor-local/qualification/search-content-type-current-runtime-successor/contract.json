      "vss-rtvi-cv": "nvcr.io/nvidia/vss-core/vss-rt-cv:3.2.1"
    },
    "required_health": "healthy",
    "service_lifecycle_mutations": 0
  },
  "bounds": {
    "max_duration_seconds": 300,
    "max_http_requests": 48,
    "max_persistent_mutations": 6,
    "max_response_bytes": 4194304,
    "network_scope": "loopback-only"
  },
  "cleanup": {
    "allowlist_prefix": "vss-oracle-search-content-type-",
    "delete_endpoint": "/api/v1/videos/{sensor_id}",
    "postconditions": [
      "every exact oracle-owned sensor is absent",
      "every exact oracle-owned embed, behavior, and raw document is absent",
