  "authorization": {
    "acknowledgement": "I_AUTHORIZE_SEARCH_CONTENT_TYPE_RUNTIME_AND_EXACT_CLEANUP",
    "scope": "Two generated tiny file ingests through the loopback Agent compatibility route followed by exact owned-video cleanup"
  },
  "contract": {
    "accepted": [
      "video/mp4",
      "video/x-matroska"
    ],
    "missing_or_unsupported_status": 400,
    "positive_semantics": [
      "VST sensor materialized",
      "at least one embedding chunk processed",
      "at least one exact sensor-id embedding document observed"
    ],
    "negative_semantics": [
      "missing Content-Type rejected before upload",
      "application/octet-stream rejected before upload"
    ]
  },
  "fixture": {
    "generator": "ffmpeg",
    "source": "lavfi testsrc2=size=160x120:rate=10",
    "duration_seconds": 2,
    "video_codec": "h264",
    "profile": "baseline",
    "pixel_format": "yuv420p",
    "b_frames": 0,
    "maximum_bytes_per_file": 1000000,
    "warehouse_sample_bundle": "excluded"
  },
  "targets": {
    "agent": "http://127.0.0.1:8100",
    "vios": "http://127.0.0.1:7777",
    "elasticsearch": "http://127.0.0.1:9200"
  },
  "runtime": {
    "containers": [
      "vss-agent",
      "vss-vios-sensor",
      "vss-rtvi-embed",
      "vss-rtvi-cv"
    ],
    "images": {
      "vss-agent": "nvcr.io/nvidia/vss-core/vss-agent:3.2.1",
      "vss-vios-sensor": "nvcr.io/nvidia/vss-core/vss-vios-sensor:3.2.1",
