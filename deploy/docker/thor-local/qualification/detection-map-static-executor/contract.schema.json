{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "entry",
    "policy",
    "plan_binding",
    "source_locks",
    "fixture",
    "output_locks",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "candidate_only_detection_map_static_executor"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "capability_id",
        "oracle_id",
        "manifest_pointer",
        "advertised",
        "advertised_canonical_sha256",
        "advertised_utf8_sha256"
      ],
      "properties": {
        "entry_id": {"const": "manifest-gap.spatial-ai-utils.03-detection-map"},
        "capability_id": {"const": "manifest-entry.spatial-ai-utils.03-detection-map"},
        "oracle_id": {"const": "oracle.manifest-entry.spatial-ai-utils.03"},
        "manifest_pointer": {"const": "/features/29/advertised/3"},
        "advertised": {"const": "detection mAP"},
        "advertised_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "advertised_utf8_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_only",
        "can_mark_passed_current",
        "official_capability_effect",
        "runtime_evidence",
        "network_allowed",
        "docker_allowed",
        "subprocess_allowed",
        "lifecycle_allowed",
        "downloads_allowed",
        "credentials_allowed",
        "warehouse_sample_bundle",
        "writes"
      ],
      "properties": {
        "candidate_only": {"const": true},
        "can_mark_passed_current": {"const": false},
        "official_capability_effect": {"const": "none_candidate_only"},
        "runtime_evidence": {"type": "array", "maxItems": 0},
        "network_allowed": {"const": false},
        "docker_allowed": {"const": false},
        "subprocess_allowed": {"const": false},
        "lifecycle_allowed": {"const": false},
        "downloads_allowed": {"const": false},
        "credentials_allowed": {"const": false},
        "warehouse_sample_bundle": {"const": "excluded"},
        "writes": {"const": "executor_owned_private_temporary_directory_only"}
      }
    },
    "plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "raw_sha256", "entry_canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "entry_canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_locks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "fixture_id", "warehouse_sample_bundle"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "fixture_id": {"const": "synthetic-detection-map-v1"},
        "warehouse_sample_bundle": {"const": false}
      }
    },
    "output_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perfect-single-detection.json", "distance-threshold-miss.json", "tree_sha256"],
      "properties": {
        "perfect-single-detection.json": {"$ref": "#/$defs/sha256"},
        "distance-threshold-miss.json": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_oracle_executed",
        "checked_in_integration_test_evidence_verified",
        "production_evaluator_executed",
        "local_optional_eval_dependencies_verified",
        "service_runtime_proven"
      ],
      "properties": {
        "semantic_oracle_executed": {"const": true},
        "checked_in_integration_test_evidence_verified": {"const": true},
        "production_evaluator_executed": {"const": false},
        "local_optional_eval_dependencies_verified": {"const": false},
        "service_runtime_proven": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
