{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "status", "default_execution_enabled", "warehouse_sample_bundle", "canonical_mapping_mutated", "rows", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "advertised-candidate-bindings-current-semantic-closure-successor"},
    "status": {"const": "current_semantic_candidate_links_verified_non_promoting"},
    "default_execution_enabled": {"const": false},
    "warehouse_sample_bundle": {"const": "excluded"},
    "canonical_mapping_mutated": {"const": false},
    "rows": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/row"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "concrete_implementation_count", "partial_implementation_count", "executor_ready_count", "required_cloud_inference_count", "warehouse_sample_dependency_count", "concrete_full_binding_count", "canonical_binding_change_count", "admitted_count", "executable_count", "runtime_receipt_count", "promotion_count"],
      "properties": {
        "row_count": {"const": 10},
        "concrete_implementation_count": {"const": 4},
        "partial_implementation_count": {"const": 6},
        "executor_ready_count": {"const": 0},
        "required_cloud_inference_count": {"const": 0},
        "warehouse_sample_dependency_count": {"const": 0},
        "concrete_full_binding_count": {"const": 0},
        "canonical_binding_change_count": {"const": 0},
        "admitted_count": {"const": 0},
        "executable_count": {"const": 0},
        "runtime_receipt_count": {"const": 0},
        "promotion_count": {"const": 0}
      }
    }
  },
  "$defs": {
    "canonicalEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted", "binding_kind_changed", "executable", "promoted", "runtime_evidence"],
      "properties": {
        "admitted": {"const": false},
        "binding_kind_changed": {"const": false},
        "executable": {"const": false},
        "promoted": {"const": false},
        "runtime_evidence": {"type": "array", "maxItems": 0}
      }
    },
    "executorReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "path", "role", "authorization_gated", "executor_ready"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^deploy/docker/thor-local/qualification/.+/executor\\.py$"},
        "role": {"type": "string", "minLength": 1},
        "authorization_gated": {"const": true},
        "executor_ready": {"const": false}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "oracle_id", "oracle_index", "candidate_record_canonical_sha256", "advertised_literal", "required_semantics", "adjacent_negative", "required_cloud_inference", "warehouse_sample_bundle", "implementation_state", "relationship_kind", "executor_ready", "executor_references", "coverage_status", "retained_gaps", "canonical_effect"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^manifest-entry\\."},
        "oracle_id": {"type": "string", "pattern": "^oracle\\.manifest-entry\\."},
        "oracle_index": {"type": "integer", "minimum": 289, "maximum": 499},
        "candidate_record_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "advertised_literal": {"type": "string", "minLength": 1},
        "required_semantics": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "adjacent_negative": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_cloud_inference": {"const": false},
        "warehouse_sample_bundle": {"const": false},
        "implementation_state": {"enum": ["concrete", "partial"]},
        "relationship_kind": {"enum": ["concrete_executor_candidate", "partial_executor_candidate"]},
        "executor_ready": {"const": false},
        "executor_references": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/executorReference"}},
        "coverage_status": {"const": "incomplete_no_live_receipt"},
        "retained_gaps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "canonical_effect": {"$ref": "#/$defs/canonicalEffect"}
      }
    }
  }
}
