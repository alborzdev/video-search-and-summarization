{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "agent_origin", "public_report_origins", "fixtures", "first_prompt", "latest_prompt"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "agent_origin": {"type": "string", "pattern": "^http://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\]):[0-9]{1,5}$"},
    "public_report_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10, "maxLength": 512}
    },
    "fixtures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sensor_name", "media_sha256", "duration_seconds", "owner_run_id", "ownership_attested", "vst_registration_attested", "duration_attested"],
        "properties": {
          "sensor_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "media_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 60, "maximum": 3600},
          "owner_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
          "ownership_attested": {"const": true},
          "vst_registration_attested": {"const": true},
          "duration_attested": {"const": true}
        }
      }
    },
    "first_prompt": {"$ref": "#/$defs/prompt"},
    "latest_prompt": {"$ref": "#/$defs/prompt"}
  },
  "$defs": {
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "events", "objects"],
      "properties": {
        "scenario": {"type": "string", "minLength": 8, "maxLength": 256},
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 96}
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 96}
        }
      }
    }
  }
}
