          "services/video-summarization/src/via_server.py",
          "services/video-summarization/tests/test_lvs_mcp.py"
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/sha"}
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
        "type": "object", "additionalProperties": false,
        "required": ["entry_id", "candidate_state", "evidence_scope", "retained_blockers", "matched_assertions"],
        "properties": {
          "entry_id": {"enum": ["manifest-gap.video-summarization-live.05-sse-mcp-server", "manifest-gap.agent-and-mcp-apis.06-lvs-mcp"]},
          "candidate_state": {"const": "candidate_executable_subset_non_advancing"},
          "evidence_scope": {"enum": [
            "subset: production LVS MCP server construction, exact tool registration, and in-process shared tool dispatch; no SSE connection, MCP transport/session/handshake, server lifecycle, deployed LVS, VLM inference, or Thor readiness",
            "subset: production 13-tool registration plus in-process health and bounded file add/list/info/delete semantics with rejection, rollback, and sanitized-error checks; no MCP transport/session/handshake, live service, model, summarization, or Thor readiness"
          ]},
          "retained_blockers": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "matched_assertions": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {"properties": {"entry_id": {"const": "manifest-gap.video-summarization-live.05-sse-mcp-server"}}, "required": ["entry_id"]},
            "then": {"properties": {"evidence_scope": {"const": "subset: production LVS MCP server construction, exact tool registration, and in-process shared tool dispatch; no SSE connection, MCP transport/session/handshake, server lifecycle, deployed LVS, VLM inference, or Thor readiness"}}}
          },
          {
            "if": {"properties": {"entry_id": {"const": "manifest-gap.agent-and-mcp-apis.06-lvs-mcp"}}, "required": ["entry_id"]},
            "then": {"properties": {"evidence_scope": {"const": "subset: production 13-tool registration plus in-process health and bounded file add/list/info/delete semantics with rejection, rollback, and sanitized-error checks; no MCP transport/session/handshake, live service, model, summarization, or Thor readiness"}}}
          }
        ]
      }
    }
  }
