{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "agent_origin", "lvs_origin", "rtvi_vlm_origin", "vst_origin", "elasticsearch_origin", "allowed_media_origins", "lvs_identity", "fixtures", "live_stream"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "agent_origin": {"$ref": "#/$defs/origin"},
    "lvs_origin": {"$ref": "#/$defs/origin"},
    "rtvi_vlm_origin": {"$ref": "#/$defs/origin"},
    "vst_origin": {"$ref": "#/$defs/origin"},
    "elasticsearch_origin": {"$ref": "#/$defs/origin"},
    "allowed_media_origins": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/origin"}},
    "lvs_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sub_version", "model"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "sub_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "model": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sensor_id", "stored_media_sha256", "stored_media_bytes", "duration_seconds", "owner_run_id", "ownership_attested"],
        "properties": {
          "sensor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "stored_media_sha256": {"$ref": "#/$defs/sha"},
          "stored_media_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 60, "maximum": 86400},
          "owner_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
          "ownership_attested": {"const": true}
        }
      }
    },
    "live_stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_time", "end_time", "prompt", "scenario", "events", "objects_of_interest", "chunk_duration", "owner_run_id", "ownership_attested", "exclusive_range_attested", "exclusive_collection_attested"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "start_time": {"type": "string", "format": "date-time"},
        "end_time": {"type": "string", "format": "date-time"},
        "prompt": {"type": "string", "minLength": 8, "maxLength": 512},
        "scenario": {"type": "string", "minLength": 8, "maxLength": 256},
        "events": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 96}},
        "objects_of_interest": {"type": "array", "minItems": 0, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 96}},
        "chunk_duration": {"type": "integer", "minimum": 1, "maximum": 60},
        "owner_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
        "ownership_attested": {"const": true},
        "exclusive_range_attested": {"const": true},
        "exclusive_collection_attested": {"const": true}
      }
    }
  },
  "$defs": {
    "origin": {"type": "string", "pattern": "^http://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\]):[0-9]{1,5}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
