{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "candidate_only", "inventory_sha256", "denominator", "runtime_evidence", "official_capability_effect", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "candidate_only_vios_codec_audio_executor_tranche_wave5"},
    "candidate_only": {"const": true},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advertised_gap_entries", "previously_selected_candidate_entries", "prior_open_entries", "selected_candidate_entries", "entries_left_open"],
      "properties": {
        "advertised_gap_entries": {"const": 87},
        "previously_selected_candidate_entries": {"const": 57},
        "prior_open_entries": {"const": 30},
        "selected_candidate_entries": {"const": 6},
        "entries_left_open": {"const": 24}
      }
    },
    "runtime_evidence": {"type": "array", "maxItems": 0},
    "official_capability_effect": {"const": "none_candidate_only"},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest_pointer", "entry_id", "proposed_capability_id", "advertised", "evidence_scope", "observation", "input_sha256", "semantic_output_sha256", "semantic_output", "runtime_evidence", "official_capability_effect"],
        "properties": {
          "manifest_pointer": {"type": "string", "pattern": "^/features/20/advertised/[0-5]$"},
          "entry_id": {"type": "string", "pattern": "^manifest-gap\\.vios-codecs-audio\\."},
          "proposed_capability_id": {"type": "string", "pattern": "^manifest-entry\\.vios-codecs-audio\\."},
          "advertised": {"type": "string", "minLength": 1},
          "evidence_scope": {"type": "string", "pattern": "^subset:"},
          "observation": {"const": "observed_match"},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "semantic_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "semantic_output": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contract_scope", "contract_edges", "semantic_assertions", "matched_source_files", "bounded_cpp_parsed", "bounded_config_parsed", "runtime_executed", "codec_fixture_executed", "rtsp_session_executed", "recording_executed", "cpu_pipeline_executed", "service_readiness_proven", "real_file_writes", "detail"],
            "properties": {
              "contract_scope": {"const": "exact-digest-locked-vios-source-and-offline-package-contract-only"},
              "contract_edges": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
              "semantic_assertions": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
              "matched_source_files": {"type": "array", "minItems": 4, "maxItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "bounded_cpp_parsed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\.(?:cpp|h|hh)$"}},
              "bounded_config_parsed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "runtime_executed": {"const": false},
              "codec_fixture_executed": {"const": false},
              "rtsp_session_executed": {"const": false},
              "recording_executed": {"const": false},
              "cpu_pipeline_executed": {"const": false},
              "service_readiness_proven": {"const": false},
              "real_file_writes": {"const": 0},
              "detail": {"type": "object"}
            }
          },
          "runtime_evidence": {"type": "array", "maxItems": 0},
          "official_capability_effect": {"const": "none_candidate_only"}
        }
      }
    }
  }
}
