{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "family", "source_revision", "capability_ids", "source_locks", "config_locks", "nat_lock", "fixture_spec", "policy", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "agent-evaluation-runtime-evidence-successor"},
    "family": {"const": "agent-evaluation"},
    "source_revision": {"pattern": "^[0-9a-f]{40}$"},
    "capability_ids": {
      "const": ["evaluation.agent.report", "evaluation.agent.qa", "evaluation.agent.trajectory", "evaluation.agent.multi-turn", "evaluation.agent.execution-artifacts"]
    },
    "source_locks": {"$ref": "#/$defs/locks"},
    "config_locks": {"$ref": "#/$defs/locks"},
    "nat_lock": {
      "type": "object",
      "required": ["package", "version", "pyproject_path", "pyproject_sha256", "uv_lock_path", "uv_lock_sha256", "image", "image_digest", "cli_path", "command_shape", "registered_vss_evaluators", "report_judge_profile"]
    },
    "fixture_spec": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$"}}
    },
    "policy": {
      "type": "object",
      "required": ["network_allowed", "downloads_allowed", "services_allowed", "models_allowed", "warehouse_sample_bundle", "install_proprietary_codecs", "canonical_metadata_mutation_allowed", "semantic_judge_execution_authorized", "product_nat_eval_execution_authorized"],
      "properties": {
        "network_allowed": {"const": false}, "downloads_allowed": {"const": false}, "services_allowed": {"const": false}, "models_allowed": {"const": false}, "warehouse_sample_bundle": {"const": "excluded"}, "install_proprietary_codecs": {"const": false}, "canonical_metadata_mutation_allowed": {"const": false}, "semantic_judge_execution_authorized": {"const": false}, "product_nat_eval_execution_authorized": {"const": false}
      },
      "additionalProperties": false
    },
    "proof_ceiling": {"const": "nonpromotable_mechanics_only"}
  },
  "$defs": {
    "locks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"pattern": "^[0-9a-f]{64}$"}}
      }
    }
  }
}
