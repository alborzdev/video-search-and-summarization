{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.nvidia.com/vss/thor-local/executor-cases/inventory.schema.json",
  "title": "Thor deterministic file-only executor case inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "planning_source", "cases"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "repo_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "adapter", "sources", "expected"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/id"},
        "adapter": {
          "enum": [
            "text_contains_all",
            "json_pointer_equals",
            "effective_upload_limit_mb",
            "proto_message_fields"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repo_path"}
        },
        "pointer": {"type": "string", "pattern": "^/"},
        "message": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "expected": {}
      },
      "allOf": [
        {
          "if": {"properties": {"adapter": {"const": "json_pointer_equals"}}},
          "then": {"required": ["pointer"]}
        },
        {
          "if": {"properties": {"adapter": {"const": "proto_message_fields"}}},
          "then": {"required": ["message"]}
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_state", "evidence_class", "executor_ready",
        "can_advance_capability", "can_mark_passed_current", "network",
        "docker", "subprocess", "environment_mutation", "warehouse_sample_bundle",
        "max_bytes", "max_files", "deadline_seconds", "allowed_outcomes"
      ],
      "properties": {
        "integration_state": {"const": "isolated_executor_candidate"},
        "evidence_class": {"const": "deterministic_file_static_evidence_not_runtime"},
        "executor_ready": {"const": true},
        "can_advance_capability": {"const": false},
        "can_mark_passed_current": {"const": false},
        "network": {"const": "forbidden"},
        "docker": {"const": "forbidden"},
        "subprocess": {"const": "forbidden"},
        "environment_mutation": {"const": "forbidden"},
        "warehouse_sample_bundle": {"const": "excluded"},
        "max_bytes": {"const": 4194304},
        "max_files": {"const": 16},
        "deadline_seconds": {"const": 5},
        "allowed_outcomes": {"const": ["observed_match", "observed_mismatch"]}
      }
    },
    "planning_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "denominator", "required_source_state",
        "allowed_materialization_states"
      ],
      "properties": {
        "path": {"const": "deploy/docker/thor-local/qualification/acceptance_inventory.json"},
        "denominator": {"const": 110},
        "required_source_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime_evidence"],
          "properties": {
            "runtime_evidence": {"const": []}
          }
        },
        "allowed_materialization_states": {
          "const": ["isolated_candidate", "live_planning_integration"]
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id", "planning_requirement_id", "capability_id",
          "planning_payload_sha256", "materialized", "materialization_scope", "executor_ready",
          "advancement_scope", "runtime_evidence", "assertions"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^executor-case\\."},
          "planning_requirement_id": {"$ref": "#/$defs/id"},
          "capability_id": {"$ref": "#/$defs/id"},
          "planning_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "materialized": {"const": true},
          "materialization_scope": {"const": "isolated_candidate_only"},
          "executor_ready": {"const": true},
          "advancement_scope": {"const": "static_assertion_only"},
          "runtime_evidence": {"const": []},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"$ref": "#/$defs/assertion"}
          }
        }
      }
    }
  }
}
