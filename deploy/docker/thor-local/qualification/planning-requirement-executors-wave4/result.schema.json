{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "advances_live_acceptance", "runtime_evidence_added", "inventory_sha256", "baseline_checks", "counts", "remaining_requirement_audit", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"const": "isolated_candidate_only"},
    "advances_live_acceptance": {"const": false},
    "runtime_evidence_added": {"const": false},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256_match"],
        "properties": {"path": {"type": "string"}, "sha256_match": {"const": true}}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_planning_requirements", "integrated_materialized", "live_open", "cases", "observed_match", "observed_mismatch", "remaining_requirements_audited", "remaining_requirements_unselected"],
      "properties": {
        "total_planning_requirements": {"const": 110},
        "integrated_materialized": {"const": 27},
        "live_open": {"const": 83},
        "cases": {"const": 6},
        "observed_match": {"const": 5},
        "observed_mismatch": {"const": 1},
        "remaining_requirements_audited": {"const": 77},
        "remaining_requirements_unselected": {"const": 71}
      }
    },
    "remaining_requirement_audit": {
      "type": "array",
      "minItems": 77,
      "maxItems": 77,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["planning_requirement_id", "owner_id", "package", "planning_payload_sha256", "capability_sha256", "contract_sha256", "classification"],
        "properties": {
          "planning_requirement_id": {"type": "string"},
          "owner_id": {"type": "string"},
          "package": {"enum": ["agent-smartcity", "systems", "calibration-warehouse"]},
          "planning_payload_sha256": {"$ref": "#/$defs/sha256"},
          "capability_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "contract_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "classification": {"enum": ["selected_source_executor", "existing_static_or_external_boundary_lane_not_new", "requires_custom_media_and_runtime_qualification", "requires_unmaterialized_fixture_or_independent_source_evidence", "requires_runtime_or_complete_independent_source_semantics"]}
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "planning_requirement_id", "capability_id", "outcome", "binding_checks", "source_checks", "assertions", "runtime_evidence"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^wave4-source-case\\."},
          "planning_requirement_id": {"type": "string"},
          "capability_id": {"type": "string"},
          "outcome": {"enum": ["observed_match", "observed_mismatch"]},
          "binding_checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_payload_sha256", "capability_sha256", "contract_sha256", "owner_binding", "requirement_still_open"],
            "properties": {
              "requirement_payload_sha256": {"const": true},
              "capability_sha256": {"const": true},
              "contract_sha256": {"const": true},
              "owner_binding": {"const": true},
              "requirement_still_open": {"const": true}
            }
          },
          "source_checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256_match"],
              "properties": {"path": {"type": "string"}, "sha256_match": {"const": true}}
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["assertion_id", "passed", "detail"],
              "properties": {"assertion_id": {"type": "string"}, "passed": {"type": "boolean"}, "detail": {"type": "string"}}
            }
          },
          "runtime_evidence": {"const": []}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
