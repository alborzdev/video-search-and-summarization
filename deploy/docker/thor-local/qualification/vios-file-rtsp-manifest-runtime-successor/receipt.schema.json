    "official_indices": {"const": [413]},
    "status": {"const": "passed"},
    "contract_sha256": {"$ref": "#/$defs/hash"},
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_receipt_sha256", "official_wrapper_sha256", "fixture_contract_sha256"],
      "properties": {
        "raw_receipt_sha256": {"const": "2ab858671747ea315634d846e12c4c8d87abd690a52a8381a0a614fdbe2ef8a1"},
        "official_wrapper_sha256": {"const": "a4daa8ba496146cfb09feba89131c103efa7211734cc60cd655a29ae812ac7b2"},
        "fixture_contract_sha256": {"const": "f7706aeb2a76e06945a080d258057ce25d23435f2cd1412f35975e515baafe00"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["product_version", "service_version", "captured_at", "image_id", "image_architecture"],
      "properties": {
        "product_version": {"const": "3.2.1"}, "service_version": {"const": "2.1.0-26.05.4"},
        "captured_at": {"type": "string", "minLength": 20},
        "image_id": {"const": "sha256:b3e5b92fa2546e9b69a3dba7cac324ce36a3cce65f2e0d61ad41a8a84a74a563"},
        "image_architecture": {"const": "arm64"}
