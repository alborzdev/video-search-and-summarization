      "required": ["input_modes", "automatic_output", "source_codec", "source_width", "source_height", "rtsp_video_codec", "rtsp_audio_codec", "rtsp_audio_sample_rate_hz", "live_snapshot_decoded", "webrtc_first_frame_observed", "webrtc_clock_advanced", "invalid_media_status"],
      "properties": {
        "input_modes": {"const": ["upload", "ui", "local-mount"]},
        "automatic_output": {"const": "RTSP"}, "source_codec": {"const": "h264"},
        "source_width": {"const": 320}, "source_height": {"const": 180},
        "rtsp_video_codec": {"const": "h264"}, "rtsp_audio_codec": {"const": "aac"},
