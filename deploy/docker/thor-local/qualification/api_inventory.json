{
  "schema_version": 1,
  "target": "VSS 3.2.1 Thor-local static API contract",
  "scope": {
    "classification": "core-agent-media-analytics-vios",
    "complete_product_api": false,
    "excluded_official_surfaces": [
      "auto-calibration",
      "deepstream-configurator",
      "legacy-calibration",
      "sdrc-controller-router-workload-coordinator",
      "vss-configurator-sensor-management"
    ],
    "reason": "The exact operation totals below cover the 17 enumerated core REST/MCP surfaces only. The excluded official configuration and calibration surfaces remain open in official-capabilities.json."
  },
  "routing_source": "deploy/docker/services/infra/haproxy/haproxy.cfg.template",
  "safety": {
    "default_mode": "offline-read-only",
    "network_access": false,
    "container_lifecycle": false,
    "runtime_mutations": false,
    "secret_inputs": []
  },
  "expected_totals": {
    "declared_rest_operations": 330,
    "normalized_unique_rest_operations": 329,
    "mcp_tools": 42,
    "mcp_prompts": 5
  },
  "known_contract_differences": {
    "lvs_openapi": {
      "document": "services/video-summarization/api_spec/openapi.json",
      "document_missing": [
        [
          "DELETE",
          "/files/{file_id}"
        ],
        [
          "GET",
          "/files"
        ],
        [
          "GET",
          "/files/{file_id}"
        ],
        [
          "POST",
          "/files"
        ],
        [
          "POST",
          "/generate_vlm_captions"
        ],
        [
          "POST",
          "/v1/chat/completions"
        ]
      ],
      "reason": "The current LVS source exposes graph-QA chat plus Thor-enabled development file/caption routes, while the checked-in generated OpenAPI has not yet been refreshed."
    },
    "rt_vlm_exact_request_abort": {
      "documented_operation_count": 27,
      "thor_local_operation_count": 28,
      "thor_local_extension": [
        "DELETE",
        "/v1/generate_captions/requests/{request_id}"
      ],
      "reason": "The pinned RT-VLM documentation enumerates 27 operations. Thor-local adds one exact request-id cancellation adapter while preserving the documented operation denominator in the capability identity."
    },
    "vios_storage_route_collision": {
      "reason": "Swagger declares GET /v1/storage/file/{streamId} and GET /v1/storage/file/{sensorId}; these are one normalized runtime route."
    }
  },
