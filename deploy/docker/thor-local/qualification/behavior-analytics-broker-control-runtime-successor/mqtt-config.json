{
  "mqtt": {
    "host": "localhost",
    "port": 1883,
    "clientId": "vss-oracle-ba-mqtt",
    "keepAliveSec": 30,
    "consumer": {
      "qos": 1,
      "maxPollCount": 3,
      "pollTimeoutSec": 0.01,
      "retryMaxAttempts": 3,
      "retryIntervalSec": 1
    },
    "producer": {"qos": 1, "retain": false},
    "topics": [
      {"name": "raw", "value": "vss/oracle/ba/mqtt/raw"},
      {"name": "behavior", "value": "vss/oracle/ba/mqtt/behavior"},
      {"name": "frames", "value": "vss/oracle/ba/mqtt/frames"},
      {"name": "notification", "value": "vss/oracle/ba/mqtt/notification"},
      {"name": "events", "value": "vss/oracle/ba/mqtt/events"},
      {"name": "incidents", "value": "vss/oracle/ba/mqtt/incidents"}
    ]
  },
  "sensors": [{"id": "default", "configs": []}],
  "app": [
    {"name": "behaviorWatermarkSec", "value": "1"},
    {"name": "behaviorStateTimeout", "value": "1"},
    {"name": "behaviorMaxPoints", "value": "200"},
    {"name": "coordinateSystem", "value": "euclidean"},
    {"name": "sourceType", "value": "mqtt"},
    {"name": "sinkType", "value": "mqtt"},
    {"name": "numWorkersForBehaviorCreation", "value": "1"},
    {"name": "numWorkersForFrameEnhancement", "value": "1"},
    {"name": "stateManagementFilter", "value": "[\"Person\",\"Forklift\"]"}
  ]
}
