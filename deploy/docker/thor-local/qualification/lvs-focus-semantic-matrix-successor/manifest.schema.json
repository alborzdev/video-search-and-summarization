{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "lvs_origin", "model", "fixture", "semantic_fixture"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "lvs_origin": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 1024},
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "ownership_attested", "semantic_content_attested"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 8196},
        "sha256": {"$ref": "#/$defs/sha"},
        "ownership_attested": {"const": true},
        "semantic_content_attested": {"const": true}
      }
    },
    "semantic_fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["neutral_scenario", "target_object", "target_event", "target_scenario", "target_relationship", "distractor_object", "distractor_event", "absent_object", "absent_event"],
      "properties": {
        "neutral_scenario": {"$ref": "#/$defs/term"},
        "target_object": {"$ref": "#/$defs/term"},
        "target_event": {"$ref": "#/$defs/term"},
        "target_scenario": {"$ref": "#/$defs/term"},
        "target_relationship": {"$ref": "#/$defs/term"},
        "distractor_object": {"$ref": "#/$defs/term"},
        "distractor_event": {"$ref": "#/$defs/term"},
        "absent_object": {"$ref": "#/$defs/term"},
        "absent_event": {"$ref": "#/$defs/term"}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "term": {"type": "string", "minLength": 3, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*[A-Za-z0-9]$"}
  }
}
