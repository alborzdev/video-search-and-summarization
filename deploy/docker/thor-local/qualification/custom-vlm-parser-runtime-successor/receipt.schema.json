{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "package_id",
    "capability_ids",
    "contract_sha256",
    "run",
    "runtime",
    "parser",
    "api",
    "output",
    "negative",
    "fixture",
    "cleanup"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "package_id": {"const": "custom-vlm-parser-runtime-successor"},
    "capability_ids": {
      "const": ["manifest-entry.alert-verification.05-custom-vlm-parsing"]
    },
    "contract_sha256": {"$ref": "#/$defs/sha"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "run_id_sha256", "completed_at", "duration_ms",
        "numeric_local_endpoints_only", "agent_generate_request_count",
        "warehouse_sample_bundle"
      ],
      "properties": {
        "status": {"const": "passed"},
        "run_id_sha256": {"$ref": "#/$defs/sha"},
        "completed_at": {"type": "string", "minLength": 20},
        "duration_ms": {"type": "integer", "minimum": 1, "maximum": 180000},
        "numeric_local_endpoints_only": {"const": true},
        "agent_generate_request_count": {"const": 0},
        "warehouse_sample_bundle": {"const": "excluded"}
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "free_bytes_before", "free_bytes_after", "source_lock_count",
        "live_source_lock_count", "containers", "model",
        "isolated_alert_image_id"
      ]
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotted_path", "parser_id", "module_sha256",
        "config_projection_sha256", "worker_loader_observed",
        "api_loader_observed", "identity_exposed", "config_exposed",
        "shared_instance_contract"
      ],
      "properties": {
        "dotted_path": {"const": "thor_custom_parser.ThorStructuredAlertParser"},
        "parser_id": {"const": "thor-structured-alert-parser-v1"},
        "module_sha256": {"$ref": "#/$defs/sha"},
        "config_projection_sha256": {"$ref": "#/$defs/sha"},
        "worker_loader_observed": {"const": true},
        "api_loader_observed": {"const": true},
        "identity_exposed": {"const": true},
        "config_exposed": {"const": true},
        "shared_instance_contract": {"const": true}
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health_http_status", "config_create_http_status",
        "config_readback_exact", "submission_http_status",
        "server_generated_job_id", "poll_states", "terminal_state",
        "processing_outcome", "verification_response_code",
        "sink_transport", "sink_outcome", "event_id_sha256",
        "persisted_source_sha256"
      ],
      "properties": {
        "health_http_status": {"const": 200},
        "config_create_http_status": {"const": 201},
        "config_readback_exact": {"const": true},
        "submission_http_status": {"const": 202},
        "server_generated_job_id": {"const": true},
        "poll_states": {
          "type": "array", "minItems": 1, "maxItems": 90,
          "items": {"enum": ["queued", "running", "publishing", "completed"]}
        },
        "terminal_state": {"const": "completed"},
        "processing_outcome": {"const": "verified"},
        "verification_response_code": {"const": 200},
        "sink_transport": {"const": "elastic"},
        "sink_outcome": {"const": "acknowledged"},
        "event_id_sha256": {"$ref": "#/$defs/sha"},
        "persisted_source_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parser_id", "normalized_verdict", "normalized_reasoning_present",
        "raw_response_sha256_present", "outer_verdict_empty",
        "vlm_response_json_present", "default_reasoning_field_absent",
        "verification_response_status", "service_response_schema_conformant",
        "mapped_category_sha256"
      ],
      "properties": {
        "parser_id": {"const": "thor-structured-alert-parser-v1"},
        "normalized_verdict": {"const": "confirmed"},
        "normalized_reasoning_present": {"const": true},
        "raw_response_sha256_present": {"const": true},
        "outer_verdict_empty": {"const": true},
        "vlm_response_json_present": {"const": true},
        "default_reasoning_field_absent": {"const": true},
        "verification_response_status": {"const": "OK"},
        "service_response_schema_conformant": {"const": true},
        "mapped_category_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "negative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotted_path_sha256", "startup_rejected", "health_never_reachable",
        "import_failure_observed"
      ],
      "properties": {
        "dotted_path_sha256": {"$ref": "#/$defs/sha"},
        "startup_rejected": {"const": true},
        "health_never_reachable": {"const": true},
        "import_failure_observed": {"const": true}
      }
    },
    "fixture": {
      "type": "object",
      "required": ["sha256", "bytes", "media_url_sha256", "http_get_count"]
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_sha256", "after_sha256", "exact_main_runtime_restored",
        "positive_container_removed", "negative_container_removed",
        "owned_indices_deleted", "owned_indices_absent",
        "owned_rtvlm_documents_deleted", "owned_rtvlm_documents_absent",
        "fixture_server_stopped", "running_container_set_preserved"
      ],
      "properties": {
        "before_sha256": {"$ref": "#/$defs/sha"},
        "after_sha256": {"$ref": "#/$defs/sha"},
        "exact_main_runtime_restored": {"const": true},
        "positive_container_removed": {"const": true},
        "negative_container_removed": {"const": true},
        "owned_indices_deleted": {"type": "integer", "minimum": 1},
        "owned_indices_absent": {"const": true},
        "owned_rtvlm_documents_deleted": {"type": "integer", "minimum": 1},
        "owned_rtvlm_documents_absent": {"const": true},
        "fixture_server_stopped": {"const": true},
        "running_container_set_preserved": {"const": true}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
