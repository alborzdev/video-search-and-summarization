{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.nvidia.com/vss/thor-local/official-capabilities.schema.json",
  "title": "Thor VSS official capability contract",
  "type": "object",
  "required": ["schema_version", "target", "sources", "capabilities", "source_discrepancies"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {
      "type": "object",
      "required": ["product_version", "ga_commit", "main_commit", "captured_on"],
      "additionalProperties": false,
      "properties": {
        "product_version": {"const": "3.2.1"},
        "ga_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "main_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "captured_on": {"type": "string", "format": "date"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "uri", "version", "locator_policy", "claim_set_sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "kind": {"enum": ["versioned_official_docs", "release_notes", "tagged_repository", "main_repository"]},
          "uri": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "locator_policy": {"type": "string", "minLength": 1},
          "claim_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "feature_id", "kind", "title", "source_claims", "acceptance_class", "thor_state", "runtime_state", "contract", "scenario_ids", "gap"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": ["runtime_state"],
              "properties": {"runtime_state": {"const": "passed_current"}}
            },
            "then": {"required": ["runtime_evidence"]}
          },
          {
            "if": {
              "required": ["id"],
              "properties": {
                "id": {"const": "manifest-entry.vios-codecs-audio.05-cpu-multimedia-support"}
              }
            },
            "then": {
              "not": {"required": ["runtime_evidence"]},
              "properties": {
                "feature_id": {"const": "vios-codecs-audio"},
                "kind": {"const": "runtime_behavior"},
                "title": {"const": "CPU multimedia support"},
                "acceptance_class": {"const": "required_local"},
                "thor_state": {"const": "wired"},
                "runtime_state": {"const": "not_qualified"},
                "scenario_ids": {"const": ["analytics-vios-workflows"]},
                "contract": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["selectors", "branch_selection", "software_elements", "hardware_default_elements", "offline_bundle", "immutable_derivatives", "source_controls"],
                  "properties": {
                    "selectors": {
                      "const": {
                        "use_software_path": {
                          "json_pointer": "/data/use_software_path",
                          "checked_in_value": false,
                          "default": false
                        },
                        "USE_SOFTWARE_PATH": {
                          "environment_override_for": "/data/use_software_path",
                          "accepted_values": ["true", "false"]
                        },
                        "use_software_encoder": {
                          "json_pointer": "/data/use_software_encoder",
                          "checked_in_key_present": false,
                          "default": false
                        }
                      }
                    },
                    "branch_selection": {
                      "const": {
                        "decoder_gate": "m_useNvV4l2Dec",
                        "encoder_gate": "m_useNvV4l2Enc",
                        "use_software_path_directly_selects_elements": false,
                        "use_software_path_true": {
                          "m_useNvV4l2Dec": false,
                          "m_useNvV4l2Enc": false
                        },
                        "use_software_encoder_true": {
                          "m_useNvV4l2Dec": "hardware_availability",
                          "m_useNvV4l2Enc": false
                        }
                      }
                    },
                    "software_elements": {
                      "const": {
                        "video_decoders": {"h264": "avdec_h264", "h265": "avdec_h265"},
                        "video_encoders": {"h264": "x264enc", "h265": "x265enc"},
                        "audio_encoder": "avenc_aac",
                        "parsers": ["h264parse", "h265parse"]
                      }
                    },
                    "hardware_default_elements": {
                      "const": {
                        "video_decoder": "nvv4l2decoder",
                        "video_encoders": {
                          "h264": "nvv4l2h264enc",
                          "h265": "nvv4l2h265enc"
                        }
                      }
                    },
                    "offline_bundle": {
                      "const": {
                        "lock_path": "deploy/docker/thor-local/audio/codec-bundle.lock.json",
                        "architecture": "arm64",
                        "package_count": 59,
                        "package_set_sha256": "c34db3c88287c8c049190bafdc0096d91f70bdf14a3b0ffdcc30c01fbc11f44f"
                      }
                    },
                    "immutable_derivatives": {
                      "const": {
                        "runtime_network_install": "disabled",
                        "entrypoint": "/usr/local/bin/vios-offline-entrypoint",
                        "dockerfiles": [
                          "deploy/docker/thor-local/Dockerfile.vios-streamprocessing",
                          "deploy/docker/thor-local/Dockerfile.vios-nvstreamer"
                        ]
                      }
                    },
                    "source_controls": {
                      "type": "array",
                      "minItems": 9,
                      "maxItems": 9,
                      "uniqueItems": true,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["path", "sha256"],
                        "properties": {
                          "path": {"type": "string", "minLength": 1},
                          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "feature_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "kind": {"enum": ["api", "calibration", "configuration", "deployment", "evaluation", "model", "model_customization", "performance", "protocol", "runtime_behavior", "security", "tooling"]},
          "title": {"type": "string", "minLength": 1},
          "source_claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "locator"],
              "additionalProperties": false,
              "properties": {
                "source_id": {"type": "string"},
                "locator": {"type": "string", "minLength": 1}
              }
            }
          },
          "acceptance_class": {"enum": ["required_local", "alternate_local_lane", "external_optional"]},
          "thor_state": {"enum": ["wired", "partial", "source_only", "external_optional", "blocked_upstream"]},
          "runtime_state": {"enum": ["passed_current", "passed_prior", "static_only", "not_qualified", "blocked", "not_applicable"]},
          "contract": {"type": "object", "minProperties": 1},
          "scenario_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "runtime_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["path", "sha256"],
                  "additionalProperties": false,
                  "properties": {
                    "path": {"type": "string", "pattern": "^deploy/docker/thor-local/"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                },
                {
                  "type": "object",
                  "required": ["path", "sha256", "capability_id", "json_pointer"],
                  "additionalProperties": false,
                  "properties": {
                    "path": {"type": "string", "pattern": "^deploy/docker/thor-local/"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "capability_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
                    "json_pointer": {"type": "string", "pattern": "^/capability_results/(0|[1-9][0-9]*)$"}
                  }
                }
              ]
            }
          },
          "gap": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_ids", "observations", "resolution", "must_not_claim"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "locator", "claim"],
              "additionalProperties": false,
              "properties": {
                "source_id": {"type": "string"},
                "locator": {"type": "string", "minLength": 1},
                "claim": {"type": "string", "minLength": 1}
              }
            }
          },
          "category": {
            "enum": [
              "boundary",
              "discrepancy",
              "scoped_default",
              "known_limitation"
            ]
          },
          "record_semantics": {
            "enum": ["single_source_record", "cross_source_discrepancy"]
          },
          "candidate_observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolution": {"type": "string", "minLength": 1},
          "must_not_claim": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "record_semantics": {"const": "single_source_record"}
              },
              "required": ["record_semantics"]
            },
            "then": {
              "required": ["category"],
              "properties": {
                "source_ids": {"maxItems": 1},
                "observations": {"minItems": 1, "maxItems": 1}
              }
            },
            "else": {
              "properties": {
                "observations": {"minItems": 2}
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
