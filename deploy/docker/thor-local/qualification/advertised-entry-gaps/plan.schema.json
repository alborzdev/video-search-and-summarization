{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.nvidia.com/vss/thor-local/advertised-entry-gaps/plan.schema.json",
  "title": "Advertised manifest entry gap plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "source_locks", "policy", "summary", "families", "entries", "plan_payload_sha256"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "pointer": {"type": "string", "pattern": "^/features/[0-9]+(?:/advertised/[0-9]+)?$"},
    "source_lock": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "raw_sha256", "canonical_sha256"],
      "properties": {
        "path": {"type": "string"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "isolated_advertised_entry_gap_planning"},
    "source_locks": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest", "classification_rules", "official_capabilities"],
      "properties": {
        "manifest": {"$ref": "#/$defs/source_lock"},
        "classification_rules": {"$ref": "#/$defs/source_lock"},
        "official_capabilities": {"$ref": "#/$defs/source_lock"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["planning_only", "family_lane_binding_is_semantic_coverage", "runtime_evidence", "can_mark_passed_current", "warehouse_sample_bundle", "custom_data_warehouse_capability"],
      "properties": {
        "planning_only": {"const": true},
        "family_lane_binding_is_semantic_coverage": {"const": false},
        "runtime_evidence": {"const": []},
        "can_mark_passed_current": {"const": false},
        "warehouse_sample_bundle": {"const": "excluded"},
        "custom_data_warehouse_capability": {"const": "in_scope"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_family_count", "families_with_uncovered_advertised_entries", "families_without_official_capability_ids", "families_with_partial_official_capability_ids", "advertised_entries_in_scoped_empty_or_partial_families", "advertised_entries_without_entry_specific_capability_mapping", "family_only_entries_outside_this_plan", "open_unverified_entries", "runtime_evidence_count", "acceptance_class_counts", "oracle_type_counts"],
      "properties": {
        "manifest_family_count": {"const": 55},
        "families_with_uncovered_advertised_entries": {"const": 14},
        "families_without_official_capability_ids": {"const": 13},
        "families_with_partial_official_capability_ids": {"const": 1},
        "advertised_entries_in_scoped_empty_or_partial_families": {"const": 74},
        "advertised_entries_without_entry_specific_capability_mapping": {"const": 487},
        "family_only_entries_outside_this_plan": {"const": 413},
        "open_unverified_entries": {"const": 74},
        "runtime_evidence_count": {"const": 0},
        "acceptance_class_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "oracle_type_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "families": {
      "type": "array", "minItems": 14, "maxItems": 14,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family_id", "manifest_pointer", "family_index", "family_canonical_sha256", "advertised_entry_count", "uncovered_advertised_entry_count", "covered_advertised_entry_count", "official_capability_ids", "official_capability_ids_state", "family_lane_binding_is_semantic_coverage", "family_runtime_state_snapshot", "family_thor_state_snapshot", "entry_ids"],
        "properties": {
          "family_id": {"$ref": "#/$defs/id"},
          "manifest_pointer": {"$ref": "#/$defs/pointer"},
          "family_index": {"type": "integer", "minimum": 0},
          "family_canonical_sha256": {"$ref": "#/$defs/sha256"},
          "advertised_entry_count": {"type": "integer", "minimum": 1},
          "uncovered_advertised_entry_count": {"type": "integer", "minimum": 1},
          "covered_advertised_entry_count": {"type": "integer", "minimum": 0},
          "official_capability_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "official_capability_ids_state": {"enum": ["absent", "partial"]},
          "family_lane_binding_is_semantic_coverage": {"const": false},
          "family_runtime_state_snapshot": {"type": "string"},
          "family_thor_state_snapshot": {"type": "string"},
          "entry_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "entries": {
      "type": "array", "minItems": 74, "maxItems": 74,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entry_id", "manifest_pointer", "family_pointer", "family_index", "advertised_index", "family_id", "advertised", "advertised_utf8_sha256", "advertised_canonical_sha256", "family_canonical_sha256", "family_acceptance_class", "family_category", "family_runtime_state_snapshot", "family_thor_state_snapshot", "official_capability_ids_state", "family_lane_binding_is_semantic_coverage", "coverage_state", "proposed_capability", "required_oracle", "warehouse_scope", "runtime_evidence"],
        "properties": {
          "entry_id": {"$ref": "#/$defs/id"},
          "manifest_pointer": {"$ref": "#/$defs/pointer"},
          "family_pointer": {"$ref": "#/$defs/pointer"},
          "family_index": {"type": "integer", "minimum": 0},
          "advertised_index": {"type": "integer", "minimum": 0},
          "family_id": {"$ref": "#/$defs/id"},
          "advertised": {"type": "string", "minLength": 1},
          "advertised_utf8_sha256": {"$ref": "#/$defs/sha256"},
          "advertised_canonical_sha256": {"$ref": "#/$defs/sha256"},
          "family_canonical_sha256": {"$ref": "#/$defs/sha256"},
          "family_acceptance_class": {"enum": ["required_local", "alternate_local_lane", "external_optional"]},
          "family_category": {"type": "string"},
          "family_runtime_state_snapshot": {"type": "string"},
          "family_thor_state_snapshot": {"type": "string"},
          "official_capability_ids_state": {"enum": ["absent", "partial"]},
          "family_lane_binding_is_semantic_coverage": {"const": false},
          "coverage_state": {"const": "open_missing_entry_capability_and_oracle"},
          "proposed_capability": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "acceptance_class", "literal_scope"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "kind": {"type": "string"},
              "acceptance_class": {"enum": ["required_local", "alternate_local_lane", "external_optional"]},
              "literal_scope": {"type": "string", "minLength": 1}
            }
          },
          "required_oracle": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "type", "executor_class", "status", "setup_requirements", "required_evidence", "literal_success_condition", "cleanup_policy", "runtime_evidence"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "type": {"type": "string"},
              "executor_class": {"type": "string"},
              "status": {"const": "open_unexecuted"},
              "setup_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "required_evidence": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
              "literal_success_condition": {"type": "string", "minLength": 1},
              "cleanup_policy": {"type": "string"},
              "runtime_evidence": {"const": []}
            }
          },
          "warehouse_scope": {
            "type": "object", "additionalProperties": false,
            "required": ["sample_bundle_required", "custom_data_capability_in_scope"],
            "properties": {
              "sample_bundle_required": {"const": false},
              "custom_data_capability_in_scope": {"type": "boolean"}
            }
          },
          "runtime_evidence": {"const": []}
        }
      }
    },
    "plan_payload_sha256": {"$ref": "#/$defs/sha256"}
  }
}
