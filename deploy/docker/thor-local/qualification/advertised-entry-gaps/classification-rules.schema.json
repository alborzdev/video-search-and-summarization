{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.nvidia.com/vss/thor-local/advertised-entry-gaps/classification-rules.schema.json",
  "title": "Advertised entry gap classification rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "family_rules"],
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_kind", "oracle_type", "executor_class", "required_evidence", "setup_requirements", "cleanup_policy"],
      "properties": {
        "capability_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "oracle_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "executor_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "required_evidence": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "setup_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "cleanup_policy": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "custom_data_required": {"const": true},
        "entry_overrides": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/rule_override"}
        }
      }
    },
    "rule_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_kind", "oracle_type", "executor_class", "required_evidence", "setup_requirements", "cleanup_policy"],
      "properties": {
        "capability_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "oracle_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "executor_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "required_evidence": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "setup_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "cleanup_policy": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planning_only", "family_lane_binding_is_semantic_coverage", "runtime_evidence", "warehouse_sample_bundle", "custom_data_warehouse_capability", "required_family_count", "required_entry_count"],
      "properties": {
        "planning_only": {"const": true},
        "family_lane_binding_is_semantic_coverage": {"const": false},
        "runtime_evidence": {"const": []},
        "warehouse_sample_bundle": {"const": "excluded"},
        "custom_data_warehouse_capability": {"const": "in_scope"},
        "required_family_count": {"const": 14},
        "required_entry_count": {"const": 74}
      }
    },
    "family_rules": {
      "type": "object",
      "minProperties": 14,
      "maxProperties": 14,
      "additionalProperties": {"$ref": "#/$defs/rule"}
    }
  }
}
