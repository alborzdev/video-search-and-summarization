{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_id", "capability_ids", "official_indices", "status",
    "contract_sha256", "duration_seconds", "budget", "runtime_identity", "model",
    "text_embedding", "image_embedding", "video_embedding", "multimodal_space",
    "cleanup", "policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "rt-embed-multimodal-runtime-successor"},
    "capability_ids": {
      "const": [
        "manifest-entry.rt-embed.00-video-image-text-embedding",
        "manifest-entry.rt-embed.03-cosmos-embed1"
      ]
    },
    "official_indices": {"const": [368, 371]},
    "status": {"const": "passed"},
    "contract_sha256": {"$ref": "#/$defs/hash"},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 360},
    "budget": {
      "const": {
        "docker_commands": 3,
        "file_mutations": 4,
        "http_requests": 16,
        "max_docker_commands": 3,
        "max_file_mutations": 4,
        "max_http_requests": 16,
        "max_model_requests": 3,
        "model_requests": 3
      }
    },
    "runtime_identity": {
      "const": {
        "credentials_blank": true,
        "healthy": true,
        "image_exact": true,
        "loopback_binding_exact": true,
        "oom_killed": false,
        "operator_paused_workloads_preserved": true,
        "production_sources_exact": true,
        "restart_count": 0,
        "safe_model_environment_exact": true
      }
    },
    "model": {
      "const": {
        "audio_support": false,
        "cosmos_embed1_source_exact": true,
        "embedding_dimension": 768,
        "manifest_model_exact": true,
        "models_endpoint_exact": true,
        "release_exact": true
      }
    },
    "text_embedding": {
      "const": {
        "http_status": 200,
        "input_count": 1,
        "input_echo_exact": true,
        "model_exact": true,
        "query_id_valid": true,
        "response_count": 1,
        "vector_dimension": 768,
        "vector_finite": true,
        "vector_nonzero": true
      }
    },
    "image_embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upload", "inference"],
      "properties": {
        "upload": {"$ref": "#/$defs/upload"},
        "inference": {
          "allOf": [
            {"$ref": "#/$defs/media_inference"},
            {"properties": {"chunk_count": {"const": 1}}}
          ]
        }
      }
    },
    "video_embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upload", "inference", "fixture_codec_h264", "fixture_duration_seconds",
        "chunk_duration_seconds"
      ],
      "properties": {
        "upload": {"$ref": "#/$defs/upload"},
        "inference": {
          "allOf": [
            {"$ref": "#/$defs/media_inference"},
            {"properties": {"chunk_count": {"const": 2}}}
          ]
        },
        "fixture_codec_h264": {"const": true},
        "fixture_duration_seconds": {"const": 10},
        "chunk_duration_seconds": {"const": 5}
      }
    },
    "multimodal_space": {
      "const": {
        "cross_modal_cosines_finite": true,
        "modal_vectors_distinct": true,
        "same_embedding_dimension": true
      }
    },
    "cleanup": {
      "const": {
        "asset_statistics_restored_exactly": true,
        "file_catalog_restored_exactly": true,
        "model_catalog_preserved": true,
        "owned_image_deleted": true,
        "owned_video_deleted": true,
        "runtime_identity_preserved": true
      }
    },
    "policy": {
      "const": {
        "agent_generate_calls": 0,
        "credentials_retained": false,
        "external_network_requests": 0,
        "network_scope": "numeric-loopback-http-only",
        "raw_embeddings_retained": false,
        "raw_resource_ids_retained": false,
        "raw_text_input_retained": false,
        "rt_cv_or_vios_stream_mutations": 0,
        "service_lifecycle_actions": 0,
        "warehouse_sample_bundle": "excluded"
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "upload": {
      "const": {
        "bytes_exact": true,
        "http_status": 200,
        "media_type_exact": true,
        "purpose_exact": true,
        "stable_file_identity_returned": true
      }
    },
    "media_inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_count", "chunks_chronological", "http_status", "media_info_offset",
        "model_exact", "query_id_valid", "vectors_dimension", "vectors_finite",
        "vectors_nonzero"
      ],
      "properties": {
        "chunk_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "chunks_chronological": {"const": true},
        "http_status": {"const": 200},
        "media_info_offset": {"const": true},
        "model_exact": {"const": true},
        "query_id_valid": {"const": true},
        "vectors_dimension": {"const": 768},
        "vectors_finite": {"const": true},
        "vectors_nonzero": {"const": true}
      }
    }
  }
}
