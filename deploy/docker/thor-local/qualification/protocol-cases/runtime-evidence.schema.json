{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.example/vss/thor/protocol-case-runtime-evidence.schema.json",
  "title": "VSS protocol-case bounded runtime evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "capability_id", "target_commit",
    "contract_path", "contract_file_sha256", "contract_set_sha256", "case_sha256",
    "source_bindings", "vector_id", "vector_sha256", "execution_request_sha256",
    "run_id", "evidence_class", "can_advance_capability",
    "started_at", "finished_at", "result", "admission", "bounds",
    "cleanup_request_reserve", "cleanup_deadline_seconds", "cleanup_byte_reserve",
    "targets", "pre_state", "observations", "cleanup"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string"},
    "capability_id": {"type": "string"},
    "target_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_path": {"type": "string"},
    "contract_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_bindings": {"type": "array", "minItems": 1},
    "vector_id": {"type": "string"},
    "vector_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^vss-protocol-case-"},
    "evidence_class": {"enum": ["product_protocol", "transport_fixture_only"]},
    "can_advance_capability": {"type": "boolean"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "result": {"enum": ["passed", "failed", "blocked"]},
    "admission": {"type": "array", "minItems": 1},
    "bounds": {"type": "object"},
    "cleanup_request_reserve": {"type": "integer", "minimum": 0, "maximum": 8},
    "cleanup_deadline_seconds": {"const": 10},
    "cleanup_byte_reserve": {"const": 65536},
    "targets": {"type": "array"},
    "pre_state": {"type": "array"},
    "observations": {"type": "array"},
    "cleanup": {"type": "array", "minItems": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_class": {"const": "transport_fixture_only"}}},
      "then": {"properties": {"can_advance_capability": {"const": false}}}
    }
  ]
}
