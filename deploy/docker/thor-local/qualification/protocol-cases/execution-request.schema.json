{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.example/vss/thor/protocol-case-execution-request.schema.json",
  "title": "Explicitly authorized VSS protocol-case execution request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "vector_id", "operator_ack", "run_id",
    "targets", "bounds", "resources", "credentials_env", "evidence_dir"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^protocol-case\\."},
    "vector_id": {"type": "string", "minLength": 1},
    "operator_ack": {"const": "I_ACK_VSS_PROTOCOL_CASE_LIFECYCLE_AND_MUTATIONS"},
    "run_id": {"type": "string", "pattern": "^vss-protocol-case-[a-z0-9-]{1,80}$"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "kind", "host", "port", "tls"],
        "properties": {
          "role": {"enum": ["websocket", "http", "redis", "kafka"]},
          "kind": {"enum": ["numeric_loopback", "compose_service"]},
          "host": {"type": "string", "minLength": 1},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "tls": {"type": "boolean"},
          "ca_file": {"type": "string", "minLength": 1}
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_seconds", "max_events", "max_bytes", "max_requests"],
      "properties": {
        "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "max_events": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "resources": {"type": "object", "maxProperties": 12},
    "credentials_env": {
      "type": "array",
      "maxItems": 4,
      "items": {"type": "string", "pattern": "^VSS_PROTOCOL_CASE_[A-Z0-9_]+$"},
      "uniqueItems": true
    },
    "evidence_dir": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "external_agent_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
