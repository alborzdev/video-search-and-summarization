{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.local/vss/thor/runtime-approval-bundles-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "mode", "default_policy", "approval_policy", "audio_dependency_boundary", "download_review", "bundles", "source_locks"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "vss-3.2.1-thor-runtime-approval-bundles"},
    "mode": {"const": "inert_nonexecuting_approval_bundle_compiler"},
    "default_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["host_inspection", "subprocess", "network", "docker", "writes", "downloads", "credentials", "lifecycle", "destructive", "approvals_granted", "warehouse_sample_bundle"],
      "properties": {
        "host_inspection": {"const": false}, "subprocess": {"const": false}, "network": {"const": false}, "docker": {"const": false}, "writes": {"const": false}, "downloads": {"const": false}, "credentials": {"const": false}, "lifecycle": {"const": false}, "destructive": {"const": false}, "approvals_granted": {"const": false}, "warehouse_sample_bundle": {"const": "excluded"}
      }
    },
    "approval_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_inheritance", "one_bundle_per_acknowledgement", "placeholder_is_not_approval", "dependency_completion_is_not_approval", "dependency_satisfaction", "compiler_can_grant_approval", "approval_text_rule"],
      "properties": {"approval_inheritance": {"const": false}, "one_bundle_per_acknowledgement": {"const": true}, "placeholder_is_not_approval": {"const": true}, "dependency_completion_is_not_approval": {"const": true}, "dependency_satisfaction": {"const": "separate_bundle_receipt_or_reviewed_not_required_determination"}, "compiler_can_grant_approval": {"const": false}, "approval_text_rule": {"const": "operator_replaces_exact_bundle_placeholder_in_separate_authorized_workflow"}}
    },
    "audio_dependency_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "stable_fixture_path", "wave7_identity_path", "runtime_contract_path", "runtime_oracle_path", "active_audio_package_relied_on", "binding_rule"],
      "properties": {"state": {"const": "stable_reviewed_audio_contract"}, "stable_fixture_path": {"const": "deploy/docker/thor-local/qualification/tiny-audio-fixture/fixture.py"}, "wave7_identity_path": {"const": "deploy/docker/thor-local/qualification/advertised-entry-executors-wave7/inventory.json"}, "runtime_contract_path": {"const": "deploy/docker/thor-local/qualification/audio-entry-oracles/contract.json"}, "runtime_oracle_path": {"const": "deploy/docker/thor-local/qualification/audio-entry-oracles/oracle.py"}, "active_audio_package_relied_on": {"const": true}, "binding_rule": {"const": "native_audio_and_separate_asr_require_distinct_noninheriting_authorizations"}}
    },
    "download_review": {"$ref": "#/$defs/download_review"},
    "bundles": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/bundle"}},
    "source_locks": {"type": "array", "minItems": 27, "maxItems": 27, "items": {"$ref": "#/$defs/source_lock"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"},
    "flags": {
      "type": "object", "additionalProperties": false,
      "required": ["host_inspection", "subprocess", "network", "docker", "writes", "downloads", "credentials", "lifecycle", "destructive"],
      "properties": {"host_inspection": {"type": "boolean"}, "subprocess": {"type": "boolean"}, "network": {"type": "boolean"}, "docker": {"type": "boolean"}, "writes": {"type": "boolean"}, "downloads": {"type": "boolean"}, "credentials": {"type": "boolean"}, "lifecycle": {"type": "boolean"}, "destructive": {"type": "boolean"}}
    },
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "approval_placeholder", "depends_on", "flags", "required_inputs", "current_blockers", "cleanup", "rollback"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 3}, "approval_placeholder": {"type": "string", "pattern": "^<APPROVE_ONLY_[A-Z0-9_]+>$"},
        "acknowledgement_token": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{15,127}$"},
        "authorized_command": {"type": "string", "minLength": 20, "maxLength": 512},
        "depends_on": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "flags": {"$ref": "#/$defs/flags"},
        "required_inputs": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "current_blockers": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
        "cleanup": {"type": "string", "minLength": 10}, "rollback": {"type": "string", "minLength": 10}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "size_state", "exact_remote_bytes", "planning_floor_bytes", "identity"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "size_state": {"enum": ["exact_known", "documented_floor_only", "unknown"]}, "exact_remote_bytes": {"type": ["integer", "null"], "minimum": 1}, "planning_floor_bytes": {"type": ["integer", "null"], "minimum": 1}, "identity": {"type": "string", "minLength": 3}},
      "allOf": [
        {"if": {"properties": {"size_state": {"const": "exact_known"}}}, "then": {"properties": {"exact_remote_bytes": {"type": "integer"}, "planning_floor_bytes": {"type": "integer"}}}},
        {"if": {"properties": {"size_state": {"const": "documented_floor_only"}}}, "then": {"properties": {"exact_remote_bytes": {"const": null}, "planning_floor_bytes": {"type": "integer"}}}},
        {"if": {"properties": {"size_state": {"const": "unknown"}}}, "then": {"properties": {"exact_remote_bytes": {"const": null}, "planning_floor_bytes": {"const": null}}}}
      ]
    },
    "download_review": {
      "type": "object", "additionalProperties": false,
      "required": ["known_exact_remote_bytes", "known_planning_floor_bytes_including_documented_cosmos_floor", "all_missing_download_bytes_known", "all_installed_or_unpacked_bytes_known", "disk_review_required_after_exact_missing_set_is_known", "artifacts"],
      "properties": {"known_exact_remote_bytes": {"const": 19871036871}, "known_planning_floor_bytes_including_documented_cosmos_floor": {"const": 49871036871}, "all_missing_download_bytes_known": {"const": false}, "all_installed_or_unpacked_bytes_known": {"const": false}, "disk_review_required_after_exact_missing_set_is_known": {"const": true}, "artifacts": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/artifact"}}}
    },
    "source_lock": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 3}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
