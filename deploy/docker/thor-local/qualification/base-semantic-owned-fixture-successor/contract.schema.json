{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "mode", "predecessor", "authorization", "fixture", "object_store", "cases", "canonical_binding", "promotion_eligible", "warehouse_sample_bundle", "source_locks"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"const": "base-semantic-owned-fixture-successor"},
    "mode": {"const": "authorization_gated_local_runtime_candidate"},
    "predecessor": {"const": "deploy/docker/thor-local/qualification/base-semantic-full-envelope-successor"},
    "authorization": {"type": "object"},
    "fixture": {"type": "object"},
    "object_store": {"type": "object"},
    "cases": {"type": "array", "minItems": 2, "maxItems": 2},
    "canonical_binding": {"const": false},
    "promotion_eligible": {"const": false},
    "warehouse_sample_bundle": {"const": "excluded"},
    "source_locks": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
