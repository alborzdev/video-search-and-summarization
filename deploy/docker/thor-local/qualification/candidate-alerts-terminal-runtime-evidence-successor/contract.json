    "cancelled_result_must_be_absent": true,
    "atomic_pre_publish_gate_source_locked": true
  },
  "cleanup": {
    "exact_config_cleanup": true,
    "non_owned_config_projection_restored": true,
    "terminal_job_delete_api_available": false,
    "terminal_jobs_retained_until_ttl_or_restart": true
  },
  "decision": {
