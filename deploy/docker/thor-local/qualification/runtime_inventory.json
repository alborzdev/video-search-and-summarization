{
  "schema_version": 1,
  "target": "VSS 3.2.1 Thor-local read-only runtime APIs",
  "services": [
    {
      "id": "agent",
      "port_env": "VSS_AGENT_PORT",
      "default_port": 8100,
      "probes": [
        {
          "id": "health",
          "kind": "health",
          "method": "GET",
          "path": "/health",
          "expected_status": [200]
        },
        {
          "id": "openapi",
          "kind": "openapi",
          "method": "GET",
          "path": "/openapi.json",
          "expected_status": [200],
          "availability": "optional",
          "expected_manifest": "agent.json"
        }
      ]
    },
    {
      "id": "rt-vlm",
      "port_env": "RTVI_VLM_PORT",
      "default_port": 8018,
      "probes": [
        {
          "id": "ready",
          "kind": "health",
          "method": "GET",
          "path": "/v1/health/ready",
          "expected_status": [200]
        },
        {
          "id": "openapi",
          "kind": "openapi",
          "method": "GET",
          "path": "/openapi.json",
          "expected_status": [200],
          "expected_manifest": "rt-vlm.json"
        }
      ]
    },
    {
      "id": "rt-embed",
      "port_env": "RTVI_EMBED_PORT",
      "default_port": 8017,
      "probes": [
        {
          "id": "ready",
          "kind": "health",
          "method": "GET",
          "path": "/v1/ready",
          "expected_status": [200]
        },
        {
          "id": "openapi",
          "kind": "openapi",
          "method": "GET",
          "path": "/openapi.json",
          "expected_status": [200],
          "expected_manifest": "rt-embed.json"
        }
      ]
    },
    {
      "id": "rt-cv",
      "port_env": "RTVI_CV_PORT",
      "default_port": 9000,
      "probes": [
        {
          "id": "ready",
          "kind": "health",
          "method": "GET",
          "path": "/api/v1/ready",
          "expected_status": [200]
        }
      ]
    },
    {
      "id": "alerts",
      "port_env": "ALERT_BRIDGE_PORT",
      "default_port": 9080,
      "probes": [
        {
          "id": "health",
          "kind": "health",
          "method": "GET",
          "path": "/health",
          "expected_status": [200]
        },
        {
          "id": "openapi",
          "kind": "openapi",
          "method": "GET",
          "path": "/openapi.json",
          "expected_status": [200],
          "availability": "optional",
          "expected_manifest": "alerts.json"
        }
      ]
    },
    {
      "id": "lvs",
      "port_env": "BACKEND_PORT",
      "default_port": 38111,
      "probes": [
        {
          "id": "ready",
          "kind": "health",
          "method": "GET",
          "path": "/v1/ready",
          "expected_status": [200]
        },
        {
          "id": "openapi",
          "kind": "openapi",
          "method": "GET",
          "path": "/openapi.json",
          "expected_status": [200],
          "expected_manifest": "lvs.json"
        },
        {
          "id": "files-invalid-purpose",
          "kind": "semantic",
          "method": "GET",
          "path": "/files",
          "query": {
            "purpose": "invalid"
          },
          "expected_status": [422]
        }
      ]
    },
    {
      "id": "video-analytics",
      "port_env": "VIDEO_ANALYTICS_API_PORT",
      "default_port": 8081,
      "probes": [
        {
          "id": "live",
          "kind": "health",
          "method": "GET",
          "path": "/livez",
          "expected_status": [200]
        },
        {
          "id": "openapi",
          "kind": "openapi",
          "method": "GET",
          "path": "/openapi.json",
          "expected_status": [200],
          "availability": "optional",
          "expected_manifest": "video-analytics.json"
        }
      ]
    },
    {
      "id": "vios",
      "port_env": "VST_PORT",
      "default_port": 30888,
      "probes": [
        {
          "id": "health",
          "kind": "health",
          "method": "GET",
          "path": "/health",
          "expected_status": [200]
        }
      ]
    },
    {
      "id": "vios-mcp",
      "port_env": "VST_MCP_PORT",
      "default_port": 8001,
      "probes": [
        {
          "id": "transport",
          "kind": "mcp",
          "mode": "http",
          "method": "GET",
          "path": "/mcp",
          "expected_status": [200, 400, 406]
        }
      ]
    },
    {
      "id": "va-mcp",
      "port_env": "VSS_VA_MCP_PORT",
      "default_port": 9901,
      "probes": [
        {
          "id": "health",
          "kind": "health",
          "method": "GET",
          "path": "/health",
          "expected_status": [200]
        },
        {
          "id": "transport",
          "kind": "mcp",
          "mode": "http",
          "method": "GET",
          "path": "/mcp",
          "expected_status": [200, 400, 406]
        }
      ]
    },
    {
      "id": "lvs-mcp",
      "port_env": "LVS_MCP_PORT",
      "default_port": 38112,
      "probes": [
        {
          "id": "transport",
          "kind": "mcp",
          "mode": "sse",
          "method": "GET",
          "path": "/sse",
          "expected_status": [200]
        }
      ]
    },
    {
      "id": "elasticsearch",
      "port_env": "VSS_ES_PORT",
      "default_port": 9200,
      "probes": [
        {
          "id": "cluster-health",
          "kind": "health",
          "method": "GET",
          "path": "/_cluster/health",
          "expected_status": [200]
        }
      ]
    },
    {
      "id": "kibana",
      "port_env": "KIBANA_PORT",
      "default_port": 5601,
      "probes": [
        {
          "id": "status",
          "kind": "health",
          "method": "GET",
          "path": "/kibana/api/status",
          "expected_status": [200]
        }
      ]
    },
    {
      "id": "phoenix",
      "port_env": "PHOENIX_PORT",
      "default_port": 6006,
      "probes": [
        {
          "id": "ready",
          "kind": "health",
          "method": "GET",
          "path": "/readyz",
          "expected_status": [200]
        }
      ]
    },
    {
      "id": "logstash",
      "port_env": "LOGSTASH_API_PORT",
      "default_port": 9600,
      "probes": [
        {
          "id": "node-api",
          "kind": "health",
          "method": "GET",
          "path": "/",
          "expected_status": [200]
        }
      ]
    },
    {
      "id": "prometheus",
      "port_env": "PROMETHEUS_PORT",
      "default_port": 9090,
      "probes": [
        {
          "id": "ready",
          "kind": "health",
          "method": "GET",
          "path": "/-/ready",
          "expected_status": [200]
        },
        {
          "id": "targets",
          "kind": "prometheus-targets",
          "method": "GET",
          "path": "/api/v1/targets",
          "expected_status": [200],
          "expected_jobs": [
            "prometheus",
            "cadvisor",
            "node-exporter",
            "tegrastats-exporter",
            "rtvi-vlm",
            "rtvi-embed",
            "lvs"
          ]
        }
      ]
    },
    {
      "id": "grafana",
      "port_env": "GRAFANA_PORT",
      "default_port": 35000,
      "probes": [
        {
          "id": "health",
          "kind": "health",
          "method": "GET",
          "path": "/api/health",
          "expected_status": [200]
        },
        {
          "id": "thor-dashboard",
          "kind": "reachability",
          "method": "GET",
          "path": "/api/dashboards/uid/thor-vss-observability",
          "expected_status": [200]
        }
      ]
    },
    {
      "id": "node-exporter",
      "port_env": "NODE_EXPORTER_PORT",
      "default_port": 19100,
      "probes": [
        {
          "id": "metrics",
          "kind": "reachability",
          "method": "GET",
          "path": "/metrics",
          "expected_status": [200]
        }
      ]
    },
    {
      "id": "cadvisor",
      "port_env": "CADVISOR_PORT",
      "default_port": 18080,
      "probes": [
        {
          "id": "health",
          "kind": "health",
          "method": "GET",
          "path": "/healthz",
          "expected_status": [200]
        }
      ]
    },
    {
      "id": "ui",
      "port_env": "VSS_UI_PORT",
      "default_port": 3001,
      "probes": [
        {
          "id": "root",
          "kind": "reachability",
          "method": "GET",
          "path": "/",
          "expected_status": [200, 301, 302, 307, 308]
        }
      ]
    },
    {
      "id": "public-ingress",
      "port_env": "HAPROXY_PORT",
      "default_port": 7777,
      "probes": [
        {
          "id": "root",
          "kind": "reachability",
          "method": "GET",
          "path": "/",
          "expected_status": [200, 301, 302, 307, 308]
        }
      ]
    }
  ]
}
