{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/vss/thor/capability-oracles.schema.json",
  "title": "Thor official capability acceptance oracles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "policy", "oracles"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_version", "main_commit", "captured_on"],
      "properties": {
        "product_version": {"const": "3.2.1"},
        "main_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "captured_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_scope", "pass_rule", "generic_oracle_prohibited", "warehouse_sample_bundle"],
      "properties": {
        "claim_scope": {"type": "string", "minLength": 1},
        "pass_rule": {"type": "string", "minLength": 1},
        "generic_oracle_prohibited": {"const": true},
        "warehouse_sample_bundle": {"type": "string", "minLength": 1}
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/oracle"}
    }
  },
  "$defs": {
    "plainId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id", "oracle_id", "profile", "mode", "ledger_binding", "reviewed_scenario_ids",
        "fixture", "expected_observations", "assertions", "admission_prerequisites",
        "execution_bounds", "cleanup", "acceptance_readiness", "current_state", "evidence"
      ],
      "properties": {
        "capability_id": {"$ref": "#/$defs/plainId"},
        "oracle_id": {"$ref": "#/$defs/plainId"},
        "profile": {"$ref": "#/$defs/plainId"},
        "mode": {"enum": ["static", "config", "runtime", "api", "protocol", "model", "deploy"]},
        "protocol_case_binding": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "file_sha256", "contract_set_sha256", "target_commit", "case_id", "case_sha256", "positive_vector_id", "negative_vector_ids", "source_hashes"],
          "properties": {
            "path": {"const": "deploy/docker/thor-local/qualification/protocol-cases/protocol-cases.json"},
            "file_sha256": {"const": "28cbcabef1bf1f3ed41ebf398de3e2387548b2ec6de72b5a51d8c5f30a59a7a6"},
            "contract_set_sha256": {"const": "3089ca096b4f86bbe54cce37027acf1769adff8bd1b4adf8a2018983c72ddb21"},
            "target_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "case_id": {"$ref": "#/$defs/plainId"},
            "case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "positive_vector_id": {"$ref": "#/$defs/plainId"},
            "negative_vector_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/plainId"}},
            "source_hashes": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["path", "git_blob_oid", "content_sha256"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            }
          }
        },
        "planning_executor_bindings": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/planningExecutorBinding"}
        },
        "offline_tool_observation_bindings": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"$ref": "#/$defs/offlineToolObservationBinding"}
        },
        "ledger_binding": {
          "type": "object", "additionalProperties": false,
          "required": ["feature_id", "kind", "title", "source_claims", "acceptance_class", "thor_state", "runtime_state", "contract", "gap"],
          "properties": {
            "feature_id": {"$ref": "#/$defs/plainId"},
            "kind": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1},
            "source_claims": {"type": "array", "minItems": 1, "items": {"type": "object"}},
            "acceptance_class": {"type": "string", "minLength": 1},
            "thor_state": {"type": "string", "minLength": 1},
            "runtime_state": {"type": "string", "minLength": 1},
            "contract": {"type": "object", "minProperties": 1},
            "gap": {"type": "string", "minLength": 1}
          }
        },
        "reviewed_scenario_ids": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/plainId"}
        },
        "fixture": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "availability", "source", "warehouse_sample_bundle", "materialization", "input"],
          "properties": {
            "id": {"$ref": "#/$defs/plainId"},
            "kind": {"enum": ["generated_custom_media", "generated_minimal_contract", "operator_external_contract"]},
            "availability": {"enum": ["not_staged", "operator_required"]},
            "source": {"type": "string", "minLength": 1},
            "warehouse_sample_bundle": {"const": false},
            "materialization": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "generator", "sha256"],
              "properties": {
                "path": {"type": ["string", "null"]},
                "generator": {"type": ["string", "null"]},
                "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "input": {
              "type": "object", "additionalProperties": false,
              "required": ["capability_id", "contract", "namespace", "action"],
              "properties": {
                "capability_id": {"$ref": "#/$defs/plainId"},
                "contract": {"type": "object", "minProperties": 1},
                "namespace": {"$ref": "#/$defs/plainId"},
                "action": {"type": "string", "minLength": 12}
              }
            }
          }
        },
        "expected_observations": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "description"],
            "properties": {
              "id": {"$ref": "#/$defs/plainId"},
              "description": {"type": "string", "minLength": 12}
            }
          }
        },
        "assertions": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "observation", "operator", "expected"],
            "properties": {
              "id": {"$ref": "#/$defs/plainId"},
              "observation": {"type": "string", "minLength": 1},
              "operator": {"enum": ["equals", "recorded_pass"]},
              "expected": {}
            }
          }
        },
        "admission_prerequisites": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "condition", "bounded"],
            "properties": {
              "id": {"$ref": "#/$defs/plainId"},
              "condition": {"type": "string", "minLength": 12},
              "bounded": {"const": true}
            }
          }
        },
        "execution_bounds": {
          "type": "object", "additionalProperties": false,
          "required": ["executor", "collectors", "network_scope", "max_duration_seconds", "max_requests", "max_actions", "workload", "model_staging", "warehouse_sample_bundle"],
          "properties": {
            "executor": {"type": ["string", "null"]},
            "collectors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "network_scope": {"enum": ["loopback-or-compose-internal", "operator-approved external endpoint"]},
            "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
            "max_requests": {"type": "integer", "minimum": 0, "maximum": 10000},
            "max_actions": {"type": "integer", "minimum": 1, "maximum": 10000},
            "workload": {
              "type": "object", "additionalProperties": false,
              "required": ["units", "requests_per_unit", "overhead_requests", "calculated_max_requests", "phases"],
              "properties": {
                "units": {"type": "integer", "minimum": 1, "maximum": 10000},
                "requests_per_unit": {"type": "integer", "minimum": 1, "maximum": 100},
                "overhead_requests": {"type": "integer", "minimum": 0, "maximum": 100},
                "calculated_max_requests": {"type": "integer", "minimum": 1, "maximum": 10000},
                "phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/plainId"}}
              }
            },
            "model_staging": {"const": "prerequisite_only"},
            "warehouse_sample_bundle": {"const": "excluded"}
          }
        },
        "cleanup": {
          "type": "object", "additionalProperties": false,
          "required": ["mutation", "targets", "allowlist", "pre_state", "restore", "executor", "postcondition_collectors", "postconditions"],
          "properties": {
            "mutation": {"enum": ["none_by_default", "read_only", "temporary_files_only", "namespaced_and_reversible"]},
            "targets": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/plainId"}},
            "allowlist": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/plainId"}},
            "pre_state": {"type": "string", "minLength": 12},
            "restore": {"type": "string", "minLength": 12},
            "executor": {"type": ["string", "null"]},
            "postcondition_collectors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "postconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 12}}
          }
        },
        "acceptance_readiness": {
          "type": "object", "additionalProperties": false,
          "required": ["classification", "blockers"],
          "properties": {
            "classification": {"enum": ["planning_index_only", "executor_ready"]},
            "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 12}}
          }
        },
        "current_state": {"enum": ["open_unexecuted", "external_boundary_unexecuted"]},
        "evidence": {"type": "array", "maxItems": 0}
      },
      "allOf": [
        {
          "if": {
            "required": ["capability_id"],
            "properties": {
              "capability_id": {"const": "manifest-entry.vios-codecs-audio.05-cpu-multimedia-support"}
            }
          },
          "then": {
            "properties": {
              "oracle_id": {"const": "oracle.manifest-entry.vios-codecs-audio.05-cpu-multimedia-support"},
              "profile": {"const": "behavior-manifest-entry-vios-codecs-audio-05-cpu-multimedia-support"},
              "mode": {"const": "runtime"},
              "ledger_binding": {
                "properties": {
                  "feature_id": {"const": "vios-codecs-audio"},
                  "kind": {"const": "runtime_behavior"},
                  "title": {"const": "CPU multimedia support"},
                  "acceptance_class": {"const": "required_local"},
                  "thor_state": {"const": "wired"},
                  "runtime_state": {"enum": ["not_qualified", "passed_current"]},
                  "contract": {
                    "required": ["selectors", "branch_selection", "software_elements", "hardware_default_elements", "offline_bundle", "immutable_derivatives", "source_controls"]
                  }
                }
              },
              "fixture": {
                "properties": {
                  "kind": {"const": "generated_custom_media"},
                  "warehouse_sample_bundle": {"const": false}
                }
              },
              "execution_bounds": {
                "properties": {
                  "executor": {"const": null},
                  "collectors": {"const": []},
                  "max_requests": {"const": 2},
                  "max_actions": {"const": 2}
                }
              },
              "cleanup": {
                "properties": {
                  "executor": {"const": null},
                  "postcondition_collectors": {"const": []}
                }
              },
              "acceptance_readiness": {
                "properties": {
                  "classification": {"const": "planning_index_only"}
                }
              },
              "current_state": {"const": "open_unexecuted"},
              "evidence": {"const": []}
            }
          }
        }
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewedFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "raw_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^deploy/docker/thor-local/qualification/offline-mv3dt-tools/"},
        "raw_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "offlineToolObservationBinding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "scope", "qualification_package", "contract", "executor",
        "result_schema", "fixture", "execution_receipt", "source_locks",
        "dependency_observation", "selected_output_locks", "selected_semantic",
        "oracle_coverage", "result",
        "can_advance_capability", "can_mark_passed_current", "runtime_evidence"
      ],
      "properties": {
        "scope": {"const": "bounded_static_tool_observation_subset_only"},
        "qualification_package": {"const": "deploy/docker/thor-local/qualification/offline-mv3dt-tools"},
        "contract": {"$ref": "#/$defs/reviewedFile"},
        "executor": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "raw_sha256", "invocation"],
          "properties": {
            "path": {"const": "deploy/docker/thor-local/qualification/offline-mv3dt-tools/executor.py"},
            "raw_sha256": {"$ref": "#/$defs/sha256"},
            "invocation": {
              "const": [
                "python3",
                "deploy/docker/thor-local/qualification/offline-mv3dt-tools/executor.py",
                "--check"
              ]
            }
          }
        },
        "result_schema": {"$ref": "#/$defs/reviewedFile"},
        "fixture": {"$ref": "#/$defs/reviewedFile"},
        "execution_receipt": {"$ref": "#/$defs/reviewedFile"},
        "source_locks": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "selected_output_locks": {
          "type": "object", "minProperties": 1, "maxProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "dependency_observation": {
          "type": "object", "additionalProperties": false,
          "required": [
            "requirements_path", "requirements_sha256", "declared_requirements",
            "observed_distribution_versions", "observed_module_versions",
            "observed_versions_sha256", "note",
            "declared_versions_match_observed_distributions",
            "normative_for_declared_requirements", "mismatches"
          ],
          "properties": {
            "requirements_path": {"const": "tools/rtvi-cv-mv3dt-utils/requirements.txt"},
            "requirements_sha256": {"$ref": "#/$defs/sha256"},
            "declared_requirements": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1}},
            "observed_distribution_versions": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "minLength": 1}},
            "observed_module_versions": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "minLength": 1}},
            "observed_versions_sha256": {"$ref": "#/$defs/sha256"},
            "note": {"const": "candidate execution records local versions; it does not claim they equal the reviewed pins"},
            "declared_versions_match_observed_distributions": {"const": false},
            "normative_for_declared_requirements": {"const": false},
            "mismatches": {
              "type": "array", "minItems": 4, "maxItems": 4,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["distribution", "declared", "observed"],
                "properties": {
                  "distribution": {"enum": ["numpy", "opencv-python", "PyYAML", "tqdm"]},
                  "declared": {"type": "string", "minLength": 1},
                  "observed": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "selected_semantic": {
          "type": "object", "minProperties": 1, "maxProperties": 1
        },
        "oracle_coverage": {
          "type": "object", "additionalProperties": false,
          "required": [
            "covered_observation_ids", "uncovered_observation_ids",
            "covered_assertion_ids", "uncovered_assertion_ids"
          ],
          "properties": {
            "covered_observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/plainId"}},
            "uncovered_observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/plainId"}},
            "covered_assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/plainId"}},
            "uncovered_assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/plainId"}}
          }
        },
        "result": {
          "type": "object", "additionalProperties": false,
          "required": [
            "observation", "run_count", "official_capability_effect",
            "warehouse_sample_bundle_used", "network_used", "docker_used",
            "subprocess_used", "lifecycle_used"
          ],
          "properties": {
            "observation": {"const": "observed_match_candidate_only"},
            "run_count": {"const": 2},
            "official_capability_effect": {"const": "none_candidate_only"},
            "warehouse_sample_bundle_used": {"const": false},
            "network_used": {"const": false},
            "docker_used": {"const": false},
            "subprocess_used": {"const": false},
            "lifecycle_used": {"const": false}
          }
        },
        "can_advance_capability": {"const": false},
        "can_mark_passed_current": {"const": false},
        "runtime_evidence": {"type": "array", "maxItems": 0}
      }
    },
    "planningExecutorBinding": {
      "oneOf": [
        {"$ref": "#/$defs/genericPlanningExecutorBinding"},
        {"$ref": "#/$defs/calibrationSchemaPlanningExecutorBinding"}
      ]
    },
    "genericPlanningExecutorBinding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "planning_requirement_id", "scope", "materialization", "executor",
        "case", "result", "can_advance_capability", "can_mark_passed_current",
        "runtime_evidence"
      ],
      "properties": {
        "planning_requirement_id": {"$ref": "#/$defs/plainId"},
        "scope": {"const": "bounded_static_assertion_subset_only"},
        "materialization": {"$ref": "#/$defs/staticMaterialization"},
        "executor": {"$ref": "#/$defs/staticExecutor"},
        "case": {"$ref": "#/$defs/staticCase"},
        "result": {"$ref": "#/$defs/staticResult"},
        "can_advance_capability": {"const": false},
        "can_mark_passed_current": {"const": false},
        "runtime_evidence": {"type": "array", "maxItems": 0}
      }
    },
    "calibrationSchemaPlanningExecutorBinding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "planning_requirement_id", "scope", "materialization", "executor",
        "case", "result", "can_advance_capability", "can_mark_passed_current",
        "runtime_evidence"
      ],
      "properties": {
        "planning_requirement_id": {"const": "calibration-schema-static"},
        "scope": {"const": "bounded_static_assertion_subset_only"},
        "materialization": {"$ref": "#/$defs/calibrationSchemaStaticMaterialization"},
        "executor": {"$ref": "#/$defs/calibrationSchemaStaticExecutor"},
        "case": {"$ref": "#/$defs/calibrationSchemaStaticCase"},
        "result": {"$ref": "#/$defs/calibrationSchemaStaticResult"},
        "can_advance_capability": {"const": false},
        "can_mark_passed_current": {"const": false},
        "runtime_evidence": {"type": "array", "maxItems": 0}
      }
    },
    "calibrationSchemaStaticMaterialization": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "inventory_path", "case_json_pointer", "case_canonical_sha256"],
      "properties": {
        "scope": {"const": "live_planning_requirement_static_contract"},
        "inventory_path": {"const": "deploy/docker/thor-local/qualification/calibration-schema-static-executor/contract.json"},
        "case_json_pointer": {"const": "/binding"},
        "case_canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "calibrationSchemaStaticExecutor": {
      "type": "object", "additionalProperties": false,
      "required": [
        "path", "raw_sha256", "inventory_path", "inventory_raw_sha256",
        "inventory_canonical_sha256", "inventory_schema_path",
        "inventory_schema_raw_sha256", "invocation"
      ],
      "properties": {
        "path": {"const": "deploy/docker/thor-local/qualification/calibration-schema-static-executor/executor.py"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_path": {"const": "deploy/docker/thor-local/qualification/calibration-schema-static-executor/contract.json"},
        "inventory_raw_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_schema_path": {"const": "deploy/docker/thor-local/qualification/calibration-schema-static-executor/contract.schema.json"},
        "inventory_schema_raw_sha256": {"$ref": "#/$defs/sha256"},
        "invocation": {
          "const": [
            "python3",
            "deploy/docker/thor-local/qualification/calibration-schema-static-executor/executor.py",
            "--json"
          ]
        }
      }
    },
    "calibrationSchemaStaticCase": {
      "type": "object", "additionalProperties": false,
      "required": [
        "case_id", "planning_requirement_id", "capability_id",
        "planning_payload_sha256", "planning_owner_type", "planning_owner_id",
        "applicable_record_ids", "uncovered_applicable_record_ids"
      ],
      "properties": {
        "case_id": {"const": "calibration-schema-static.vss-json"},
        "planning_requirement_id": {"const": "calibration-schema-static"},
        "capability_id": {"const": "calibration.schema.vss-json"},
        "planning_payload_sha256": {"const": "3e54d36b3e1895ad69fda05e458d3c80809507e31e975c210fdab56f446ce791"},
        "planning_owner_type": {"const": "global_acceptance_vector"},
        "planning_owner_id": {"const": "calibration-schema-static"},
        "applicable_record_ids": {
          "const": [
            "calibration.camera-positioning.installation-contract",
            "calibration.schema.vss-json",
            "behavior.auto-calibration.failure-recovery",
            "behavior.auto-calibration.result-verification",
            "calibration.auto.alignment-schema",
            "calibration.auto.workflow-six-step",
            "behavior.auto-calibration.known-limitations"
          ]
        },
        "uncovered_applicable_record_ids": {
          "const": [
            "calibration.camera-positioning.installation-contract",
            "behavior.auto-calibration.failure-recovery",
            "behavior.auto-calibration.result-verification",
            "calibration.auto.alignment-schema",
            "calibration.auto.workflow-six-step",
            "behavior.auto-calibration.known-limitations"
          ]
        }
      }
    },
    "calibrationSchemaStaticResult": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_path", "schema_raw_sha256", "execution_receipt_path",
        "execution_receipt_raw_sha256", "execution_receipt_canonical_sha256",
        "expected_outcome", "evidence_class", "can_advance_capability",
        "can_mark_passed_current", "runtime_evidence"
      ],
      "properties": {
        "schema_path": {"const": "deploy/docker/thor-local/qualification/calibration-schema-static-executor/result.schema.json"},
        "schema_raw_sha256": {"$ref": "#/$defs/sha256"},
        "execution_receipt_path": {"const": "deploy/docker/thor-local/qualification/calibration-schema-static-integration/execution-receipt.json"},
        "execution_receipt_raw_sha256": {"$ref": "#/$defs/sha256"},
        "execution_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "expected_outcome": {"const": "observed_match"},
        "evidence_class": {"const": "deterministic_file_static_evidence_not_runtime"},
        "can_advance_capability": {"const": false},
        "can_mark_passed_current": {"const": false},
        "runtime_evidence": {"type": "array", "maxItems": 0}
      }
    },
    "staticMaterialization": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "inventory_path", "case_json_pointer", "case_canonical_sha256"],
      "properties": {
        "scope": {"const": "live_planning_requirement_static_contract"},
