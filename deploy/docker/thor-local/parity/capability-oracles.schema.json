        "inventory_schema_raw_sha256": {"$ref": "#/$defs/sha256"},
        "invocation": {
          "type": "array", "prefixItems": [
            {"const": "python3"},
            {"enum": [
              "deploy/docker/thor-local/qualification/executor-cases/executor.py",
              "deploy/docker/thor-local/qualification/source-contract-cases/executor.py"
            ]},
            {"const": "run"},
            {"$ref": "#/$defs/plainId"}
          ], "items": false, "minItems": 4, "maxItems": 4
        }
      }
    },
    "staticCase": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "planning_requirement_id", "capability_id", "planning_payload_sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/plainId"},
        "planning_requirement_id": {"$ref": "#/$defs/plainId"},
        "capability_id": {"$ref": "#/$defs/plainId"},
