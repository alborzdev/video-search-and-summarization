{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.nvidia.com/vss/thor-local/metadata-set-selector.schema.json",
  "title": "Thor-local metadata-set selector",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selected_set", "available_sets"],
  "properties": {
    "schema_version": {"const": 1},
    "selected_set": {"$ref": "#/$defs/plainId"},
    "available_sets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["set_id", "descriptor_path", "descriptor_raw_sha256"],
        "properties": {
          "set_id": {"$ref": "#/$defs/plainId"},
          "descriptor_path": {"$ref": "#/$defs/repoPath"},
          "descriptor_raw_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "plainId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^deploy/docker/thor-local/[A-Za-z0-9._/-]+$",
      "minLength": 1,
      "maxLength": 512
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
