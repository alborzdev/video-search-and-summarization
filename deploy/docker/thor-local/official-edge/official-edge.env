# Exact NVIDIA Thor edge model contract. Load this after thor-local/generated.env.
LLM_MODE=remote
LLM_NAME=nvidia/NVIDIA-Nemotron-3-Nano-4B-FP8
LLM_NAME_SLUG=none
LLM_BASE_URL=http://127.0.0.1:30081
LLM_MODEL_TYPE=vllm
LLM_PORT=30081
LVS_LLM_MODEL_NAME=nvidia/NVIDIA-Nemotron-3-Nano-4B-FP8
LVS_LLM_MODEL_TYPE=vllm
EVAL_LLM_JUDGE_NAME=nvidia/NVIDIA-Nemotron-3-Nano-4B-FP8
EVAL_LLM_JUDGE_BASE_URL=http://127.0.0.1:30081

VLM_MODE=local_shared
VLM_NAME=nim_nvidia_cosmos3-nano-reasoner_bf16-final
VLM_NAME_SLUG=none
VLM_BASE_URL=http://127.0.0.1:8018
VLM_MODEL_TYPE=rtvi
VLM_PORT=8018

RTVI_VLM_BASE_URL=http://127.0.0.1:8018
RTVI_VLM_ENDPOINT=
RTVI_VLM_API_KEY=
RTVI_VLM_MODEL_TO_USE=cosmos-reason3
RTVI_VLM_MODEL_PATH=ngc:nim/nvidia/cosmos3-nano-reasoner:bf16-final
RTVI_VLM_OPENAI_MODEL_DEPLOYMENT_NAME=nim_nvidia_cosmos3-nano-reasoner_bf16-final
RTVI_VLLM_GPU_MEMORY_UTILIZATION=0.30
RTVI_VLLM_KV_CACHE_MEMORY_BYTES=4294967296
RTVI_VLLM_MAX_NUM_BATCHED_TOKENS=4096
RTVI_VLLM_ENFORCE_EAGER=true
RTVI_VLM_MAX_MODEL_LEN=16384
RTVI_VLM_MAX_GENERATION_TOKENS=4096
RTVI_VLLM_MAX_NUM_SEQS=1
RTVI_VLM_BATCH_SIZE=1
RTVI_VLM_NUM_VLM_PROCS=1

VSS_AGENT_CONFIG_FILE=/vss-agent/deploy/docker/thor-local/official-edge/config_edge.yml
