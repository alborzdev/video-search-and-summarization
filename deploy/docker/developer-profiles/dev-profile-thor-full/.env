# Unified, single-device AGX Thor profile. The application services run in
# containers while the operator-managed OpenAI-compatible LLM and VLM remain
# bound to loopback on the host.
MODE=2d
BP_PROFILE=bp_developer_thor_full
HARDWARE_PROFILE=AGX-THOR
COMPOSE_PROFILES=bp_developer_thor_full_2d
COMPOSE_PROJECT_NAME=mdx

RESERVED_DEVICE_IDS=''
FIXED_SHARED_DEVICE_IDS=''
RT_CV_DEVICE_ID=0
RT_EMBED_DEVICE_ID=0
RT_VLM_DEVICE_ID=0
LLM_DEVICE_ID=0
VLM_DEVICE_ID=0

LLM_MODE=remote
LLM_NAME=datasheet-chat
LLM_NAME_SLUG=none
LLM_ENV_FILE=''
LLM_BASE_URL=http://127.0.0.1:8000
LLM_MODEL_TYPE=vllm
VA_MCP_LLM_MODEL_TYPE=openai
LLM_PORT=30081

VLM_MODE=remote
VLM_NAME=datasheet-vision
VLM_NAME_SLUG=none
VLM_ENV_FILE=''
VLM_BASE_URL=http://127.0.0.1:8001
VLM_MODEL_TYPE=vllm
VLM_PORT=30082
VLM_MAX_FRAMES_PER_REQUEST=4
VLM_NIM_KVCACHE_PERCENT=0.7

VSS_APPS_DIR="/path/to/deploy/docker"
VSS_DATA_DIR="/path/to/vss-apps-data"
HOST_IP='<HOST_IP>'
EXTERNAL_IP=${HOST_IP}

HAPROXY_PORT=7777
HAPROXY_BIND_ADDR=127.0.0.1
VSS_PUBLIC_HTTP_PROTOCOL=http
VSS_PUBLIC_WS_PROTOCOL=ws
VSS_PUBLIC_HOST=127.0.0.1
VSS_PUBLIC_PORT=${HAPROXY_PORT}

# NGC is used only by the connected bootstrap for private images and model
# assets. thor-local.sh strips both registry variables from its protected
# offline runtime environment.
NGC_CLI_API_KEY=''
NGC_API_KEY=''
NVIDIA_API_KEY=''
OPENAI_API_KEY=local
HF_TOKEN=''

STREAM_TYPE=kafka
ELASTICSEARCH_ILM_MIN_AGE=48h
ELASTICSEARCH_CONNECTION_MAX_ATTEMPTS=20
ELASTICSEARCH_RTVI_CV_EMBEDDINGS_DIM=1152
ELASTICSEARCH_VISION_LLM_EMBEDDINGS_DIM=768
VSS_ES_PORT=9200
ELASTIC_SEARCH_PORT=9200
ELASTIC_SEARCH_ENDPOINT=http://${HOST_IP}:${ELASTIC_SEARCH_PORT}
ELASTIC_SEARCH_INDEX=mdx-embed-filtered-2025-01-01
KIBANA_PORT=5601
PHOENIX_PORT=6006
PHOENIX_ENDPOINT=http://${HOST_IP}:${PHOENIX_PORT}
GF_SECURITY_ADMIN_USER=''
GF_SECURITY_ADMIN_PASSWORD=''
SAMPLE_VIDEO_DATASET=''
ADAPTOR_IP=''
ADAPTOR_USER=''
ADAPTOR_PASSWORD=''
AI_BRIDGE_ENDPOINT=''

VISION_ENCODER_MODEL=siglip_v2
VISION_ENCODER_VERSION=v1.1
PERCEPTION_IMAGE=nvcr.io/nvidia/vss-core/vss-rt-cv
PERCEPTION_TAG=3.2.1
PERCEPTION_DOCKERFILE_PREFIX=EDGE-
NUM_STREAMS=1
NUM_SENSORS=1
MODEL_TYPE=cnn
MODEL_NAME_2D=GDINO
NVSTREAMER_INSTALL_ADDITIONAL_PACKAGES=true
NVSTREAMER_HTTP_PORT=31000
VIDEO_ANALYTICS_API_PORT=8081
MDX_PORT=8081
RTVI_CV_PORT=9000

RTVI_EMBED_IMAGE=nvcr.io/nvidia/vss-core/vss-rt-embed
RTVI_EMBED_TAG=3.2.1
RTVI_EMBED_MODEL=cosmos-embed1-448p-anomaly-detection
MODEL_PATH=git:https://huggingface.co/nvidia/Cosmos-Embed1-448p-anomaly-detection
RTVI_EMBED_PORT=8017
RTVI_EMBED_BATCH_SIZE=8
COSMOS_EMBED_PORT=${RTVI_EMBED_PORT}
COSMOS_EMBED_ENDPOINT=http://${HOST_IP}:${COSMOS_EMBED_PORT}

RTVI_VLM_IMAGE_TAG=3.2.1
RTVI_VLM_PORT=8018
RTVI_VLM_BASE_URL=http://${HOST_IP}:${RTVI_VLM_PORT}
RTVI_VLM_ENDPOINT=http://127.0.0.1:8001/v1
RTVI_VLM_URL=http://${HOST_IP}:${RTVI_VLM_PORT}
RTVI_VLM_OPENAI_MODEL_DEPLOYMENT_NAME=${VLM_NAME}
RTVI_VLM_MODEL_TO_USE=openai-compat
RTVI_VLM_MODEL_PATH=none
RTVI_VLM_BATCH_SIZE=1
RTVI_VLM_NUM_VLM_PROCS=1
# Local loopback Qwen uses OPENAI_API_KEY=local. Never propagate the NGC
# staging credential into the runtime proxy container.
RTVI_VLM_API_KEY=''
RTVI_VLLM_GPU_MEMORY_UTILIZATION=''
RTVI_VLM_KAFKA_ENABLED=true
RTVI_VLM_KAFKA_TOPIC=mdx-vlm-captions
RTVI_VLM_KAFKA_BOOTSTRAP_SERVERS=${HOST_IP}:9092
RTVI_VLM_KAFKA_INCIDENT_TOPIC=mdx-vlm-incidents

VST_PORT=30888
VST_INGRESS_HTTP_PORT=30888
SENSOR_HTTP_PORT=30000
STREAM_PROCESSOR_HTTP_PORT=30001
SENSOR_MODULE_ENDPOINT=http://localhost:30000
STREAM_PROCESSOR_MODULE_ENDPOINT=http://localhost:30001
VST_EXTERNAL_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}
VST_INTERNAL_URL=http://${HOST_IP}:${VST_PORT}
VST_STREAM_PROCESSOR_IMAGE_TAG=3.2.1
VST_SENSOR_IMAGE_TAG=3.2.1
NVSTREAMER_IMAGE_TAG=3.2.1
VST_INGRESS_IMAGE_TAG=3.2.1
VST_NGINX_MODE=vst-direct

VSS_AGENT_VERSION=3.2.1
VSS_AGENT_CONFIG_FILE=./deploy/docker/developer-profiles/dev-profile-thor-full/vss-agent/configs/config.yml
VSS_AGENT_HOST=0.0.0.0
VSS_AGENT_PORT=8100
VSS_AGENT_OBJECT_STORE_TYPE=local_object_store
VSS_AGENT_REPORTS_BASE_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}/static/
VSS_AGENT_EXTERNAL_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}
VSS_AGENT_TEMPLATE_PATH=./deploy/docker/developer-profiles/dev-profile-alerts/vss-agent/templates
VSS_AGENT_TEMPLATE_NAME=incident_report_template.md
ENABLE_AUDIO=false

VSS_VA_MCP_CONFIG_FILE=${VSS_APPS_DIR}/developer-profiles/dev-profile-thor-full/vss-agent/configs/va_mcp_server_config.yml
VSS_VA_MCP_PORT=9901
VIDEO_ANALYSIS_MCP_URL=http://${HOST_IP}:${VSS_VA_MCP_PORT}
VST_MCP_URL=http://${HOST_IP}:${VST_PORT}

ALERT_BRIDGE_PORT=9080
ALERT_BRIDGE_URL=http://${HOST_IP}:${ALERT_BRIDGE_PORT}
VLM_WARMUP_ENABLED=false
REALTIME_ALERT_CHUNK_DURATION=10
REALTIME_ALERT_CHUNK_OVERLAP_DURATION=2
REALTIME_ALERT_FRAMES_PER_CHUNK=4
REALTIME_ALERT_USE_FPS=false
REALTIME_ALERT_VLM_INPUT_WIDTH=512
REALTIME_ALERT_VLM_INPUT_HEIGHT=512
REALTIME_ALERT_ENABLE_REASONING=false
REALTIME_ALERT_MAX_TOKENS=64
REALTIME_ALERT_ENABLE_AUDIO=false
VLM_AS_VERIFIER_CONFIG_FILE=${VSS_APPS_DIR}/developer-profiles/dev-profile-alerts/vlm-as-verifier/configs/config.yml
VLM_AS_VERIFIER_CONFIG_FILE_REALTIME=${VSS_APPS_DIR}/developer-profiles/dev-profile-thor-full/vlm-as-verifier/configs/realtime-config.yml
VLM_AS_VERIFIER_ALERT_TYPE_CONFIG_FILE=${VSS_APPS_DIR}/developer-profiles/dev-profile-thor-full/vlm-as-verifier/configs/alert_type_config.json
ALERT_VERIFICATION_MEDIA_MODE=snapshots
ALERT_VERIFICATION_SNAPSHOT_FRAMES=4
ALERT_VERIFICATION_RESPONSE_FORMAT=json
ALERT_VERIFICATION_NUM_WORKERS=1
ALERT_VERIFICATION_ASYNC_IO=false
ALERT_VERIFICATION_OVERRIDE_PROMPTS=false
ALERT_DIRECT_MEDIA_ENABLED=true
ALERT_ENRICHMENT_ENABLED=true
ALERT_ALWAYS_ON_ENABLED=true
ALERT_WEBSOCKET_ENABLED=true

LVS_BACKEND_URL=http://${HOST_IP}:38111
BACKEND_PORT=38111
LVS_MCP_PORT=38112
LVS_IMAGE=nvcr.io/nvidia/vss-core/vss-video-summarization
LVS_TAG=3.2.1
MODEL_ROOT_DIR=${VSS_DATA_DIR}/models
LVS_LLM_MODEL_NAME=${LLM_NAME}
LVS_LLM_MODEL_TYPE=${LLM_MODEL_TYPE}
LVS_LLM_ENABLE_THINKING=false
LVS_LLM_MAX_TOKENS=1024
LVS_EMB_ENABLE=false
LVS_EMB_MODEL_NAME=''
LVS_EMB_BASE_URL=''
LVS_DATABASE_BACKEND=elasticsearch_db
LVS_DISABLE_DB_RESET_ON_REQUEST_DONE=true
LVS_ENABLE_MCP=true
LVS_ENABLE_LLM_MERGING=true
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=${HOST_IP}:9092
KAFKA_STRUCTURED_SUMMARY_TOPIC=mdx-structured-events-summary
GRAPH_DB_PASSWORD=''
ARANGO_DB_PASSWORD=''
MINIO_PASSWORD=''
MILVUS_DB_HOST=''
MILVUS_DB_GRPC_PORT=''

NEXT_PUBLIC_APP_TITLE="THOR LOCAL VSS"
NEXT_PUBLIC_APP_SUBTITLE="OFFLINE VIDEO INTELLIGENCE"
NEXT_PUBLIC_ENABLE_CHAT_TAB=false
NEXT_PUBLIC_ENABLE_CHAT_SIDEBAR=true
NEXT_PUBLIC_CHAT_SIDEBAR_OPEN_DEFAULT=true
NEXT_PUBLIC_SIDEBAR_CHAT_WORKFLOW="VSS Agent"
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_UPLOAD_FILE_ENABLE=true
NEXT_PUBLIC_SIDEBAR_CHAT_WEB_SOCKET_DEFAULT_ON=true
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_API_CUSTOM_AGENT_PARAMS_JSON='{"params":[{"name":"search_source_type","label":"Search media source type","type":"select","default-value":"video_file","options":["video_file","rtsp"],"changeable":true,"tooltip-info":"Media source type for search"},{"name":"use_critic","label":"Enable Critic","type":"boolean","default-value":true,"changeable":true,"tooltip-info":"Verify search results with the critic agent"},{"name":"llm_reasoning","label":"LLM Reasoning","type":"boolean","default-value":false,"changeable":true,"tooltip-info":""},{"name":"vlm_reasoning","label":"VLM Reasoning","type":"boolean","default-value":false,"changeable":true,"tooltip-info":""}]}'
NEXT_PUBLIC_ENABLE_ALERTS_TAB=true
NEXT_PUBLIC_ALERTS_TAB_VERIFIED_FLAG_DEFAULT=true
NEXT_PUBLIC_ENABLE_SEARCH_TAB=true
NEXT_PUBLIC_SEARCH_TAB_MEDIA_WITH_OBJECTS_BBOX=true
NEXT_PUBLIC_ENABLE_DASHBOARD_TAB=true
NEXT_PUBLIC_DASHBOARD_TAB_DEFAULT_DASHBOARD_ID=thor-vss-overview
NEXT_PUBLIC_ENABLE_MAP_TAB=false
NEXT_PUBLIC_ENABLE_VIDEO_MANAGEMENT_TAB=true
NEXT_PUBLIC_VIDEO_MANAGEMENT_VIDEO_UPLOAD_ENABLE=true
NEXT_PUBLIC_VIDEO_MANAGEMENT_TAB_ADD_RTSP_ENABLE=true

ENABLE_CRITIC=true
EVAL_LLM_JUDGE_NAME=${LLM_NAME}
EVAL_LLM_JUDGE_BASE_URL=${LLM_BASE_URL}
EVAL_DIR=deploy/docker/developer-profiles/dev-profile-search/eval/
DATASET_DIR=agent_eval/dataset/vss-devx-search
DATASET_FILE_NAME=dataset_single_turn.json
REPORT_REFERENCE_BASE_DIR=/vss-agent/agent_eval/dataset/vss-devx-base/gt
EVAL_OUTPUT_DIR=agent_eval/results
