FROM python:3.12-slim@sha256:cb33f7f771ecec2ef1225cf39b159591a040391bd73e4c01f00fdfc4c47611d2

WORKDIR /opt/vss/services/analytics/behavior-analytics
COPY services/analytics/behavior-analytics/apps/city/requirements.txt /tmp/city-requirements.txt
RUN pip install --no-cache-dir -r /tmp/city-requirements.txt
COPY services/analytics/behavior-analytics/apps/city ./apps/city
ENV PYTHONUNBUFFERED=1 CITY_STATE_DB=/var/lib/vss-city/state.sqlite3
EXPOSE 9184
USER 1000:1000
CMD ["uvicorn", "apps.city.main:app", "--host", "127.0.0.1", "--port", "9184", "--workers", "1"]
