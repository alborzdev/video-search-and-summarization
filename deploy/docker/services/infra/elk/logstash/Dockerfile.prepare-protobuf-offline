# Connected staging image only. It resolves the exact protobuf codec version
# against the immutable Thor Logstash base, then exports Logstash's official
# offline-plugin pack. The runtime derivative consumes that pack with its
# build network disabled.
ARG LOGSTASH_BASE_IMAGE=docker.elastic.co/logstash/logstash:9.3.3@sha256:a7ad817ec23e2f9c41f8fcd09bcce3c87710890f93612d4fd51de45074d7af2e
FROM ${LOGSTASH_BASE_IMAGE} AS packager

ARG LOGSTASH_PROTOBUF_VERSION=1.3.0
ARG LOGSTASH_PROTOBUF_PACK=logstash-codec-protobuf-1.3.0-logstash-9.3.3.zip

RUN /usr/share/logstash/bin/logstash-plugin install \
      --version "${LOGSTASH_PROTOBUF_VERSION}" \
      logstash-codec-protobuf \
    && /usr/share/logstash/bin/logstash-plugin prepare-offline-pack \
      --overwrite \
      --output "/tmp/${LOGSTASH_PROTOBUF_PACK}" \
      logstash-codec-protobuf

FROM scratch AS export
ARG LOGSTASH_PROTOBUF_PACK=logstash-codec-protobuf-1.3.0-logstash-9.3.3.zip
COPY --from=packager "/tmp/${LOGSTASH_PROTOBUF_PACK}" "/${LOGSTASH_PROTOBUF_PACK}"
