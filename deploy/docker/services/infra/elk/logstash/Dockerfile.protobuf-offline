# This image is built by the Thor-only Compose overlay with build.network=none.
# Its only installation input is the locally staged, checksum-locked official
# Logstash offline-plugin pack.
ARG LOGSTASH_BASE_IMAGE=docker.elastic.co/logstash/logstash:9.3.3@sha256:a7ad817ec23e2f9c41f8fcd09bcce3c87710890f93612d4fd51de45074d7af2e
FROM ${LOGSTASH_BASE_IMAGE}

ARG LOGSTASH_PROTOBUF_PACK=logstash-codec-protobuf-1.3.0-logstash-9.3.3.zip
ARG LOGSTASH_PROTOBUF_VERSION=1.3.0

USER root
WORKDIR /tmp/logstash-offline-pack
COPY "offline-packs/${LOGSTASH_PROTOBUF_PACK}" "${LOGSTASH_PROTOBUF_PACK}"
COPY "offline-packs/${LOGSTASH_PROTOBUF_PACK}.sha256" "${LOGSTASH_PROTOBUF_PACK}.sha256"
COPY "offline-packs/logstash-codec-protobuf-1.3.0-logstash-9.3.3.zip.expected.sha256" \
  "${LOGSTASH_PROTOBUF_PACK}.expected.sha256"

RUN test "$(wc -l < "${LOGSTASH_PROTOBUF_PACK}.sha256")" -eq 1 \
    && test "$(wc -l < "${LOGSTASH_PROTOBUF_PACK}.expected.sha256")" -eq 1 \
    && test "$(awk '{print $2}' "${LOGSTASH_PROTOBUF_PACK}.sha256")" = "${LOGSTASH_PROTOBUF_PACK}" \
    && test "$(awk '{print $2}' "${LOGSTASH_PROTOBUF_PACK}.expected.sha256")" = "${LOGSTASH_PROTOBUF_PACK}" \
    && test \
      "$(awk '{print $1}' "${LOGSTASH_PROTOBUF_PACK}.sha256")" = \
      "$(awk '{print $1}' "${LOGSTASH_PROTOBUF_PACK}.expected.sha256")" \
    && sha256sum --check "${LOGSTASH_PROTOBUF_PACK}.sha256" \
    && /usr/share/logstash/bin/logstash-plugin install \
      "file:///tmp/logstash-offline-pack/${LOGSTASH_PROTOBUF_PACK}" \
    && /usr/share/logstash/bin/logstash-plugin list --verbose logstash-codec-protobuf \
      | grep -F "logstash-codec-protobuf (${LOGSTASH_PROTOBUF_VERSION})" \
    && grep -F "    logstash-codec-protobuf (${LOGSTASH_PROTOBUF_VERSION}-java)" \
      /usr/share/logstash/Gemfile.lock \
    && grep -F "    google-protobuf (3.23.4-java)" \
      /usr/share/logstash/Gemfile.lock \
    && grep -F "    ruby-protocol-buffers (1.6.1)" \
      /usr/share/logstash/Gemfile.lock \
    && rm -rf /tmp/logstash-offline-pack

USER logstash

LABEL com.nvidia.vss.thor.logstash-base="9.3.3@sha256:a7ad817ec23e2f9c41f8fcd09bcce3c87710890f93612d4fd51de45074d7af2e" \
      com.nvidia.vss.thor.logstash-codec-protobuf="1.3.0-java" \
      com.nvidia.vss.thor.google-protobuf="3.23.4-java" \
      com.nvidia.vss.thor.ruby-protocol-buffers="1.6.1"
